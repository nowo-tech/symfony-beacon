<?xml version="1.0" encoding="UTF-8"?>

<!-- https://phpunit.readthedocs.io/en/latest/configuration.html -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         colors="true"
         failOnDeprecation="true"
         failOnNotice="true"
         failOnWarning="true"
         bootstrap="tests/bootstrap.php"
         cacheDirectory=".phpunit.cache"
>
    <php>
        <ini name="display_errors" value="1" />
        <ini name="error_reporting" value="-1" />
        <ini name="memory_limit" value="512M" />
        <server name="APP_ENV" value="test" force="true" />
        <server name="DEFAULT_LOCALE" value="en" force="true" />
        <server name="KERNEL_CLASS" value="App\Kernel" />
        <server name="SHELL_VERBOSITY" value="-1" />

        <!-- ###+ symfony/mailer ### -->
        <env name="MAILER_DSN" value="null://null"/>
        <!-- ###- symfony/mailer ### -->

        <!-- ###+ nowo-tech/site-backup-bundle ### -->
        <env name="SITE_SETUP_TOKEN" value="test-setup-token"/>
        <env name="SITE_BACKUP_PASSWORD_HASH" value="$2y$13$92IXUNpkjO0rOQ5byMi.Ye4oKoEa3Ro9llC/.og/at2.uheWG/igi"/>
        <!-- ###- nowo-tech/site-backup-bundle ### -->

        <!-- ###+ symfony/mercure-bundle ### -->
        <!-- See https://symfony.com/doc/current/mercure.html#configuration -->
        <!-- The URL of the Mercure hub, used by the app to publish updates (can be a local URL) -->
        <env name="MERCURE_URL" value="https://example.com/.well-known/mercure"/>
        <!-- The public URL of the Mercure hub, used by the browser to connect -->
        <env name="MERCURE_PUBLIC_URL" value="https://example.com/.well-known/mercure"/>
        <!-- The secret used to sign the JWTs -->
        <env name="MERCURE_JWT_SECRET" value="!ChangeThisMercureHubJWTSecretKey!"/>
        <!-- ###- symfony/mercure-bundle ### -->
        <!-- Force secure defaults regardless of developer .env -->
        <env name="BEACON_INGEST_REJECT_QUERY_AUTH" value="1" force="true"/>
        <env name="BEACON_HOOKS_ALLOW_ANONYMOUS_RESOLVE" value="0" force="true"/>
        <env name="BEACON_METRICS_REQUIRE_TOKEN" value="0" force="true"/>
        <env name="BEACON_METRICS_TOKEN" value="phpunit-metrics-token" force="true"/>
        <!-- Web Push VAPID (functional push subscribe tests; empty in .env.dist) -->
        <env name="VAPID_PUBLIC_KEY" value="BMSurvPcGLr__vOnlz-3LWeLbMhVrZj6DdG0zzCuQchZgJIhavKo-g6Cs_HmKC8xDz9HdEfg1P0PFnywgJE4n-M" force="true"/>
        <env name="VAPID_PRIVATE_KEY" value="WDYOi2zFK2QricQDnedNNaJYfSlHpSvbUvG47ZmzkXA" force="true"/>
        <env name="VAPID_SUBJECT" value="mailto:ops@example.com" force="true"/>
        <!-- Redis not required in test (framework when@test uses array/mock session) -->
        <env name="REDIS_URL" value="redis://127.0.0.1:6379" force="true"/>
        <env name="REDIS_HOST" value="127.0.0.1" force="true"/>
        <env name="REDIS_PORT" value="6379" force="true"/>
        <env name="MESSENGER_TRANSPORT_DSN" value="sync://" force="true"/>
    </php>

    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Functional">
            <directory>tests/Functional</directory>
        </testsuite>
        <testsuite name="Integration">
            <directory>tests/Integration</directory>
        </testsuite>
    </testsuites>

    <source ignoreSuppressionOfDeprecations="true"
            ignoreIndirectDeprecations="true"
            restrictNotices="true"
            restrictWarnings="true"
    >
        <include>
            <directory>src</directory>
        </include>
        <exclude>
            <!-- HTTP controllers: covered by Playwright e2e (REQ-QA-003) and Functional HTTP suites.
                 Hard PHPUnit gate focuses on domain services, forms, entities, repositories, subscribers, commands. -->
            <directory>src/Analytics/Controller</directory>
            <directory>src/Api/Read/Controller</directory>
            <directory>src/Identity/Controller</directory>
            <directory>src/Ingest/Controller</directory>
            <directory>src/Ingest/Otlp/Controller</directory>
            <directory>src/Issues/Controller</directory>
            <directory>src/Notifications/Controller</directory>
            <directory>src/Ops/Controller</directory>
            <directory>src/Performance/Controller</directory>
            <directory>src/Project/Controller</directory>
            <directory>src/Shared/Appearance/Controller</directory>
            <directory>src/Shared/Controller</directory>
            <directory>src/Shared/Legal/Controller</directory>
            <directory>src/Shared/Settings/Controller</directory>
            <!-- Demo/sample seeders: install tooling; exercised by e2e / make seed / make seed-sample -->
            <directory>src/Setup/Demo</directory>
            <file>src/Identity/Command/SeedDemoCommand.php</file>
            <file>src/Identity/Service/DemoIdentitySeeder.php</file>
            <file>src/Analytics/Service/AnalyticsDemoSeeder.php</file>
            <file>src/Performance/Service/PerformanceDemoSeeder.php</file>
            <!-- Install / operator tooling with low unit ROI; documented in docs/COVERAGE.md -->
            <file>src/Ops/Command/BeaconTestCommand.php</file>
            <file>src/Ops/Service/BeaconDogfoodDiagnostics.php</file>
            <file>src/Ops/Service/BeaconDogfoodDiagnosticReport.php</file>
            <file>src/Issues/Command/BackfillEventPromotionsCommand.php</file>
        </exclude>

        <deprecationTrigger>
            <method>Doctrine\Deprecations\Deprecation::trigger</method>
            <method>Doctrine\Deprecations\Deprecation::delegateTriggerToBackend</method>
            <function>trigger_deprecation</function>
        </deprecationTrigger>
    </source>

    <extensions>
    </extensions>
</phpunit>
