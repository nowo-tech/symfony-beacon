parameters:
    level: 6
    paths:
        - src
        - tests
    tmpDir: var/phpstan
    treatPhpDocTypesAsCertain: false
    symfony:
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml
        consoleApplicationLoader: tests/phpstan/console-application.php
    ignoreErrors:
        -
            identifier: doctrine.associationType
            path: src/*/Entity/*
        # PHPUnit CLI bootstrap (Symfony Flex debug umask); not a FrankenPHP worker request path
        -
            identifier: frankenphp.worker.noUmask
            path: tests/bootstrap.php
        # Test doubles / namespaced function hooks are process-local PHPUnit fixtures, not worker code
        -
            identifier: frankenphp.worker.noMutableStaticProperty
            path: tests/*
        -
            identifier: frankenphp.worker.noSetErrorExceptionHandler
            path: tests/*
        -
            identifier: frankenphp.worker.noStaticLocalVariable
            path: tests/*
        # CLI-only Messenger poll after Envelope ACK (`app:beacon:test`); never on HTTP worker path
        -
            identifier: frankenphp.hardening.noBlockingSleep
            path: src/Ops/Service/BeaconDogfoodDiagnostics.php

includes:
    - phpstan-baseline.neon
    - vendor/phpstan/phpstan-symfony/extension.neon
    - vendor/phpstan/phpstan-symfony/rules.neon
    - vendor/phpstan/phpstan-doctrine/extension.neon
    - vendor/phpstan/phpstan-doctrine/rules.neon
    - vendor/phpstan/phpstan-phpunit/extension.neon
    - vendor/phpstan/phpstan-phpunit/rules.neon
    # nowo-tech/phpstan-frankenphp — production gate (classic + worker + hardening)
    # https://github.com/nowo-tech/PhpStanFrankenPhp/blob/main/docs/CONFIGURATION.md
    - vendor/nowo-tech/phpstan-frankenphp/extension.neon
    - vendor/nowo-tech/phpstan-frankenphp/rules.neon
    # Optional: also flag $_GET/$_POST/… (framework often touches these legitimately)
    # - vendor/nowo-tech/phpstan-frankenphp/ruleset-worker-strict.neon
