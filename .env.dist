# =============================================================================
# Environment template (ONLY versioned env file)
# =============================================================================
# Install:  cp .env.dist .env
# Runtime:  Docker Compose (`env_file: .env`) and Symfony read `.env` (never commit it).
# Optional local overrides (gitignored): `.env.local`
# Do not use `.env.dev` / `.env.prod` in this project — keep one template.
# =============================================================================

# -----------------------------------------------------------------------------
# Compose identity + Server (host ports → container 80/443)
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=symfony-beacon
SERVER_NAME=localhost
HTTP_PORT=9084
HTTPS_PORT=9447
HTTP3_PORT=9447
DEFAULT_URI=https://localhost:9447

# -----------------------------------------------------------------------------
# FrankenPHP mode (classic | worker) — HTTP, NOT Messenger
# -----------------------------------------------------------------------------
# Coding implications: docs/ops/FRANKENPHP-CODING.md
#   classic              → boot per request
#   worker + RESET=false → shared Kernel; use ResetInterface (default, fastest)
#   worker + RESET=true  → clone Kernel per request (safer container, slower)
#
# After changing mode: `make restart` or `docker compose up -d` (recreate).
FRANKENPHP_MODE=classic
# FRANKENPHP_WORKER_NUM=4
FRANKENPHP_LOOP_MAX=500
FRANKENPHP_RESET_KERNEL=false

# Xdebug: off | develop | debug | coverage
XDEBUG_MODE=off

# -----------------------------------------------------------------------------
# Vite / Pentatrion (Compose service `vite`, pnpm in the FrankenPHP image)
# Host port maps to container 5173; browser loads /build via HTTPS (Caddy proxy).
# -----------------------------------------------------------------------------
VITE_PORT=5177
VITE_DEV_SERVER_HOST=localhost
# Set to 1 on Docker Desktop / WSL if HMR misses file changes (polling).
# VITE_USE_POLLING=1

# -----------------------------------------------------------------------------
# Symfony
# -----------------------------------------------------------------------------
###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=ChangeMePleaseUseARealSecret
APP_SHARE_DIR=var/share
# Only when TLS terminates in front of FrankenPHP/Caddy (comma-separated CIDRs or REMOTE_ADDR).
# Leave empty for default Compose (Caddy terminates TLS). See docs/PRODUCTION.md.
# SYMFONY_TRUSTED_PROXIES=
# SYMFONY_TRUSTED_HEADERS=x-forwarded-for,x-forwarded-proto
###< symfony/framework-bundle ###

# Default UI locale for bare public URLs (must be in enabled_locales).
# .env.dist ships English (`en`). This project's local/ops `.env` uses Spanish (`es`).
DEFAULT_LOCALE=en

# -----------------------------------------------------------------------------
# MySQL (latest stable official: 9.7 — https://hub.docker.com/_/mysql)
# -----------------------------------------------------------------------------
MYSQL_VERSION=9.7
MYSQL_DATABASE=app
MYSQL_USER=app
MYSQL_PASSWORD=!ChangeMe!
MYSQL_ROOT_PASSWORD=!ChangeMeRoot!

# Host reachable from the php container (no host-published DB ports — REQ-FP-006):
#   make up        → database
#   make up-shared → mysql-9.7-primary  (+ SHARED_DOCKER_NETWORK=server_network)
#   little-vps     → mysql-9.7-primary  (+ SHARED_DOCKER_NETWORK=server_internal)
MYSQL_HOST=database
MYSQL_PORT=3306
# Optional read replica (not wired in Doctrine yet):
MYSQL_HOST_RO=database
MYSQL_PORT_RO=3306

# --- Shared mode (make up-shared) — local/dev uses MySQL root (no app user) ---
# Docs: docs/ops/SHARED-SERVER.md
# Uncomment / override the vars below (same DATABASE_URL template above).
# SHARED_DOCKER_NETWORK=server_network
# # little-vps: SHARED_DOCKER_NETWORK=server_internal
# MYSQL_DATABASE=symfony_beacon
# MYSQL_USER=root
# MYSQL_PASSWORD=toChange!   # must match server/.env DATABASE_PASSWORD
# MYSQL_HOST=mysql-9.7-primary
# MYSQL_HOST_RO=mysql-9.7-replica
# SHARED_MYSQL_ROOT_PASSWORD=  # optional; else MYSQL_PASSWORD / server/.env DATABASE_PASSWORD
# # Optional dedicated app user (non-root): MYSQL_USER=beacon + make bootstrap-shared-db

###> doctrine/doctrine-bundle ###
DATABASE_URL="mysql://${MYSQL_USER}:${MYSQL_PASSWORD}@${MYSQL_HOST}:${MYSQL_PORT}/${MYSQL_DATABASE}?serverVersion=${MYSQL_VERSION}&charset=utf8mb4"
# Reserved for future Doctrine read routing (not wired yet):
DATABASE_URL_RO="mysql://${MYSQL_USER}:${MYSQL_PASSWORD}@${MYSQL_HOST_RO}:${MYSQL_PORT_RO}/${MYSQL_DATABASE}?serverVersion=${MYSQL_VERSION}&charset=utf8mb4"
# PHPUnit (`APP_ENV=test`) SQLite URL. PidSqliteUrlEnvVarProcessor appends -{pid}.db.
BEACON_TEST_DATABASE_URL="sqlite:////dev/shm/symfony-beacon-phpunit.db"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Async queue in MySQL. Consumed by the Compose `messenger` service.
# Alternatives:
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
# JSON + HMAC signing is enabled (see config/packages/messenger.yaml). Drain pending
# async_ingest/async rows before deploy if upgrading from native PHP serialization.
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=1
###< symfony/messenger ###

# -----------------------------------------------------------------------------
# Field encryption (nowo-tech/doctrine-encrypt-bundle)
# -----------------------------------------------------------------------------
# Default: Halite key file at var/secrets/.Halite.default.key (auto-created).
# Production: generate once and persist the file, or switch the YAML profile to
# secret_key_env_var and set APP_ENCRYPT_KEY (Halite hex key from
# `bin/console doctrine:encrypt:generate-secret-key`).
# AuthKit social credentials (Administration → Social login) encrypt client_secret
# with Halite; register IdP redirect URIs as DEFAULT_URI + /login/social/{provider}/check
# (and /{locale}/… for non-default locales). After upgrading from plaintext rows:
# `bin/console doctrine:encrypt:database --force`.
# APP_ENCRYPT_KEY=

# Pre-auth IP rate limit for Envelope / OTLP (requests per minute; 0 = disabled).
# Applies before credential DB lookups. Per-project limits still apply after auth.
BEACON_INGEST_IP_RATE_LIMIT=120
# Public Slack / Teams actions / inbound-email hooks (pre-auth); 0 disables.
BEACON_HOOK_IP_RATE_LIMIT=120
# Bearer Read API (/api/projects/…) per client IP; 0 disables.
BEACON_READ_API_RATE_LIMIT=120

###> symfony/mailer ###
# Bootstrap / fallback only when Administration → Mailer has no DSN stored.
# Prefer saving the real DSN encrypted under /admin/mailer (instance_settings).
# Local catcher (opt-in): make mailpit → save smtp://mailer:1025 in Admin → Mailer.
# See docs/ops/MAILPIT.md. Never point production at Mailpit.
MAILER_DSN=null://null
###< symfony/mailer ###

# -----------------------------------------------------------------------------
# Mailpit (Compose profile `mail`) — local SMTP catcher, not for production
# -----------------------------------------------------------------------------
# Start: make mailpit   |   UI: http://localhost:${MAILPIT_UI_PORT}
# Host SMTP port is only for tools on the host; PHP uses smtp://mailer:1025.
# Host ports avoid common 1025/8025 clashes with other local stacks.
MAILPIT_UI_PORT=18026
MAILPIT_SMTP_PORT=1027

###> nowo-tech/site-backup-bundle ###
# Panel password hash for /_site_backup (required to use the panel).
# Generate locally (do not commit the result):
#   docker compose exec php bin/console nowo:site-backup:hash-password
# Outside dev/test, empty or historically documented local hashes fail closed
# (App\Setup\SiteBackupSecurityDefaultsGuard).
SITE_BACKUP_PASSWORD_HASH=
# Shared secret for /setup (?token=… or X-Setup-Token). Empty disables the gate (dev only).
# Generate: openssl rand -hex 24   — never commit a real token; prod must be unique.
SITE_SETUP_TOKEN=
###< nowo-tech/site-backup-bundle ###

###> nowo-tech/maintenance-mode-bundle ###
# Optional ops password gate (disabled in Beacon — panel uses ROLE_ADMIN like HttpLog).
# Panel: /admin/maintenance · Preview public 503 page: /_maintenance_preview
# If you re-enable password_protection, generate:
#   docker compose exec php bin/console nowo:maintenance-mode:hash-password
# MAINTENANCE_PASSWORD_HASH=
###< nowo-tech/maintenance-mode-bundle ###

###> nowo-tech/beacon-bundle ###
# Symfony Beacon Envelope client (dogfood this instance). Empty DSN = reporting off.
# Format: https://PUBLIC_KEY:SECRET_KEY@host:port/PROJECT_UUID
# After `make ready` / `make seed`, demo seed may write a loopback DSN when empty:
#   BEACON_DSN=http://PUBLIC:SECRET@127.0.0.1/{projectUuid}
# Optional release tag (git SHA / app version) attached when send.release is true.
BEACON_DSN=
BEACON_RELEASE=
###< nowo-tech/beacon-bundle ###

# -----------------------------------------------------------------------------
# Ops / self-hosting (roadmap Phase 2)
# -----------------------------------------------------------------------------
# Retention, ingest limits, quotas, envelope size, metrics scrape token,
# inbound email, SSRF / hook policy, and notification limits are configured in
# Admin → Ops defaults (instance_settings). Purge retained telemetry via
# `bin/console app:retention:purge` (cron daily).

# -----------------------------------------------------------------------------
# AuthKit social login
# -----------------------------------------------------------------------------
# Credentials live in auth_kit_social_credential — manage via Administration → Social login.
# AuthKit ≥ 1.15 encrypts client_secret (+ linked-account tokens) with Halite; run
# `bin/console doctrine:encrypt:database --force` once after upgrading if rows are still plaintext.
# mode is enabled in config/packages/nowo_auth_kit.yaml; buttons appear only after
# at least one enabled credential exists.
# Register redirect URIs at the IdP matching DEFAULT_URI + /login/social/{provider}/check
# (and /{locale}/… for non-default locales).

###> symfony/mercure-bundle ###
# See docs/ops/MERCURE.md and https://symfony.com/doc/current/mercure.html#configuration
# Local/dev: publish to FrankenPHP's built-in Mercure hub (dev Caddyfile).
# Production (compose.prod): use the Compose `mercure` service — set
#   MERCURE_URL=http://mercure/.well-known/mercure
MERCURE_URL=http://php/.well-known/mercure
# Browser-facing hub URL (same-origin via Caddy at /.well-known/mercure).
MERCURE_PUBLIC_URL=${DEFAULT_URI}/.well-known/mercure
# Shared HMAC secret (min 32 chars) — must match MERCURE_*_JWT_KEY on the hub.
# Also remapped to MERCURE_PUBLISHER_JWT_KEY / MERCURE_SUBSCRIBER_JWT_KEY on `php` (dev).
MERCURE_JWT_SECRET="!ChangeThisMercureHubJWTSecretKey!"
###< symfony/mercure-bundle ###

# -----------------------------------------------------------------------------
# Web Push (PWA) — VAPID keys for background notifications
# -----------------------------------------------------------------------------
# Generate: docker compose exec php php -r 'require "vendor/autoload.php"; print_r(Minishlink\WebPush\VAPID::createVapidKeys());'
# Leave empty to disable Web Push delivery (Mercure live updates still work).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@localhost
