{% extends 'base.html.twig' %}

{% block title %}{{ 'project.settings.title'|trans }} — {{ project.name }}{% endblock %}

{% block body %}
{% include 'project/_nav.html.twig' with {project: project, current: 'settings'} %}

<p class="mb-6 text-sm text-[var(--color-ink)]/65">{{ 'project.settings.intro'|trans }}</p>

{% if not project.ingestEnabled %}
    <div class="mb-6 rounded-md border border-[var(--color-alert)] bg-[var(--color-alert)]/10 px-4 py-3 text-sm text-[var(--color-alert)]" role="status">
        {{ 'project.governance.ingest_disabled_banner'|trans }}
    </div>
{% endif %}

{% if membership.canManageSettings %}
<section class="panel mb-6">
    <h2 class="mb-2 text-lg font-semibold">{{ 'project.governance.title'|trans }}</h2>
    <p class="mb-4 text-sm text-[var(--color-ink)]/60">{{ 'project.governance.help'|trans }}</p>
    {% if effectiveQuota > 0 %}
        <p class="mb-2 text-xs text-[var(--color-ink)]/55">
            {{ 'project.governance.quota_usage'|trans({'%count%': eventsToday, '%quota%': effectiveQuota}) }}
        </p>
    {% endif %}
    {% if effectiveMonthlyQuota > 0 %}
        <p class="mb-4 text-xs text-[var(--color-ink)]/55">
            {{ 'project.governance.quota_usage_monthly'|trans({'%count%': eventsThisMonth, '%quota%': effectiveMonthlyQuota}) }}
            <span class="text-[var(--color-ink)]/40">({{ 'project.governance.month_utc_hint'|trans }})</span>
        </p>
    {% endif %}
    {{ form_start(governanceForm, {attr: {class: 'grid gap-4 sm:grid-cols-2'}}) }}
        <div>
            <label class="mb-1 block text-sm font-medium" for="retention_days">{{ 'project.governance.retention_days'|trans }}</label>
            {{ form_widget(governanceForm.retention_days, {attr: {class: 'input w-full', id: 'retention_days', placeholder: governanceDefaults.retention_days}}) }}
            <p class="mt-1 text-xs text-[var(--color-ink)]/50">{{ 'project.governance.inherit_hint'|trans({'%default%': governanceDefaults.retention_days}) }}</p>
        </div>
        <div>
            <label class="mb-1 block text-sm font-medium" for="retention_max_events">{{ 'project.governance.retention_max_events'|trans }}</label>
            {{ form_widget(governanceForm.retention_max_events, {attr: {class: 'input w-full', id: 'retention_max_events', placeholder: governanceDefaults.retention_max_events}}) }}
            <p class="mt-1 text-xs text-[var(--color-ink)]/50">{{ 'project.governance.inherit_hint'|trans({'%default%': governanceDefaults.retention_max_events}) }}</p>
        </div>
        <div>
            <label class="mb-1 block text-sm font-medium" for="ingest_rate_limit_per_minute">{{ 'project.governance.ingest_rate_limit'|trans }}</label>
            {{ form_widget(governanceForm.ingest_rate_limit_per_minute, {attr: {class: 'input w-full', id: 'ingest_rate_limit_per_minute', placeholder: governanceDefaults.ingest_rate_limit}}) }}
            <p class="mt-1 text-xs text-[var(--color-ink)]/50">{{ 'project.governance.inherit_hint'|trans({'%default%': governanceDefaults.ingest_rate_limit}) }}</p>
        </div>
        <div>
            <label class="mb-1 block text-sm font-medium" for="event_quota_daily">{{ 'project.governance.event_quota_daily'|trans }}</label>
            {{ form_widget(governanceForm.event_quota_daily, {attr: {class: 'input w-full', id: 'event_quota_daily', placeholder: governanceDefaults.event_quota_daily}}) }}
            <p class="mt-1 text-xs text-[var(--color-ink)]/50">{{ 'project.governance.inherit_hint'|trans({'%default%': governanceDefaults.event_quota_daily}) }}</p>
        </div>
        <div>
            <label class="mb-1 block text-sm font-medium" for="event_quota_monthly">{{ 'project.governance.event_quota_monthly'|trans }}</label>
            {{ form_widget(governanceForm.event_quota_monthly, {attr: {class: 'input w-full', id: 'event_quota_monthly', placeholder: governanceDefaults.event_quota_monthly}}) }}
            <p class="mt-1 text-xs text-[var(--color-ink)]/50">{{ 'project.governance.inherit_hint'|trans({'%default%': governanceDefaults.event_quota_monthly}) }}</p>
        </div>
        <div class="sm:col-span-2">
            <button class="btn-primary" type="submit">{{ 'project.governance.save'|trans }}</button>
        </div>
    {{ form_end(governanceForm) }}
</section>
{% endif %}

<div class="grid gap-6 lg:grid-cols-2">
    <section class="panel">
        <h2 class="mb-3 text-lg font-semibold">{{ 'project.api_keys.title'|trans }}</h2>
        <p class="mb-3 text-sm text-[var(--color-ink)]/60">{{ 'project.api_keys.help'|trans }}</p>
        <ul class="space-y-3">
            {% for key in project.apiKeys %}
                <li class="rounded-md border border-[var(--color-sand)] bg-[var(--color-paper)] p-3 text-sm"{% if not key.active %} data-testid="api-key-inactive"{% endif %}>
                    <div class="font-medium">{{ key.label }} {% if not key.active %}<span class="badge badge-error">{{ 'project.api_keys.inactive'|trans }}</span>{% endif %}</div>
                    {% if membership.canManageApiKeys %}
                        <div class="mt-1 text-xs text-[var(--color-ink)]/55">{{ 'project.api_keys.public'|trans }} {{ key.publicKey }}</div>
                        {% if key.active %}
                            <p class="mt-2 text-xs text-[var(--color-ink)]/55" data-testid="api-key-dsn-redacted">{{ 'project.api_keys.secret_once_hint'|trans }}</p>
                        {% else %}
                            <p class="mt-2 text-xs text-[var(--color-ink)]/55">{{ 'project.api_keys.inactive_dsn_hidden'|trans }}</p>
                        {% endif %}
                    {% else %}
                        <p class="mt-2 text-xs text-[var(--color-ink)]/55" data-testid="api-key-dsn-redacted">{{ 'project.api_keys.secret_hidden'|trans }}</p>
                    {% endif %}
                    {% if membership.canManageApiKeys and key.active %}
                        <div class="mt-3 flex flex-wrap gap-2">
                            {{ form_start(apiKeyRotateForms[key.id], {
                                action: path('project_keys_rotate', {projectId: project.uuid, keyId: key.id}),
                            }) }}
                                <button class="btn-ghost btn-sm" type="submit">{{ 'project.api_keys.rotate'|trans }}</button>
                            {{ form_end(apiKeyRotateForms[key.id]) }}
                            {{ form_start(apiKeyRevokeForms[key.id], {
                                action: path('project_keys_revoke', {projectId: project.uuid, keyId: key.id}),
                                attr: {
                                    'data-controller': 'confirm-submit',
                                    'data-confirm-submit-message-value': 'project.api_keys.revoke_confirm'|trans,
                                    'data-action': 'submit->confirm-submit#confirm',
                                },
                            }) }}
                                <button class="btn-ghost btn-sm" type="submit">{{ 'project.api_keys.revoke'|trans }}</button>
                            {{ form_end(apiKeyRevokeForms[key.id]) }}
                        </div>
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
        {% if membership.canManageApiKeys and lastApiKeyDsn|default(null) %}
            <div class="mt-4 rounded-md border border-[var(--color-moss)]/30 bg-[var(--color-moss)]/10 p-3" data-testid="api-key-dsn-flash">
                <div class="flex flex-wrap items-start gap-2">
                    <code class="block min-w-0 flex-1 break-all text-sm font-mono">{{ lastApiKeyDsn }}</code>
                    <button
                        type="button"
                        class="btn-ghost btn-sm shrink-0"
                        data-controller="clipboard-copy"
                        data-clipboard-copy-text-value="{{ lastApiKeyDsn|e('html_attr') }}"
                        data-clipboard-copy-label-value="{{ 'project.api_keys.copy_dsn'|trans|e('html_attr') }}"
                        data-clipboard-copy-done-label-value="{{ 'project.api_keys.dsn_copied'|trans|e('html_attr') }}"
                        data-action="click->clipboard-copy#copy"
                        aria-label="{{ 'project.api_keys.copy_dsn'|trans }}"
                    >{{ 'project.api_keys.copy_dsn'|trans }}</button>
                </div>
                <p class="mt-2 text-xs text-[var(--color-ink)]/55">{{ 'project.api_keys.secret_once_banner'|trans }}</p>
            </div>
        {% endif %}
        {% if membership.canManageApiKeys %}
            {{ form_start(apiKeyCreateForm, {
                attr: {
                    class: 'mt-4 flex flex-wrap gap-2',
                    'data-controller': 'human-key-label',
                    'data-human-key-label-adjectives-value': labelAdjectives|json_encode|e('html_attr'),
                    'data-human-key-label-nouns-value': labelNouns|json_encode|e('html_attr'),
                }
            }) }}
                {{ form_widget(apiKeyCreateForm.label, {
                    attr: {
                        class: 'input min-w-40 flex-1',
                        placeholder: 'project.api_keys.label_placeholder'|trans,
                        'data-human-key-label-target': 'label',
                        autocomplete: 'off',
                    }
                }) }}
                <button
                    type="button"
                    class="btn-ghost"
                    data-action="human-key-label#generate"
                    title="{{ 'project.api_keys.generate_hint'|trans }}"
                >{{ 'project.api_keys.generate'|trans }}</button>
                <button class="btn-primary" type="submit">{{ 'project.api_keys.add'|trans }}</button>
            {{ form_end(apiKeyCreateForm) }}
        {% endif %}
    </section>

    <section class="panel">
        <div class="mb-3 flex flex-wrap items-start justify-between gap-2">
            <div>
                <h2 class="text-lg font-semibold">{{ 'project.members.title'|trans }}</h2>
                <p class="mt-1 text-sm text-[var(--color-ink)]/60">{{ 'project.members.help'|trans }}</p>
            </div>
            {% if assignableRoles is not empty %}
                {% embed 'shared/_confirm_dialog.html.twig' with {
                    custom_form: true,
                    aria_labelledby: 'project-member-add-title-' ~ project.id,
                } %}
                    {% block trigger %}
                        <button
                            type="button"
                            class="btn-primary btn-sm btn-icon"
                            data-action="confirm-dialog#open"
                            title="{{ 'project.members.add'|trans }}"
                            aria-label="{{ 'project.members.add'|trans }}"
                        >
                            <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                <path fill="currentColor" d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/>
                            </svg>
                        </button>
                    {% endblock %}
                    {% block form %}
                        {{ form_start(memberAddForm, {attr: {class: 'confirm-dialog__panel'}}) }}
                            <div class="confirm-dialog__header">
                                <h2 id="project-member-add-title-{{ project.id }}" class="confirm-dialog__title">{{ 'project.members.add_title'|trans }}</h2>
                                <p class="confirm-dialog__body">{{ 'project.members.add_help'|trans }}</p>
                            </div>
                            <div class="confirm-dialog__content">
                                <label class="confirm-dialog__label" for="member-email">{{ 'project.members.email_label'|trans }}</label>
                                {{ form_widget(memberAddForm.email, {
                                    attr: {
                                        id: 'member-email',
                                        class: 'input w-full',
                                        autocomplete: 'off',
                                        placeholder: 'project.members.email_placeholder'|trans,
                                    }
                                }) }}
                                <label class="confirm-dialog__label" for="member-add-role">{{ 'project.members.role_label'|trans }}</label>
                                {{ form_widget(memberAddForm.role, {attr: {id: 'member-add-role', class: 'input w-full'}}) }}
                            </div>
                            <div class="confirm-dialog__actions">
                                <button type="button" class="btn-ghost" data-confirm-dialog-close>{{ 'project.danger.cancel'|trans }}</button>
                                <button type="submit" class="btn-primary">{{ 'project.members.add'|trans }}</button>
                            </div>
                        {{ form_end(memberAddForm) }}
                    {% endblock %}
                {% endembed %}
            {% endif %}
        </div>
        <ul class="space-y-3 text-sm">
            {% for member in project.memberships %}
                {% set memberUser = member.user %}
                {% set isProtectedFull = member.role.value == 'full' %}
                {% set actorIsOwner = membership.role.value == 'owner' %}
                {# Owners are not edited/removed here — use Transfer ownership. #}
                {% set canManageThis = assignableRoles is not empty
                    and member.role.value != 'owner'
                    and (actorIsOwner or member.role.value != 'full') %}
                <li class="rounded-md border border-[var(--color-sand)] bg-[var(--color-paper)] p-3">
                    <div class="flex flex-wrap items-start justify-between gap-3">
                        <div class="min-w-0">
                            <div class="font-medium">{{ memberUser.displayName }}</div>
                            <div class="text-xs text-[var(--color-ink)]/60">{{ memberUser.email }}</div>
                            <div class="mt-1">
                                <span class="badge bg-[var(--color-sand)]">{{ ('project.members.role.' ~ member.role.value)|trans }}</span>
                                {% if not member.active %}
                                    <span class="badge badge-error">{{ 'project.members.inactive'|trans }}</span>
                                {% endif %}
                            </div>
                        </div>
                        {% if canManageThis %}
                            <div class="flex shrink-0 items-center gap-1">
                                {% embed 'shared/_confirm_dialog.html.twig' with {
                                    custom_form: true,
                                    aria_labelledby: 'project-member-role-title-' ~ member.id,
                                } %}
                                    {% block trigger %}
                                        <button
                                            type="button"
                                            class="btn-ghost btn-sm btn-icon"
                                            data-action="confirm-dialog#open"
                                            title="{{ 'project.members.edit_role'|trans }}"
                                            aria-label="{{ 'project.members.edit_role'|trans }}"
                                        >
                                            <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                                <path fill="currentColor" d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zm2.92 2.83H5v-.92l9.06-9.06.92.92L5.92 20.08zM20.71 7.04a1 1 0 0 0 0-1.41l-2.34-2.34a1 1 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/>
                                            </svg>
                                        </button>
                                    {% endblock %}
                                    {% block form %}
                                        {{ form_start(memberRoleForms[member.id], {attr: {class: 'confirm-dialog__panel'}}) }}
                                            <div class="confirm-dialog__header">
                                                <h2 id="project-member-role-title-{{ member.id }}" class="confirm-dialog__title">{{ 'project.members.edit_role_title'|trans }}</h2>
                                                <p class="confirm-dialog__body">{{ 'project.members.edit_role_body'|trans({'%name%': memberUser.displayName, '%email%': memberUser.email}) }}</p>
                                            </div>
                                            <div class="confirm-dialog__content">
                                                <label class="confirm-dialog__label" for="member-role-{{ member.id }}">{{ 'project.members.role_label'|trans }}</label>
                                                {{ form_widget(memberRoleForms[member.id].role, {attr: {id: 'member-role-' ~ member.id, class: 'input w-full'}}) }}
                                            </div>
                                            <div class="confirm-dialog__actions">
                                                <button type="button" class="btn-ghost" data-confirm-dialog-close>{{ 'project.danger.cancel'|trans }}</button>
                                                <button type="submit" class="btn-primary">{{ 'project.members.update_role'|trans }}</button>
                                            </div>
                                        {{ form_end(memberRoleForms[member.id]) }}
                                    {% endblock %}
                                {% endembed %}

                                {% embed 'shared/_confirm_dialog.html.twig' with {
                                    custom_form: true,
                                    form_action: path('project_members_remove', {projectId: project.uuid, userId: memberUser.uuid}),
                                    aria_labelledby: 'project-member-remove-title-' ~ member.id,
                                } %}
                                    {% block form %}
                                        {{ form_start(memberRemoveForms[member.id], {
                                            action: path('project_members_remove', {projectId: project.uuid, userId: memberUser.uuid}),
                                            attr: {class: 'confirm-dialog__panel'},
                                        }) }}
                                            <div class="confirm-dialog__header">
                                                <h2 id="project-member-remove-title-{{ member.id }}" class="confirm-dialog__title">{{ 'project.members.remove_title'|trans }}</h2>
                                                {% if isProtectedFull %}
                                                    <p class="confirm-dialog__body">{{ 'flash.project.member_cannot_remove_full'|trans }}</p>
                                                {% else %}
                                                    <p class="confirm-dialog__body">{{ 'project.members.remove_confirm'|trans({'%email%': memberUser.email}) }}</p>
                                                {% endif %}
                                            </div>
                                            <div class="confirm-dialog__content"></div>
                                            <div class="confirm-dialog__actions">
                                                <button type="button" class="btn-ghost" data-confirm-dialog-close>{{ 'project.danger.cancel'|trans }}</button>
                                                <button type="submit" class="btn-danger" {% if isProtectedFull %}disabled{% endif %}>{{ 'project.members.remove'|trans }}</button>
                                            </div>
                                        {{ form_end(memberRemoveForms[member.id]) }}
                                    {% endblock %}
                                    {% block trigger %}
                                        <button
                                            type="button"
                                            class="btn-ghost btn-sm btn-icon"
                                            data-action="confirm-dialog#open"
                                            title="{{ 'project.members.remove'|trans }}"
                                            aria-label="{{ 'project.members.remove'|trans }}"
                                            {% if isProtectedFull %}disabled{% endif %}
                                        >
                                            <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                                <path fill="currentColor" d="M6 19a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/>
                                            </svg>
                                        </button>
                                    {% endblock %}
                                {% endembed %}

                                {{ form_start(memberSetActiveForms[member.id], {
                                    action: path('project_members_set_active', {projectId: project.uuid, userId: memberUser.uuid}),
                                }) }}
                                    {{ form_widget(memberSetActiveForms[member.id].active) }}
                                    <button class="btn-ghost btn-sm" type="submit" title="{{ (member.active ? 'project.members.deactivate' : 'project.members.activate')|trans }}">
                                        {{ (member.active ? 'project.members.deactivate' : 'project.members.activate')|trans }}
                                    </button>
                                {{ form_end(memberSetActiveForms[member.id]) }}
                            </div>
                        {% endif %}
                    </div>
                </li>
            {% endfor %}
        </ul>
        <p class="mt-3 text-xs text-[var(--color-ink)]/55">{{ 'project.members.your_role'|trans }} {{ ('project.members.role.' ~ membership.role.value)|trans }}</p>
    </section>
</div>

{% if membership.canManageSettings %}
<section class="panel mt-6" data-testid="read-api-tokens">
    <h2 class="mb-2 text-lg font-semibold">{{ 'projects.read_token.title'|trans }}</h2>
    <p class="mb-4 text-sm text-[var(--color-ink)]/60">{{ 'projects.read_token.help'|trans }}</p>
    {% if lastReadToken %}
        <p class="mb-4 rounded-md border border-[var(--color-moss)]/30 bg-[var(--color-moss)]/10 p-3 text-sm break-all font-mono" data-testid="read-token-secret">{{ lastReadToken }}</p>
        <p class="mb-4 text-xs text-[var(--color-ink)]/55">{{ 'projects.read_token.copy_once'|trans }}</p>
    {% endif %}
    {{ form_start(readTokenCreateForm, {attr: {class: 'mb-4 flex flex-wrap items-end gap-3'}}) }}
        <label class="text-sm grow">
            <span class="mb-1 block">{{ 'projects.read_token.label'|trans }}</span>
            {{ form_widget(readTokenCreateForm.label, {
                attr: {
                    class: 'input w-full',
                    maxlength: 120,
                    placeholder: 'projects.read_token.label_placeholder'|trans,
                    autocomplete: 'off',
                }
            }) }}
        </label>
        <button type="submit" class="btn-primary">{{ 'projects.read_token.create'|trans }}</button>
    {{ form_end(readTokenCreateForm) }}
    <ul class="space-y-2 text-sm">
        {% for token in readTokens|default([]) %}
            <li class="flex flex-wrap items-center justify-between gap-2 rounded-md border border-[var(--color-sand)] p-3" data-testid="read-token-row">
                <div>
                    <div class="font-medium">{{ token.label }}</div>
                    <div class="font-mono text-xs text-[var(--color-ink)]/55">{{ token.prefix }}…</div>
                    <div class="text-xs text-[var(--color-ink)]/55">
                        {% if token.active %}
                            {{ 'projects.read_token.active'|trans }}
                            {% if token.lastUsedAt %} · {{ 'projects.read_token.last_used'|trans }} {{ token.lastUsedAt|date('Y-m-d H:i') }}{% endif %}
                        {% else %}
                            {{ 'projects.read_token.revoked_at'|trans }} {{ token.revokedAt ? token.revokedAt|date('Y-m-d H:i') : '—' }}
                        {% endif %}
                    </div>
                </div>
                {% if token.active %}
                    {{ form_start(readTokenRevokeForms[token.id], {
                        action: path('project_read_token_revoke', {id: project.uuid, tokenId: token.uuid}),
                    }) }}
                        <button type="submit" class="btn-ghost text-sm text-[var(--color-clay)]">{{ 'projects.read_token.revoke'|trans }}</button>
                    {{ form_end(readTokenRevokeForms[token.id]) }}
                {% endif %}
            </li>
        {% else %}
            <li class="text-sm text-[var(--color-ink)]/55">{{ 'projects.read_token.empty'|trans }}</li>
        {% endfor %}
    </ul>
</section>
{% endif %}

{% if membership.canManageShareLinks %}
<section class="panel mt-6" data-testid="share-links">
    <h2 class="mb-2 text-lg font-semibold">{{ 'projects.share.title'|trans }}</h2>
    <p class="mb-4 text-sm text-[var(--color-ink)]/60">{{ 'projects.share.help'|trans }}</p>
    {% if lastShareUrl %}
        <p class="mb-4 rounded-md border border-[var(--color-moss)]/30 bg-[var(--color-moss)]/10 p-3 text-sm break-all" data-testid="share-url">{{ lastShareUrl }}</p>
    {% endif %}
    {{ form_start(shareCreateForm, {attr: {class: 'mb-4 flex flex-wrap items-end gap-3'}}) }}
        <label class="text-sm">
            <span class="mb-1 block">{{ 'projects.share.days'|trans }}</span>
            {{ form_widget(shareCreateForm.days, {attr: {class: 'input'}}) }}
        </label>
        <label class="text-sm">
            <span class="mb-1 block">{{ 'projects.share.max_uses'|trans }}</span>
            {{ form_widget(shareCreateForm.max_uses, {attr: {class: 'input', placeholder: 'projects.share.max_uses_unlimited'|trans}}) }}
        </label>
        <label class="text-sm grow">
            <span class="mb-1 block">{{ 'projects.share.issue_uuid'|trans }}</span>
            {{ form_widget(shareCreateForm.issue_uuid, {
                attr: {
                    class: 'input w-full',
                    placeholder: 'projects.share.issue_optional'|trans,
                    autocomplete: 'off',
                }
            }) }}
        </label>
        <button type="submit" class="btn-primary">{{ 'projects.share.create'|trans }}</button>
    {{ form_end(shareCreateForm) }}
    <p class="mb-4 text-xs text-[var(--color-ink)]/50">{{ 'projects.share.max_uses_help'|trans }}</p>
    <ul class="space-y-2 text-sm">
        {% for link in shareLinks|default([]) %}
            <li class="flex flex-wrap items-center justify-between gap-2 rounded-md border border-[var(--color-sand)] p-3">
                <div>
                    <div class="font-mono text-xs">{{ link.uuid|slice(0, 8) }}…</div>
                    <div class="text-xs text-[var(--color-ink)]/55">
                        {{ 'projects.share.expires'|trans }} {{ link.expiresAt|date('Y-m-d H:i') }}
                        · {{ 'projects.share.uses'|trans({'%used%': link.useCount, '%max%': link.maxUses ?? ('projects.share.max_uses_unlimited'|trans)}) }}
                        {% if link.issue %} · {{ 'projects.share.scoped_issue'|trans }}{% endif %}
                    </div>
                </div>
                {{ form_start(shareRevokeForms[link.id], {
                    action: path('project_share_revoke', {id: project.uuid, shareId: link.uuid}),
                }) }}
                    <button type="submit" class="btn-ghost">{{ 'projects.share.revoke'|trans }}</button>
                {{ form_end(shareRevokeForms[link.id]) }}
            </li>
        {% else %}
            <li class="text-[var(--color-ink)]/55">{{ 'projects.share.empty'|trans }}</li>
        {% endfor %}
    </ul>
</section>
{% endif %}

<section class="panel mt-6">
    <h2 class="mb-3 text-lg font-semibold">{{ 'project.groups.title'|trans }}</h2>
    <p class="mb-3 text-sm text-[var(--color-ink)]/60">{{ 'project.groups.help'|trans }}</p>
    <ul class="space-y-3 text-sm">
        {% for groupAccess in project.groupAccesses %}
            {% set linkedGroup = groupAccess.userGroup %}
            <li class="rounded-md border border-[var(--color-sand)] bg-[var(--color-paper)] p-3">
                <div class="flex flex-wrap items-start justify-between gap-3">
                    <div class="min-w-0">
                        <div class="font-medium">{{ linkedGroup.name }}</div>
                        <div class="text-xs text-[var(--color-ink)]/60">{{ 'project.groups.member_count'|trans({'%count%': group_member_counts[linkedGroup.id]|default(0)}) }}</div>
                        <div class="mt-1">
                            <span class="badge bg-[var(--color-sand)]">{{ ('project.members.role.' ~ groupAccess.role.value)|trans }}</span>
                        </div>
                    </div>
                    {% if assignableGroupRoles is not empty %}
                        <div class="flex shrink-0 items-center gap-1">
                            {% embed 'shared/_confirm_dialog.html.twig' with {
                                custom_form: true,
                                aria_labelledby: 'project-group-role-title-' ~ groupAccess.id,
                            } %}
                                {% block trigger %}
                                    <button
                                        type="button"
                                        class="btn-ghost btn-sm btn-icon"
                                        data-action="confirm-dialog#open"
                                        title="{{ 'project.groups.edit_role'|trans }}"
                                        aria-label="{{ 'project.groups.edit_role'|trans }}"
                                    >
                                        <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                            <path fill="currentColor" d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zm2.92 2.83H5v-.92l9.06-9.06.92.92L5.92 20.08zM20.71 7.04a1 1 0 0 0 0-1.41l-2.34-2.34a1 1 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/>
                                        </svg>
                                    </button>
                                {% endblock %}
                                {% block form %}
                                    {{ form_start(groupRoleForms[groupAccess.id], {attr: {class: 'confirm-dialog__panel'}}) }}
                                        <div class="confirm-dialog__header">
                                            <h2 id="project-group-role-title-{{ groupAccess.id }}" class="confirm-dialog__title">{{ 'project.groups.edit_role_title'|trans }}</h2>
                                            <p class="confirm-dialog__body">{{ 'project.groups.edit_role_body'|trans({'%name%': linkedGroup.name}) }}</p>
                                        </div>
                                        <div class="confirm-dialog__content">
                                            <label class="confirm-dialog__label" for="group-role-{{ groupAccess.id }}">{{ 'project.members.role_label'|trans }}</label>
                                            {{ form_widget(groupRoleForms[groupAccess.id].role, {attr: {id: 'group-role-' ~ groupAccess.id, class: 'input w-full'}}) }}
                                        </div>
                                        <div class="confirm-dialog__actions">
                                            <button type="button" class="btn-ghost" data-confirm-dialog-close>{{ 'project.danger.cancel'|trans }}</button>
                                            <button type="submit" class="btn-primary">{{ 'project.members.update_role'|trans }}</button>
                                        </div>
                                    {{ form_end(groupRoleForms[groupAccess.id]) }}
                                {% endblock %}
                            {% endembed %}

                            {% embed 'shared/_confirm_dialog.html.twig' with {
                                custom_form: true,
                                form_action: path('project_groups_remove', {projectId: project.uuid, groupAccessId: groupAccess.uuid}),
                                aria_labelledby: 'project-group-remove-title-' ~ groupAccess.id,
                            } %}
                                {% block form %}
                                    {{ form_start(groupRemoveForms[groupAccess.id], {
                                        action: path('project_groups_remove', {projectId: project.uuid, groupAccessId: groupAccess.uuid}),
                                        attr: {class: 'confirm-dialog__panel'},
                                    }) }}
                                        <div class="confirm-dialog__header">
                                            <h2 id="project-group-remove-title-{{ groupAccess.id }}" class="confirm-dialog__title">{{ 'project.groups.remove_title'|trans }}</h2>
                                            <p class="confirm-dialog__body">{{ 'project.groups.remove_confirm'|trans({'%name%': linkedGroup.name}) }}</p>
                                        </div>
                                        <div class="confirm-dialog__content"></div>
                                        <div class="confirm-dialog__actions">
                                            <button type="button" class="btn-ghost" data-confirm-dialog-close>{{ 'project.danger.cancel'|trans }}</button>
                                            <button type="submit" class="btn-danger">{{ 'project.groups.remove'|trans }}</button>
                                        </div>
                                    {{ form_end(groupRemoveForms[groupAccess.id]) }}
                                {% endblock %}
                                {% block trigger %}
                                    <button
                                        type="button"
                                        class="btn-ghost btn-sm btn-icon"
                                        data-action="confirm-dialog#open"
                                        title="{{ 'project.groups.remove'|trans }}"
                                        aria-label="{{ 'project.groups.remove'|trans }}"
                                    >
                                        <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                            <path fill="currentColor" d="M6 19a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/>
                                        </svg>
                                    </button>
                                {% endblock %}
                            {% endembed %}
                        </div>
                    {% endif %}
                </div>
            </li>
        {% else %}
            <li class="text-[var(--color-ink)]/55">{{ 'project.groups.empty'|trans }}</li>
        {% endfor %}
    </ul>

    {% if assignableGroupRoles is not empty %}
        {% if availableGroups is not empty %}
            {{ form_start(groupAddForm, {attr: {class: 'mt-4 grid gap-2 sm:grid-cols-[1fr_auto_auto]'}}) }}
                {{ form_widget(groupAddForm.group, {attr: {class: 'input'}}) }}
                {{ form_widget(groupAddForm.role, {attr: {class: 'input'}}) }}
                <button class="btn-primary" type="submit">{{ 'project.groups.add'|trans }}</button>
            {{ form_end(groupAddForm) }}
        {% else %}
            <p class="mt-3 text-xs text-[var(--color-ink)]/55">{{ 'project.groups.none_available'|trans }}</p>
        {% endif %}
    {% endif %}
</section>

<section class="panel mt-6">
    <h2 class="mb-3 text-lg font-semibold">{{ 'project.health.title'|trans }}</h2>
    <p class="mb-4 text-sm text-[var(--color-ink)]/65">{{ 'project.health.intro'|trans }}</p>
    <dl class="mb-4 grid gap-3 text-sm sm:grid-cols-2">
        <div>
            <dt class="text-[var(--color-ink)]/55">{{ 'project.health.messenger_pending'|trans }}</dt>
            <dd class="mt-1 font-medium">
                {% if messengerQueue.available %}
                    {{ messengerQueue.pending }}
                    <span class="text-xs font-normal text-[var(--color-ink)]/55">({{ 'project.health.instance_wide'|trans }})</span>
                {% else %}
                    {{ 'project.health.messenger_unavailable'|trans }}
                    — <a href="{{ path('health_ready') }}">{{ 'project.health.ready_link'|trans }}</a>
                {% endif %}
            </dd>
        </div>
        <div>
            <dt class="text-[var(--color-ink)]/55">{{ 'project.health.ready_probe'|trans }}</dt>
            <dd class="mt-1"><a href="{{ path('health_ready') }}">/health/ready</a></dd>
        </div>
    </dl>
    <h3 class="mb-2 text-sm font-semibold">{{ 'project.health.destinations_title'|trans }}</h3>
    {% set destinations = project.notificationDestinations %}
    {% if destinations is empty %}
        <p class="text-sm text-[var(--color-ink)]/55">{{ 'project.health.destinations_empty'|trans }}</p>
    {% else %}
        <ul class="space-y-2 text-sm">
            {% for destination in destinations %}
                <li class="rounded-md border border-[var(--color-sand)] bg-[var(--color-paper)] p-3">
                    <div class="font-medium">
                        {{ destination.label }}
                        {% if beacon_notification_circuit_open(destination) %}
                            <span class="badge badge-error">{{ 'notifications.circuit_paused'|trans }}</span>
                        {% endif %}
                    </div>
                    <div class="mt-1 text-xs text-[var(--color-ink)]/60">
                        {% if beacon_notification_circuit_open(destination) %}
                            <p class="text-[var(--color-alert)]">{{ 'notifications.circuit_paused_help'|trans({'%count%': destination.consecutiveFailures}) }}</p>
                        {% endif %}
                        {% if destination.lastDeliveryAt %}
                            {{ 'project.health.last_delivery'|trans }}
                            {{ destination.lastDeliveryAt|date('Y-m-d H:i') }}
                            —
                            {% if destination.lastDeliverySuccess %}
                                <span class="text-emerald-700">{{ 'project.health.delivery_ok'|trans }}</span>
                            {% else %}
                                <span class="text-[var(--color-alert)]">{{ 'project.health.delivery_fail'|trans }}</span>
                                {% if destination.lastDeliveryError %}
                                    · {{ destination.lastDeliveryError }}
                                {% endif %}
                            {% endif %}
                        {% else %}
                            {{ 'project.health.never_delivered'|trans }}
                        {% endif %}
                    </div>
                    {% if beacon_notification_circuit_open(destination) and membership.canManageNotifications %}
                        {{ form_start(notificationResumeForms[destination.id], {
                            action: path('project_notification_resume', {projectId: project.uuid, id: destination.uuid}),
                            attr: {class: 'mt-2'},
                        }) }}
                            <button class="btn-ghost" type="submit">{{ 'notifications.resume'|trans }}</button>
                        {{ form_end(notificationResumeForms[destination.id]) }}
                    {% endif %}
                    {% set attempts = delivery_attempts_by_destination[destination.id]|default([]) %}
                    <div class="mt-3">
                        {% if attempts is empty %}
                            <p class="text-xs text-[var(--color-ink)]/55">{{ 'project.health.history_empty'|trans }}</p>
                        {% else %}
                            <details class="group rounded-md border border-[var(--color-sand)]/70 bg-[var(--color-sand)]/20 p-2">
                                <summary class="cursor-pointer list-none text-xs font-medium text-[var(--color-ink)]">
                                    <span class="group-open:hidden">{{ 'project.health.history_show'|trans({'%count%': attempts|length}) }}</span>
                                    <span class="hidden group-open:inline">{{ 'project.health.history_hide'|trans({'%count%': attempts|length}) }}</span>
                                </summary>
                                <ul class="mt-2 space-y-2 text-xs">
                                    {% for attempt in attempts %}
                                        <li class="rounded border border-[var(--color-sand)] bg-[var(--color-paper)] p-2">
                                            <div class="font-medium">
                                                {{ attempt.attemptedAt|date('Y-m-d H:i') }}
                                                —
                                                {% if attempt.successful %}
                                                    <span class="text-emerald-700">{{ 'project.health.delivery_ok'|trans }}</span>
                                                {% else %}
                                                    <span class="text-[var(--color-alert)]">{{ 'project.health.delivery_fail'|trans }}</span>
                                                {% endif %}
                                            </div>
                                            {% if attempt.errorSnippet %}
                                                <div class="mt-1 text-[var(--color-ink)]/65">{{ attempt.errorSnippet }}</div>
                                            {% endif %}
                                        </li>
                                    {% endfor %}
                                </ul>
                            </details>
                        {% endif %}
                    </div>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
</section>

{% if membership.canManageNotifications %}
<section class="panel mt-6">
    <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
        <div>
            <h2 class="text-lg font-semibold">{{ 'thresholds.title'|trans }}</h2>
            <p class="mt-1 text-sm text-[var(--color-ink)]/65">{{ 'thresholds.intro'|trans }}</p>
            {% if not project.ingestEnabled %}
                <p class="mt-2 text-xs text-[var(--color-alert)]">{{ 'thresholds.ingest_disabled'|trans }}</p>
            {% endif %}
        </div>
        <a class="btn-primary" href="{{ path('project_threshold_rule_new', {id: project.uuid}) }}">{{ 'thresholds.add'|trans }}</a>
    </div>
    {% set thresholdRules = project.thresholdRules %}
    {% if thresholdRules is empty %}
        <p class="text-sm text-[var(--color-ink)]/55">{{ 'thresholds.empty'|trans }}</p>
    {% else %}
        <ul class="space-y-3">
            {% for rule in thresholdRules %}
                <li class="rounded-md border border-[var(--color-sand)] bg-[var(--color-paper)] p-3 text-sm">
                    <div class="flex flex-wrap items-start justify-between gap-2">
                        <div>
                            <div class="font-medium">
                                {{ rule.label ?: 'thresholds.unnamed'|trans }}
                                {% if not rule.enabled %}
                                    <span class="badge badge-error">{{ 'thresholds.disabled'|trans }}</span>
                                {% endif %}
                            </div>
                            <div class="mt-1 text-xs text-[var(--color-ink)]/60">
                                {{ 'thresholds.summary'|trans({
                                    '%count%': rule.errorCount,
                                    '%window%': rule.windowMinutes,
                                    '%cooldown%': rule.cooldownMinutes
                                }) }}
                            </div>
                            <div class="mt-1 text-xs text-[var(--color-ink)]/55">
                                {% if rule.environment %}
                                    <span>{{ 'thresholds.filter.environment'|trans({'%value%': rule.environment}) }}</span>
                                {% endif %}
                                {% if rule.releaseVersion %}
                                    <span{% if rule.environment %} class="ml-2"{% endif %}>{{ 'thresholds.filter.release'|trans({'%value%': rule.releaseVersion}) }}</span>
                                {% endif %}
                                {% if not rule.environment and not rule.releaseVersion %}
                                    <span>{{ 'thresholds.filter.all_events'|trans }}</span>
                                {% endif %}
                            </div>
                            <div class="mt-1 text-xs text-[var(--color-ink)]/55">
                                {% if rule.lastFiredAt %}
                                    {{ 'thresholds.last_fired'|trans }} {{ rule.lastFiredAt|date('Y-m-d H:i') }}
                                {% else %}
                                    {{ 'thresholds.never_fired'|trans }}
                                {% endif %}
                            </div>
                        </div>
                        <div class="flex flex-wrap gap-2">
                            <a class="btn-ghost" href="{{ path('project_threshold_rule_edit', {projectId: project.uuid, id: rule.uuid}) }}">{{ 'thresholds.edit'|trans }}</a>
                            {{ form_start(thresholdToggleForms[rule.id], {
                                action: path('project_threshold_rule_toggle', {projectId: project.uuid, id: rule.uuid}),
                            }) }}
                                <button class="btn-ghost" type="submit">{{ rule.enabled ? 'thresholds.disable'|trans : 'thresholds.enable'|trans }}</button>
                            {{ form_end(thresholdToggleForms[rule.id]) }}
                            {{ form_start(thresholdDeleteForms[rule.id], {
                                action: path('project_threshold_rule_delete', {projectId: project.uuid, id: rule.uuid}),
                                attr: {
                                    'data-controller': 'confirm-submit',
                                    'data-confirm-submit-message-value': 'thresholds.delete_confirm'|trans,
                                    'data-action': 'submit->confirm-submit#confirm',
                                },
                            }) }}
                                <button class="btn-danger" type="submit">{{ 'thresholds.delete'|trans }}</button>
                            {{ form_end(thresholdDeleteForms[rule.id]) }}
                        </div>
                    </div>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
</section>
{% endif %}

<section class="panel mt-6">
    <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
        <h2 class="text-lg font-semibold">{{ 'notifications.title'|trans }}</h2>
        <div class="flex flex-wrap gap-2">
            <a class="btn-ghost" href="{{ path('project_notification_help', {id: project.uuid}) }}">{{ 'notifications.help.link'|trans }}</a>
            {% if membership.canManageNotifications %}
                <a class="btn-primary" href="{{ path('project_notification_new', {id: project.uuid}) }}">{{ 'notifications.add'|trans }}</a>
            {% endif %}
        </div>
    </div>
    <p class="mb-4 text-sm text-[var(--color-ink)]/65">{{ 'notifications.intro'|trans }}</p>
    {% set destinations = project.notificationDestinations %}
    {% if destinations is empty %}
        <p class="text-sm text-[var(--color-ink)]/55">{{ 'notifications.empty'|trans }}</p>
    {% else %}
        <ul class="space-y-3">
            {% for destination in destinations %}
                <li class="rounded-md border border-[var(--color-sand)] bg-[var(--color-paper)] p-3 text-sm">
                    <div class="flex flex-wrap items-start justify-between gap-2">
                        <div>
                            <div class="font-medium">
                                {{ destination.label }}
                                {% if not destination.enabled %}
                                    <span class="badge badge-error">{{ 'notifications.disabled'|trans }}</span>
                                {% endif %}
                                {% if beacon_notification_circuit_open(destination) %}
                                    <span class="badge badge-error">{{ 'notifications.circuit_paused'|trans }}</span>
                                {% endif %}
                            </div>
                            <div class="mt-1 text-xs text-[var(--color-ink)]/60">
                                {{ ('notifications.type.' ~ destination.type.value)|trans }}
                                · {{ destination.maskedEndpointUrl }}
                            </div>
                            <div class="mt-1 text-xs text-[var(--color-ink)]/55">
                                {% for category in destination.categories %}
                                    <span class="mr-1">{{ ('notifications.category.' ~ category)|trans }}</span>{% if not loop.last %},{% endif %}
                                {% endfor %}
                            </div>
                        </div>
                        {% if membership.canManageNotifications %}
                            <div class="flex flex-wrap gap-2">
                                <a class="btn-ghost" href="{{ path('project_notification_edit', {projectId: project.uuid, id: destination.uuid}) }}">{{ 'notifications.edit'|trans }}</a>
                                {% if beacon_notification_circuit_open(destination) %}
                                    {{ form_start(notificationResumeForms[destination.id], {
                                        action: path('project_notification_resume', {projectId: project.uuid, id: destination.uuid}),
                                    }) }}
                                        <button class="btn-ghost" type="submit">{{ 'notifications.resume'|trans }}</button>
                                    {{ form_end(notificationResumeForms[destination.id]) }}
                                {% endif %}
                                {{ form_start(notificationToggleForms[destination.id], {
                                    action: path('project_notification_toggle', {projectId: project.uuid, id: destination.uuid}),
                                }) }}
                                    <button class="btn-ghost" type="submit">{{ destination.enabled ? 'notifications.disable'|trans : 'notifications.enable'|trans }}</button>
                                {{ form_end(notificationToggleForms[destination.id]) }}
                                {{ form_start(notificationTestForms[destination.id], {
                                    action: path('project_notification_test', {projectId: project.uuid, id: destination.uuid}),
                                }) }}
                                    <button class="btn-ghost" type="submit" title="{{ 'notifications.test_hint'|trans({'%type%': ('notifications.type.' ~ destination.type.value)|trans}) }}">{{ 'notifications.test'|trans }}</button>
                                {{ form_end(notificationTestForms[destination.id]) }}
                                {{ form_start(notificationDeleteForms[destination.id], {
                                    action: path('project_notification_delete', {projectId: project.uuid, id: destination.uuid}),
                                    attr: {
                                        'data-controller': 'confirm-submit',
                                        'data-confirm-submit-message-value': 'notifications.delete_confirm'|trans,
                                        'data-action': 'submit->confirm-submit#confirm',
                                    },
                                }) }}
                                    <button class="btn-danger" type="submit">{{ 'notifications.delete'|trans }}</button>
                                {{ form_end(notificationDeleteForms[destination.id]) }}
                            </div>
                        {% endif %}
                    </div>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
</section>

{% if membership.canManageSettings %}
<section class="panel mt-6" data-testid="project-config-portability">
    <h2 class="mb-2 text-lg font-semibold">{{ 'project.config.title'|trans }}</h2>
    <p class="mb-3 text-sm text-[var(--color-ink)]/60">{{ 'project.config.help'|trans({'%code%': project.code != '' ? project.code : project.slug}) }}</p>

    <div
        data-controller="tabs"
        data-tabs-active-tab-value="project-config-export"
        class="grid gap-3"
    >
        <nav
            role="tablist"
            aria-label="{{ 'project.config.tabs_label'|trans|e('html_attr') }}"
            class="flex h-auto w-full flex-wrap justify-start gap-1 border-b border-[var(--color-sand)]"
        >
            <button
                type="button"
                id="tab-project-config-export"
                data-action="click->tabs#open"
                data-tabs-target="trigger"
                data-tab-id="project-config-export"
                role="tab"
                aria-controls="tab-project-config-export-panel"
                aria-selected="true"
                data-active
                class="relative inline-flex min-w-10 items-center justify-center px-2.5 py-1.5 text-sm font-medium text-[var(--color-ink)]/55 transition-colors hover:text-[var(--color-ink)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-moss)] data-[active]:text-[var(--color-ink)] data-[active]:after:absolute data-[active]:after:inset-x-0 data-[active]:after:bottom-[-1px] data-[active]:after:h-0.5 data-[active]:after:bg-[var(--color-ink)]"
            >{{ 'project.config.tab_export'|trans }}</button>
            <button
                type="button"
                id="tab-project-config-import"
                data-action="click->tabs#open"
                data-tabs-target="trigger"
                data-tab-id="project-config-import"
                role="tab"
                aria-controls="tab-project-config-import-panel"
                aria-selected="false"
                class="relative inline-flex min-w-10 items-center justify-center px-2.5 py-1.5 text-sm font-medium text-[var(--color-ink)]/55 transition-colors hover:text-[var(--color-ink)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-moss)] data-[active]:text-[var(--color-ink)] data-[active]:after:absolute data-[active]:after:inset-x-0 data-[active]:after:bottom-[-1px] data-[active]:after:h-0.5 data-[active]:after:bg-[var(--color-ink)]"
            >{{ 'project.config.tab_import'|trans }}</button>
        </nav>

        <div
            id="tab-project-config-export-panel"
            data-tabs-target="tab"
            data-tab-id="project-config-export"
            role="tabpanel"
            aria-labelledby="tab-project-config-export"
            data-active
            data-state="active"
        >
            <div class="grid gap-3 pt-1">
                <p class="text-sm text-[var(--color-ink)]/60">{{ 'project.config.export_help'|trans }}</p>
                <div>
                    <a class="btn-primary no-underline" href="{{ path('project_config_export', {id: project.uuid}) }}" data-testid="project-config-download">{{ 'project.config.export'|trans }}</a>
                </div>
            </div>
        </div>

        <div
            id="tab-project-config-import-panel"
            data-tabs-target="tab"
            data-tab-id="project-config-import"
            role="tabpanel"
            aria-labelledby="tab-project-config-import"
            data-state="inactive"
            class="hidden"
            hidden
        >
            <div class="grid gap-3 pt-1" data-testid="project-config-import">
                <p class="text-sm text-[var(--color-ink)]/60">{{ 'project.config.import_help'|trans }}</p>
                {{ form_start(configImportForm, {attr: {class: 'grid gap-3 sm:max-w-md', 'data-testid': 'project-config-import-form'}}) }}
                    <label class="grid gap-1.5">
                        <span class="text-sm font-medium text-[var(--color-ink)]">{{ 'project.config.file'|trans }}</span>
                        {{ form_widget(configImportForm.bundle, {attr: {class: 'input', accept: 'application/json,.json', 'data-testid': 'project-config-file'}}) }}
                    </label>
                    <div>
                        <button class="btn-primary" type="submit" data-testid="project-config-import-submit">{{ 'project.config.import'|trans }}</button>
                    </div>
                {{ form_end(configImportForm) }}
                <p class="text-xs text-[var(--color-ink)]/55">{{ 'project.config.panel_note'|trans }}</p>
            </div>
        </div>
    </div>
</section>
{% endif %}

{% if membership.canManageSettings or membership.canDeleteProject %}
<section class="panel panel--danger mt-6">
    <h2 class="mb-2 text-lg font-semibold text-[var(--color-alert)]">{{ 'project.danger.title'|trans }}</h2>
    <p class="mb-4 text-sm text-[var(--color-ink)]/65">{{ 'project.danger.intro'|trans }}</p>

    <div class="flex flex-wrap gap-3">
        {% if membership.canManageSettings %}
        {% embed 'shared/_confirm_dialog.html.twig' with {
            custom_form: true,
            trigger_class: 'btn-ghost',
            trigger_label: 'project.danger.clear_open'|trans,
            aria_labelledby: 'project-clear-history-title',
        } %}
            {% block form %}
                {{ form_start(clearHistoryForm, {
                    action: path('project_clear_history', {id: project.uuid}),
                    attr: {class: 'confirm-dialog__panel'},
                }) }}
                    <div class="confirm-dialog__header">
                        <h2 id="project-clear-history-title" class="confirm-dialog__title">{{ 'project.danger.clear_title'|trans }}</h2>
                        <p class="confirm-dialog__body">{{ 'project.danger.clear_body'|trans }}</p>
                    </div>
                    <div class="confirm-dialog__content"></div>
                    <div class="confirm-dialog__actions">
                        <button type="button" class="btn-ghost" data-confirm-dialog-close>{{ 'project.danger.cancel'|trans }}</button>
                        <button type="submit" class="btn-danger">{{ 'project.danger.clear_confirm'|trans }}</button>
                    </div>
                {{ form_end(clearHistoryForm) }}
            {% endblock %}
        {% endembed %}
        {% endif %}

        {% if membership.isPrimaryOwner %}
            {% embed 'shared/_confirm_dialog.html.twig' with {
                expected_value: project.name,
                trigger_class: 'btn-ghost',
                trigger_label: 'project.danger.transfer_open'|trans,
                trigger_title: transferCandidates is empty ? 'project.danger.transfer_no_candidates'|trans : 'project.danger.transfer_open'|trans,
                custom_form: true,
                aria_labelledby: 'project-transfer-title-' ~ project.id,
            } %}
                {% block form %}
                    {{ form_start(transferOwnershipForm, {attr: {class: 'confirm-dialog__panel'}}) }}
                        <div class="confirm-dialog__header">
                            <h2 id="project-transfer-title-{{ project.id }}" class="confirm-dialog__title">{{ 'project.danger.transfer_title'|trans }}</h2>
                            {% if transferCandidates is empty %}
                                <p class="confirm-dialog__body">{{ 'project.danger.transfer_no_candidates'|trans }}</p>
                            {% else %}
                                <p class="confirm-dialog__body">{{ 'project.danger.transfer_body'|trans }}</p>
                            {% endif %}
                        </div>
                        <div class="confirm-dialog__content">
                            {% if transferCandidates is not empty %}
                                <label class="confirm-dialog__label" for="project-transfer-user-{{ project.id }}">{{ 'project.danger.transfer_member_label'|trans }}</label>
                                {{ form_widget(transferOwnershipForm.user, {attr: {id: 'project-transfer-user-' ~ project.id, class: 'input w-full'}}) }}
                                <label class="confirm-dialog__label" for="project-transfer-confirm-{{ project.id }}">
                                    {{ 'project.danger.transfer_type_label'|trans({'%name%': project.name}) }}
                                </label>
                                {{ form_widget(transferOwnershipForm.confirmation, {
                                    attr: {
                                        id: 'project-transfer-confirm-' ~ project.id,
                                        class: 'input w-full',
                                        autocomplete: 'off',
                                        'data-confirm-dialog-target': 'confirmInput',
                                    }
                                }) }}
                            {% endif %}
                        </div>
                        <div class="confirm-dialog__actions">
                            <button type="button" class="btn-ghost" data-confirm-dialog-close>{{ 'project.danger.cancel'|trans }}</button>
                            {% if transferCandidates is not empty %}
                                <button type="submit" class="btn-danger" data-confirm-dialog-target="submit" disabled>{{ 'project.danger.transfer_confirm'|trans }}</button>
                            {% endif %}
                        </div>
                    {{ form_end(transferOwnershipForm) }}
                {% endblock %}
            {% endembed %}
        {% endif %}

        {% if membership.canDeleteProject %}
            {% embed 'shared/_confirm_dialog.html.twig' with {
                custom_form: true,
                expected_value: project.name,
                trigger_class: 'btn-danger',
                trigger_label: 'project.danger.delete_open'|trans,
                aria_labelledby: 'project-delete-title',
            } %}
                {% block form %}
                    {{ form_start(deleteProjectForm, {
                        action: path('project_delete', {id: project.uuid}),
                        attr: {class: 'confirm-dialog__panel'},
                    }) }}
                        <div class="confirm-dialog__header">
                            <h2 id="project-delete-title" class="confirm-dialog__title">{{ 'project.danger.delete_title'|trans }}</h2>
                            <p class="confirm-dialog__body">{{ 'project.danger.delete_body'|trans({'%name%': project.name}) }}</p>
                        </div>
                        <div class="confirm-dialog__content">
                            <label class="confirm-dialog__label" for="project-delete-confirm-{{ project.id }}">
                                {{ 'project.danger.delete_type_label'|trans({'%name%': project.name}) }}
                            </label>
                            {{ form_widget(deleteProjectForm.confirmation) }}
                            {% include 'form/_fields.html.twig' with {form: deleteProjectForm} only %}
                        </div>
                        <div class="confirm-dialog__actions">
                            <button type="button" class="btn-ghost" data-confirm-dialog-close>{{ 'project.danger.cancel'|trans }}</button>
                            <button type="submit" class="btn-danger" data-confirm-dialog-target="submit" disabled>{{ 'project.danger.delete_confirm'|trans }}</button>
                        </div>
                    {{ form_end(deleteProjectForm) }}
                {% endblock %}
            {% endembed %}
        {% endif %}
    </div>
</section>
{% endif %}
{% endblock %}
