<section class="panel mt-6" data-testid="project-threshold-rules">
    <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
        <div>
            <h2 class="text-lg font-semibold">{{ 'thresholds.title'|trans }}</h2>
            <p class="mt-1 text-sm text-[var(--color-ink)]/65">{{ 'thresholds.intro'|trans }}</p>
            {% if not project.ingestEnabled %}
                <p class="mt-2 text-xs text-[var(--color-alert)]">{{ 'thresholds.ingest_disabled'|trans }}</p>
            {% endif %}
        </div>
        {% if thresholdCreateForm %}
            {% embed 'shared/_confirm_dialog.html.twig' with {
                custom_form: true,
                dialog_modifier: 'confirm-dialog--wide',
                open_on_connect: openThresholdCreate|default(false),
                aria_labelledby: 'project-threshold-create-title-' ~ project.id,
            } %}
                {% block trigger %}
                    <button
                        type="button"
                        class="btn-primary"
                        data-action="confirm-dialog#open"
                        data-testid="project-threshold-add"
                    >{{ 'thresholds.add'|trans }}</button>
                {% endblock %}
                {% block form %}
                    {{ form_start(thresholdCreateForm, {attr: {class: 'confirm-dialog__panel', 'data-testid': 'project-threshold-create-form'}}) }}
                        <div class="confirm-dialog__header">
                            <h2 id="project-threshold-create-title-{{ project.id }}" class="confirm-dialog__title">{{ 'thresholds.new_title'|trans }}</h2>
                            <p class="confirm-dialog__body">{{ 'thresholds.form_help'|trans }}</p>
                        </div>
                        <div class="confirm-dialog__content space-y-3">
                            {{ form_row(thresholdCreateForm.label) }}
                            {{ form_row(thresholdCreateForm.enabled) }}
                            <div class="grid gap-3 sm:grid-cols-3">
                                {{ form_row(thresholdCreateForm.errorCount) }}
                                {{ form_row(thresholdCreateForm.windowMinutes) }}
                                {{ form_row(thresholdCreateForm.cooldownMinutes) }}
                            </div>
                            <div class="grid gap-3 sm:grid-cols-2">
                                {{ form_row(thresholdCreateForm.environment) }}
                                {{ form_row(thresholdCreateForm.releaseVersion) }}
                            </div>
                            {% include 'form/_fields.html.twig' with {form: thresholdCreateForm} only %}
                        </div>
                        <div class="confirm-dialog__actions">
                            <button type="button" class="btn-ghost" data-confirm-dialog-close>{{ 'thresholds.cancel'|trans }}</button>
                            <button type="submit" class="btn-primary">{{ 'thresholds.save'|trans }}</button>
                        </div>
                    {{ form_end(thresholdCreateForm, {render_rest: false}) }}
                {% endblock %}
            {% endembed %}
        {% endif %}
    </div>
    {% set thresholdRules = project.thresholdRules %}
    {% if thresholdRules is empty %}
        <p class="text-sm text-[var(--color-ink)]/55">{{ 'thresholds.empty'|trans }}</p>
    {% else %}
        <ul class="space-y-3">
            {% for rule in thresholdRules %}
                <li class="rounded-md border border-[var(--color-sand)] bg-[var(--color-paper)] p-3 text-sm">
                    <div class="flex flex-wrap items-start justify-between gap-2">
                        <div>
                            <div class="font-medium">
                                {{ rule.label ?: 'thresholds.unnamed'|trans }}
                                {% if not rule.enabled %}
                                    <span class="badge badge-error">{{ 'thresholds.disabled'|trans }}</span>
                                {% endif %}
                            </div>
                            <div class="mt-1 text-xs text-[var(--color-ink)]/60">
                                {{ 'thresholds.summary'|trans({
                                    '%count%': rule.errorCount,
                                    '%window%': rule.windowMinutes,
                                    '%cooldown%': rule.cooldownMinutes
                                }) }}
                            </div>
                            <div class="mt-1 text-xs text-[var(--color-ink)]/55">
                                {% if rule.environment %}
                                    <span>{{ 'thresholds.filter.environment'|trans({'%value%': rule.environment}) }}</span>
                                {% endif %}
                                {% if rule.releaseVersion %}
                                    <span{% if rule.environment %} class="ml-2"{% endif %}>{{ 'thresholds.filter.release'|trans({'%value%': rule.releaseVersion}) }}</span>
                                {% endif %}
                                {% if not rule.environment and not rule.releaseVersion %}
                                    <span>{{ 'thresholds.filter.all_events'|trans }}</span>
                                {% endif %}
                            </div>
                            <div class="mt-1 text-xs text-[var(--color-ink)]/55">
                                {% if rule.lastFiredAt %}
                                    {{ 'thresholds.last_fired'|trans }} {{ rule.lastFiredAt|date('Y-m-d H:i') }}
                                {% else %}
                                    {{ 'thresholds.never_fired'|trans }}
                                {% endif %}
                            </div>
                        </div>
                        <div class="flex flex-wrap gap-2">
                            <a class="btn-ghost" href="{{ path('project_threshold_rule_edit', {projectId: project.uuid, id: rule.uuid}) }}">{{ 'thresholds.edit'|trans }}</a>
                            {{ form_start(thresholdToggleForms[rule.id], {
                                action: path('project_threshold_rule_toggle', {projectId: project.uuid, id: rule.uuid}),
                            }) }}
                                <button class="btn-ghost" type="submit">{{ rule.enabled ? 'thresholds.disable'|trans : 'thresholds.enable'|trans }}</button>
                            {{ form_end(thresholdToggleForms[rule.id]) }}
                            {{ form_start(thresholdDeleteForms[rule.id], {
                                action: path('project_threshold_rule_delete', {projectId: project.uuid, id: rule.uuid}),
                                attr: {
                                    'data-controller': 'confirm-submit',
                                    'data-confirm-submit-message-value': 'thresholds.delete_confirm'|trans,
                                    'data-action': 'submit->confirm-submit#confirm',
                                },
                            }) }}
                                <button class="btn-danger" type="submit">{{ 'thresholds.delete'|trans }}</button>
                            {{ form_end(thresholdDeleteForms[rule.id]) }}
                        </div>
                    </div>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
</section>
