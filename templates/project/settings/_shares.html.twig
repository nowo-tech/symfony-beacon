<section class="panel mt-6" data-testid="share-links">
    <h2 class="mb-2 text-lg font-semibold">{{ 'projects.share.title'|trans }}</h2>
    <p class="mb-4 text-sm text-[var(--color-ink)]/60">{{ 'projects.share.help'|trans }}</p>
    {% if lastShareUrl %}
        <p class="mb-4 rounded-md border border-[var(--color-moss)]/30 bg-[var(--color-moss)]/10 p-3 text-sm break-all" data-testid="share-url">{{ lastShareUrl }}</p>
    {% endif %}
    {{ form_start(shareCreateForm, {attr: {class: 'mb-4 flex flex-wrap items-end gap-3'}}) }}
        {% for field in shareCreateForm %}
            {% if not field.rendered and 'hidden' not in field.vars.block_prefixes %}
                {{ form_row(field) }}
            {% endif %}
        {% endfor %}
        <button type="submit" class="btn-primary">{{ 'projects.share.create'|trans }}</button>
        {% include 'form/_fields.html.twig' with {form: shareCreateForm} only %}
    {{ form_end(shareCreateForm, {render_rest: false}) }}
    <ul class="space-y-2 text-sm">
        {% for link in shareLinks|default([]) %}
            <li class="flex flex-wrap items-center justify-between gap-2 rounded-md border border-[var(--color-sand)] p-3">
                <div>
                    <div class="font-mono text-xs">{{ link.uuid|slice(0, 8) }}…</div>
                    <div class="text-xs text-[var(--color-ink)]/55">
                        {{ 'projects.share.expires'|trans }} {{ link.expiresAt|date('Y-m-d H:i') }}
                        · {{ 'projects.share.uses'|trans({'%used%': link.useCount, '%max%': link.maxUses ?? ('projects.share.max_uses_unlimited'|trans)}) }}
                        {% if link.issue %} · {{ 'projects.share.scoped_issue'|trans }}{% endif %}
                    </div>
                </div>
                {{ form_start(shareRevokeForms[link.id], {
                    action: path('project_share_revoke', {id: project.uuid, shareId: link.uuid}),
                }) }}
                    <button type="submit" class="btn-ghost">{{ 'projects.share.revoke'|trans }}</button>
                {{ form_end(shareRevokeForms[link.id]) }}
            </li>
        {% else %}
            <li class="text-[var(--color-ink)]/55">{{ 'projects.share.empty'|trans }}</li>
        {% endfor %}
    </ul>
</section>
