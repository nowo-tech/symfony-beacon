{# Site-wide legal footer + cookie preferences link.
   Pass request locale into |trans explicitly so shared Translator state left on
   DEFAULT_LOCALE by fragment sub-requests cannot desync footer labels from UI. #}
<footer class="site-legal-footer" role="contentinfo">
    <nav class="site-legal-footer__nav" aria-label="{{ 'legal.nav.label'|trans({}, 'messages', app.request.locale|default(default_locale)) }}">
        {% set loc = app.request.locale|default(default_locale) %}
        <a href="{{ path('legal_notice', {_locale: loc}) }}">{{ 'legal.notice.title'|trans({}, 'messages', loc) }}</a>
        <a href="{{ path('legal_privacy', {_locale: loc}) }}">{{ 'legal.privacy.title'|trans({}, 'messages', loc) }}</a>
        <a href="{{ path('legal_terms', {_locale: loc}) }}">{{ 'legal.terms.title'|trans({}, 'messages', loc) }}</a>
        <a href="{{ path('legal_cookies', {_locale: loc}) }}">{{ 'legal.cookies.title'|trans({}, 'messages', loc) }}</a>
        {% if nowo_cookie_consent_should_render() %}
            <a href="#" data-nowo-open-consent>{{ 'legal.manage_cookies'|trans({}, 'messages', loc) }}</a>
        {% else %}
            <a href="{{ path('legal_cookies', {_locale: loc}) }}">{{ 'legal.manage_cookies'|trans({}, 'messages', loc) }}</a>
        {% endif %}
    </nav>
</footer>
