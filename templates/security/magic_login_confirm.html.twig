{% extends 'layouts/guest_shell.html.twig' %}

{% block title %}{{ 'magic_login.confirm.title'|trans }} — {{ site_appearance.brandName }}{% endblock %}

{% block body %}
    <div class="guest-auth">
        <h1>{{ 'magic_login.confirm.heading'|trans }}</h1>
        <p>{{ 'magic_login.confirm.help'|trans }}</p>
        <form method="post" action="{{ action }}" class="guest-auth__form" data-turbo="false">
            {% for name, value in params %}
                <input type="hidden" name="{{ name }}" value="{{ value }}">
            {% endfor %}
            <button type="submit" class="btn-primary w-full">{{ 'magic_login.confirm.submit'|trans }}</button>
        </form>
    </div>
{% endblock %}
