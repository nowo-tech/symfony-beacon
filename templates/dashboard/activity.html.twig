{% extends 'base.html.twig' %}

{% block title %}{{ 'activity.title'|trans }} — {{ site_appearance.brandName }}{% endblock %}

{% block body %}
{% embed 'dashboard/_feed_layout.html.twig' with {
    title_key: 'activity.title',
    intro_key: 'activity.intro',
    filter_route: 'dashboard_activity',
    filterForm: filterForm,
    filters: filters,
    filters_testid: 'activity-filters',
    empty_testid: 'activity-empty',
    empty_key: 'activity.empty',
    results_testid: 'activity-results',
    pagination: pagination,
    pagination_route: 'dashboard_activity',
    filter_query: {
        project: filters.project,
        per_page: filters.per_page,
    },
    item_count: actions|length,
} %}
    {% block results %}
        <ul class="divide-y divide-[var(--color-sand)]/70">
            {% for entry in actions %}
                {% set ctx = entry.context %}
                <li class="flex flex-wrap items-baseline justify-between gap-2 py-3 text-sm">
                    <div class="min-w-0">
                        <span class="font-medium">{{ ('users.activity.action.' ~ entry.action.value)|trans }}</span>
                        {% if ctx.issue_title is defined and ctx.issue_title %}
                            {% if ctx.project_uuid is defined and ctx.issue_uuid is defined %}
                                <a class="ml-1 no-underline text-[var(--color-moss)] hover:underline" href="{{ path('issue_show', {projectId: ctx.project_uuid, id: ctx.issue_uuid}) }}">{{ ctx.issue_title }}</a>
                            {% else %}
                                <span class="ml-1 text-[var(--color-ink)]/70">{{ ctx.issue_title }}</span>
                            {% endif %}
                        {% elseif ctx.project_name is defined and ctx.project_name %}
                            {% if ctx.project_uuid is defined %}
                                <a class="ml-1 no-underline text-[var(--color-moss)] hover:underline" href="{{ path('project_show', {id: ctx.project_uuid}) }}">{{ ctx.project_name }}</a>
                            {% else %}
                                <span class="ml-1 text-[var(--color-ink)]/70">{{ ctx.project_name }}</span>
                            {% endif %}
                        {% endif %}
                    </div>
                    <time class="shrink-0 text-xs text-[var(--color-ink)]/55" datetime="{{ entry.createdAt|date('c') }}">{{ entry.createdAt|date('Y-m-d H:i') }}</time>
                </li>
            {% endfor %}
        </ul>
    {% endblock %}
{% endembed %}
{% endblock %}
