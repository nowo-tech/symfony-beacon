{% extends 'base.html.twig' %}

{% block title %}{{ 'new_in_release.title'|trans }} — {{ site_appearance.brandName }}{% endblock %}

{% block body %}
{% embed 'dashboard/_feed_layout.html.twig' with {
    title_key: 'new_in_release.title',
    intro_key: 'new_in_release.intro',
    filter_route: 'dashboard_new_in_release',
    filterForm: filterForm,
    filters: filters,
    filters_testid: 'new-in-release-filters',
    empty_testid: 'new-in-release-empty',
    empty_key: 'new_in_release.empty',
    results_testid: 'new-in-release-results',
    pagination: pagination,
    pagination_route: 'dashboard_new_in_release',
    filter_query: {
        project: filters.project,
        release: filters.release,
        per_page: filters.per_page,
    },
    item_count: issues|length,
} %}
    {% block results %}
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
                <thead>
                    <tr class="text-xs uppercase tracking-wide text-[var(--color-ink)]/55">
                        <th class="px-3 py-2">{{ 'new_in_release.col.project'|trans }}</th>
                        <th class="px-3 py-2">{{ 'issues.col.issue'|trans }}</th>
                        <th class="px-3 py-2">{{ 'new_in_release.col.release'|trans }}</th>
                        <th class="px-3 py-2">{{ 'issues.col.level'|trans }}</th>
                        <th class="px-3 py-2">{{ 'issues.col.last_seen'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for issue in issues %}
                        {% include 'dashboard/_issue_row.html.twig' with {
                            issue: issue,
                            show_release: true,
                        } only %}
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endblock %}
{% endembed %}
{% endblock %}
