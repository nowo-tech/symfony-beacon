{% extends 'base.html.twig' %}

{% block title %}{{ 'mentions.title'|trans }} — {{ site_appearance.brandName }}{% endblock %}

{% block body %}
{% embed 'dashboard/_feed_layout.html.twig' with {
    title_key: 'mentions.title',
    intro_key: 'mentions.intro',
    feed_header_class: 'flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between',
    filter_route: 'dashboard_mentions',
    filterForm: filterForm,
    filters: filters,
    filters_testid: 'mentions-filters',
    empty_testid: 'mentions-empty',
    empty_key: 'mentions.empty',
    results_testid: 'mentions-results',
    pagination: pagination,
    pagination_route: 'dashboard_mentions',
    filter_query: {
        project: filters.project,
        unread: filters.unread,
        per_page: filters.per_page,
    },
    item_count: mentions|length,
} %}
    {% block feed_header_extra %}
        {% if markAllReadForm %}
            {{ form_start(markAllReadForm, {action: path('dashboard_mentions_read_all')}) }}
                <button class="btn-ghost" type="submit">{{ 'mentions.mark_all_read'|trans }}</button>
            {{ form_end(markAllReadForm) }}
        {% endif %}
    {% endblock %}
    {% block filter_fields %}
        {% for field in filterForm %}
            {% if not field.rendered and 'hidden' not in field.vars.block_prefixes %}
                {% if field.vars.name == 'unread' %}
                    {{ form_row(field, {label: 'mentions.filter.unread_only'|trans}) }}
                {% else %}
                    {{ form_row(field) }}
                {% endif %}
            {% endif %}
        {% endfor %}
    {% endblock %}
    {% block results %}
        <ul class="divide-y divide-[var(--color-sand)]/70">
            {% for mention in mentions %}
                {% set comment = mention.comment %}
                {% set issue = comment.issue %}
                {% set project = issue.project %}
                {% set author = comment.author %}
                <li class="flex flex-col gap-2 py-3 sm:flex-row sm:items-start sm:justify-between {% if mention.unread %}bg-[var(--color-moss)]/5{% endif %}">
                    <div class="min-w-0 text-sm">
                        <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
                            <a class="font-medium no-underline hover:underline" href="{{ path('issue_show', {projectId: project.uuid, id: issue.uuid}) }}">{{ issue.title }}</a>
                            <span class="text-xs text-[var(--color-ink)]/55">{{ project.name }}</span>
                            {% if mention.unread %}<span class="badge">{{ 'mentions.unread'|trans }}</span>{% endif %}
                        </div>
                        <p class="mt-1 text-[var(--color-ink)]/70">
                            {{ 'mentions.by'|trans({'%name%': author.displayName ?: author.email}) }}
                            · {{ comment.body|length > 160 ? comment.body|slice(0, 160) ~ '…' : comment.body }}
                        </p>
                        <time class="mt-1 block text-xs text-[var(--color-ink)]/55" datetime="{{ mention.createdAt|date('c') }}">{{ mention.createdAt|date('Y-m-d H:i') }}</time>
                    </div>
                    {% if mention.unread and markReadForms[mention.id] is defined %}
                        {{ form_start(markReadForms[mention.id], {
                            action: path('dashboard_mentions_read', {id: mention.id}),
                            attr: {class: 'shrink-0'},
                        }) }}
                            {% include 'form/_fields.html.twig' with {form: markReadForms[mention.id]} only %}
                            <button class="btn-ghost btn-sm btn-label" type="submit">{{ 'mentions.mark_read'|trans }}</button>
                        {{ form_end(markReadForms[mention.id]) }}
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
    {% endblock %}
{% endembed %}
{% endblock %}
