{% extends 'base.html.twig' %}

{% block title %}{{ 'assignments.title'|trans }} — {{ site_appearance.brandName }}{% endblock %}

{% block body %}
{% embed 'dashboard/_feed_layout.html.twig' with {
    title_key: 'assignments.title',
    intro_key: 'assignments.intro',
    filter_route: 'dashboard_assignments',
    filter_grid_class: 'sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4',
    filters: filters,
    filters_testid: 'assignments-filters',
    empty_testid: 'assignments-empty',
    empty_key: 'assignments.empty',
    results_testid: 'assignments-results',
    pagination: pagination,
    pagination_route: 'dashboard_assignments',
    filter_query: {
        scope: filters.scope,
        project: filters.project,
        q: filters.q,
        level: filters.level,
        status: filters.status,
        priority: filters.priority,
        assignee: filters.assignee,
        sort: filters.sort,
        dir: filters.dir,
        per_page: filters.per_page,
    },
    item_count: issues|length,
} %}
    {% block filter_hidden %}
        <input type="hidden" name="sort" value="{{ filters.sort }}">
        <input type="hidden" name="dir" value="{{ filters.dir }}">
    {% endblock %}
    {% block filter_fields %}
        <select class="input" name="scope" aria-label="{{ 'assignments.filter.scope'|trans }}">
            {% for scope in scopes %}
                <option value="{{ scope.value }}" {% if filters.scope == scope.value %}selected{% endif %}>{{ ('assignments.scope.' ~ scope.value)|trans }}</option>
            {% endfor %}
        </select>

        <select class="input" name="project" aria-label="{{ 'assignments.filter.project'|trans }}">
            <option value="">{{ 'assignments.filter.any_project'|trans }}</option>
            {% for project in projects %}
                <option value="{{ project.uuid }}" {% if filters.project == project.uuid %}selected{% endif %}>{{ project.name }}</option>
            {% endfor %}
        </select>

        <input class="input" type="search" name="q" value="{{ filters.q }}" placeholder="{{ 'issues.search_placeholder'|trans }}">

        <select class="input" name="level" aria-label="{{ 'assignments.filter.level'|trans }}">
            <option value="">{{ 'issues.filter.any_level'|trans }}</option>
            {% for level in ['fatal', 'error', 'warning', 'info', 'debug'] %}
                <option value="{{ level }}" {% if filters.level == level %}selected{% endif %}>{{ level }}</option>
            {% endfor %}
        </select>

        <select class="input" name="status" aria-label="{{ 'assignments.filter.status'|trans }}">
            {% for status in ['unresolved', 'resolved', 'ignored'] %}
                <option value="{{ status }}" {% if filters.status == status %}selected{% endif %}>{{ status }}</option>
            {% endfor %}
        </select>

        <select class="input" name="priority" aria-label="{{ 'assignments.filter.priority'|trans }}">
            <option value="">{{ 'issues.filter.any_priority'|trans }}</option>
            {% for p in ['low', 'medium', 'high', 'critical'] %}
                <option value="{{ p }}" {% if filters.priority == p %}selected{% endif %}>{{ ('issues.priority.' ~ p)|trans }}</option>
            {% endfor %}
        </select>

        <select class="input" name="assignee" aria-label="{{ 'assignments.filter.assignee'|trans }}" {% if filters.scope == 'mine' or filters.scope == 'unassigned' %}disabled{% endif %}>
            <option value="">{{ 'issues.filter.any_assignee'|trans }}</option>
            {% for mate in teammates %}
                <option value="{{ mate.id }}" {% if filters.assignee == (mate.id ~ '') %}selected{% endif %}>{{ mate.displayName ?: mate.email }}</option>
            {% endfor %}
        </select>

        <select class="input" name="per_page" aria-label="{{ 'issues.filter.per_page'|trans }}">
            {% for size in [10, 25, 50, 100] %}
                <option value="{{ size }}" {% if filters.per_page == size %}selected{% endif %}>{{ 'issues.filter.per_page_option'|trans({'%count%': size}) }}</option>
            {% endfor %}
        </select>
    {% endblock %}
    {% block results %}
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
                <thead>
                    <tr class="text-xs uppercase tracking-wide text-[var(--color-ink)]/55">
                        <th class="px-3 py-2">{{ 'assignments.col.project'|trans }}</th>
                        <th class="px-3 py-2">{{ 'issues.col.issue'|trans }}</th>
                        <th class="px-3 py-2">{{ 'issues.col.level'|trans }}</th>
                        <th class="px-3 py-2">{{ 'assignments.col.status'|trans }}</th>
                        <th class="px-3 py-2">{{ 'issues.col.assignee'|trans }}</th>
                        <th class="px-3 py-2">{{ 'issues.col.last_seen'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for issue in issues %}
                        {% set assigneeLabel = issue.assignee ? (issue.assignee.displayName ?: issue.assignee.email) : ('issues.assignee_unassigned'|trans) %}
                        <tr class="border-t border-[var(--color-sand)]/70">
                            <td class="px-3 py-2 align-top">
                                <a class="no-underline text-[var(--color-moss)] hover:underline" href="{{ path('project_show', {id: issue.project.uuid}) }}">{{ issue.project.name }}</a>
                            </td>
                            <td class="px-3 py-2 align-top">
                                <a class="font-medium no-underline hover:underline" href="{{ path('issue_show', {projectId: issue.project.uuid, id: issue.uuid}) }}">{{ issue.title }}</a>
                                <div class="text-xs text-[var(--color-ink)]/55">{{ issue.culprit }}</div>
                                <span class="badge ml-0 mt-1 issue-badge--priority-{{ issue.priority.value }}">{{ ('issues.priority.' ~ issue.priority.value)|trans }}</span>
                            </td>
                            <td class="px-3 py-2 align-top">
                                <span class="badge {% if issue.level == 'error' or issue.level == 'fatal' %}badge-error{% else %}badge-warn{% endif %}">{{ issue.level }}</span>
                            </td>
                            <td class="px-3 py-2 align-top">{{ issue.status.value }}</td>
                            <td class="px-3 py-2 align-top {% if not issue.assignee %}text-[var(--color-ink)]/45{% endif %}">{{ assigneeLabel }}</td>
                            <td class="px-3 py-2 align-top whitespace-nowrap">{{ issue.lastSeen|date('Y-m-d H:i') }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endblock %}
{% endembed %}
{% endblock %}
