{% extends 'base.html.twig' %}

{% block title %}{{ 'assignments.title'|trans }} — {{ site_appearance.brandName }}{% endblock %}

{% block body %}
{% embed 'dashboard/_feed_layout.html.twig' with {
    title_key: 'assignments.title',
    intro_key: 'assignments.intro',
    filter_route: 'dashboard_assignments',
    filterForm: filterForm,
    filter_grid_class: 'sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4',
    filters: filters,
    filters_testid: 'assignments-filters',
    empty_testid: 'assignments-empty',
    empty_key: 'assignments.empty',
    results_testid: 'assignments-results',
    pagination: pagination,
    pagination_route: 'dashboard_assignments',
    filter_query: {
        scope: filters.scope,
        project: filters.project,
        q: filters.q,
        level: filters.level,
        status: filters.status,
        priority: filters.priority,
        assignee: filters.assignee,
        sort: filters.sort,
        dir: filters.dir,
        per_page: filters.per_page,
    },
    item_count: issues|length,
} %}
    {% block filter_fields %}
        {{ form_widget(filterForm.scope) }}
        {{ form_widget(filterForm.project) }}
        {{ form_widget(filterForm.q, {attr: {class: 'input', placeholder: 'issues.search_placeholder'|trans}}) }}
        {{ form_widget(filterForm.level) }}
        {{ form_widget(filterForm.status) }}
        {{ form_widget(filterForm.priority) }}
        {% set assigneeAttr = {class: 'input'} %}
        {% if filters.scope == 'mine' or filters.scope == 'unassigned' %}
            {% set assigneeAttr = assigneeAttr|merge({disabled: 'disabled'}) %}
        {% endif %}
        {{ form_widget(filterForm.assignee, {attr: assigneeAttr}) }}
        {{ form_widget(filterForm.per_page) }}
    {% endblock %}
    {% block results %}
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
                <thead>
                    <tr class="text-xs uppercase tracking-wide text-[var(--color-ink)]/55">
                        <th class="px-3 py-2">{{ 'assignments.col.project'|trans }}</th>
                        <th class="px-3 py-2">{{ 'issues.col.issue'|trans }}</th>
                        <th class="px-3 py-2">{{ 'issues.col.level'|trans }}</th>
                        <th class="px-3 py-2">{{ 'assignments.col.status'|trans }}</th>
                        <th class="px-3 py-2">{{ 'issues.col.assignee'|trans }}</th>
                        <th class="px-3 py-2">{{ 'issues.col.last_seen'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for issue in issues %}
                        {% set assigneeLabel = issue.assignee ? (issue.assignee.displayName ?: issue.assignee.email) : ('issues.assignee_unassigned'|trans) %}
                        <tr class="border-t border-[var(--color-sand)]/70">
                            <td class="px-3 py-2 align-top">
                                <a class="no-underline text-[var(--color-moss)] hover:underline" href="{{ path('project_show', {id: issue.project.uuid}) }}">{{ issue.project.name }}</a>
                            </td>
                            <td class="px-3 py-2 align-top">
                                <a class="font-medium no-underline hover:underline" href="{{ path('issue_show', {projectId: issue.project.uuid, id: issue.uuid}) }}">{{ issue.title }}</a>
                                <div class="text-xs text-[var(--color-ink)]/55">{{ issue.culprit }}</div>
                                <span class="badge ml-0 mt-1 issue-badge--priority-{{ issue.priority.value }}">{{ ('issues.priority.' ~ issue.priority.value)|trans }}</span>
                            </td>
                            <td class="px-3 py-2 align-top">
                                <span class="badge {% if issue.level == 'error' or issue.level == 'fatal' %}badge-error{% else %}badge-warn{% endif %}">{{ issue.level }}</span>
                            </td>
                            <td class="px-3 py-2 align-top">{{ issue.status.value }}</td>
                            <td class="px-3 py-2 align-top {% if not issue.assignee %}text-[var(--color-ink)]/45{% endif %}">{{ assigneeLabel }}</td>
                            <td class="px-3 py-2 align-top whitespace-nowrap">{{ issue.lastSeen|date('Y-m-d H:i') }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endblock %}
{% endembed %}
{% endblock %}
