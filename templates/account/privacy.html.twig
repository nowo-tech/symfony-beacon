{% extends 'base.html.twig' %}

{% block title %}{{ 'preferences.privacy.title'|trans }} — {{ site_appearance.brandName }}{% endblock %}

{% block body %}
<div class="mx-auto space-y-6">
    <div>
        <h1 class="mb-2 font-[family-name:var(--font-display)] text-3xl font-bold">{{ 'preferences.title'|trans }}</h1>
        <p class="text-sm text-[var(--color-ink)]/65">{{ 'preferences.intro'|trans }}</p>
    </div>

    {% include 'account/_area_nav.html.twig' %}
    {% include 'account/_profile_tabs.html.twig' %}

    <section class="panel space-y-4" data-testid="account-privacy-export" aria-labelledby="privacy-export-heading">
        <div>
            <h2 id="privacy-export-heading" class="text-lg font-semibold">{{ 'preferences.privacy.export_title'|trans }}</h2>
            <p class="mt-1 text-sm text-[var(--color-ink)]/65">{{ 'preferences.privacy.export_intro'|trans }}</p>
        </div>
        <p class="text-sm text-[var(--color-ink)]/70">{{ 'preferences.privacy.events_note'|trans }}</p>
        <p class="text-sm">
            <a class="no-underline" href="{{ path('legal_privacy') }}">{{ 'preferences.privacy.legal_link'|trans }}</a>
        </p>
        <a class="btn-primary no-underline" href="{{ path('account_privacy_export') }}" data-testid="account-privacy-export-btn">
            {{ 'preferences.privacy.export_button'|trans }}
        </a>
    </section>

    <section class="panel space-y-4" data-testid="account-privacy-anonymize" aria-labelledby="privacy-anonymize-heading">
        <div>
            <h2 id="privacy-anonymize-heading" class="text-lg font-semibold text-[var(--color-alert)]">{{ 'preferences.privacy.anonymize_title'|trans }}</h2>
            <p class="mt-1 text-sm text-[var(--color-ink)]/65">{{ 'preferences.privacy.anonymize_intro'|trans }}</p>
        </div>

        {% if profile_user.anonymized %}
            <p class="text-sm text-[var(--color-ink)]/70" data-testid="privacy-already-anonymized">{{ 'preferences.privacy.already_anonymized'|trans }}</p>
        {% elseif not can_anonymize %}
            <ul class="list-disc space-y-1 pl-5 text-sm text-[var(--color-ink)]/75">
                {% if is_last_admin %}
                    <li>{{ 'preferences.privacy.blocked_last_admin'|trans }}</li>
                {% endif %}
                {% for project in sole_owner_projects %}
                    <li>{{ 'preferences.privacy.blocked_sole_owner'|trans({'%name%': project.name}) }}</li>
                {% endfor %}
            </ul>
        {% else %}
            {% embed 'shared/_confirm_dialog.html.twig' with {
                expected_value: 'ANONYMIZE',
                trigger_class: 'btn-danger',
                trigger_label: 'preferences.privacy.anonymize_open'|trans,
                trigger_testid: 'account-privacy-anonymize-open',
                form_action: path('account_privacy_anonymize'),
                title: 'preferences.privacy.anonymize_confirm_title'|trans,
                title_id: 'privacy-anonymize-confirm-title',
                aria_labelledby: 'privacy-anonymize-confirm-title',
                header_wrapper: true,
                cancel_label: 'common.cancel'|trans,
                submit_label: 'preferences.privacy.anonymize_confirm'|trans,
                submit_class: 'btn-danger',
                submit_disabled: true,
                submit_testid: 'account-privacy-anonymize-submit',
            } %}
                {% block body %}
                    <p class="confirm-dialog__body">{{ 'preferences.privacy.anonymize_confirm_body'|trans }}</p>
                {% endblock %}
                {% block fields %}
                    <label class="confirm-dialog__label" for="privacy-anonymize-confirm-input">
                        {{ 'preferences.privacy.anonymize_type_label'|trans }}
                    </label>
                    <input
                        id="privacy-anonymize-confirm-input"
                        class="input w-full"
                        type="text"
                        autocomplete="off"
                        data-confirm-dialog-target="confirmInput"
                        required
                    >
                    <input type="hidden" name="_token" value="{{ csrf_token('account_privacy_anonymize') }}">
                {% endblock %}
            {% endembed %}
        {% endif %}
    </section>
</div>
{% endblock %}
