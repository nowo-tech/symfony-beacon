{% extends 'base.html.twig' %}

{% form_theme form with [
    'form/password_strength_beacon_theme.html.twig',
    'form/auth_kit_theme.html.twig'
] %}

{% block title %}{{ 'preferences.security.title'|trans }} — {{ site_appearance.brandName }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/toggle_password.css', 'nowo_password_toggle') }}">
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('password-strength.js', 'nowo_password_strength') }}" defer></script>
    {# Mirror generator “Use this password” into the confirm field (kit only fills the strength input). #}
    <script>
        document.addEventListener('click', (event) => {
            const target = event.target;
            if (!(target instanceof Element)) {
                return;
            }
            const item = target.closest('.password-strength-modal-item');
            if (!item) {
                return;
            }
            const useBtn = item.querySelector('button:last-of-type');
            if (!(useBtn instanceof HTMLElement) || target.closest('button') !== useBtn) {
                return;
            }
            window.requestAnimationFrame(() => {
                const input = document.querySelector('form[name="user_preferences"] input.password-strength-input');
                const confirm = document.querySelector('form[name="user_preferences"] input[name="user_preferences[plainPassword_confirm]"]');
                if (input instanceof HTMLInputElement && confirm instanceof HTMLInputElement && input.value !== '') {
                    confirm.value = input.value;
                    confirm.dispatchEvent(new Event('input', { bubbles: true }));
                    confirm.dispatchEvent(new Event('change', { bubbles: true }));
                }
            });
        });
    </script>
{% endblock %}

{% block body %}
<div class="mx-auto space-y-6">
    <div>
        <h1 class="mb-2 font-[family-name:var(--font-display)] text-3xl font-bold">{{ 'preferences.security.title'|trans }}</h1>
        <p class="text-sm text-[var(--color-ink)]/65">{{ 'preferences.security.intro'|trans }}</p>
    </div>

    {% include 'account/_area_nav.html.twig' %}
    {% include 'account/_security_tabs.html.twig' %}

    <section class="panel" data-testid="linked-social-accounts" aria-labelledby="linked-social-heading">
        <h2 id="linked-social-heading" class="mb-1 text-lg font-semibold">{{ 'preferences.security.social_title'|trans }}</h2>
        <p class="mb-4 text-sm text-[var(--color-ink)]/65">{{ 'preferences.security.social_intro'|trans }}</p>
        {% if not social_login_enabled %}
            <p class="text-sm text-[var(--color-ink)]/55">{{ 'preferences.security.social_disabled'|trans }}</p>
        {% elseif linked_social_accounts is empty %}
            <p class="text-sm text-[var(--color-ink)]/55">{{ 'preferences.security.social_empty'|trans }}</p>
        {% else %}
            <ul class="space-y-2 text-sm">
                {% for account in linked_social_accounts %}
                    <li class="flex flex-wrap items-baseline justify-between gap-2 border-b border-[var(--color-sand)] py-2 last:border-0" data-testid="linked-social-account">
                        <span class="font-medium">{{ account.provider|capitalize }}</span>
                        <span class="text-[var(--color-ink)]/60">{{ account.email|default(account.userIdentifier) }}</span>
                    </li>
                {% endfor %}
            </ul>
            <p class="mt-3 text-xs text-[var(--color-ink)]/55">{{ 'preferences.security.social_unlink_note'|trans }}</p>
        {% endif %}
    </section>

    {{ form_start(form, {attr: {class: 'panel space-y-4'}}) }}
        {{ form_row(form.currentPassword) }}
        {{ form_row(form.plainPassword) }}
        {{ form_row(form.plainPassword_confirm) }}
        <div class="border-t border-[var(--color-sand)] pt-4">
            <button class="btn-primary" type="submit">{{ 'preferences.security.submit'|trans }}</button>
        </div>
    {{ form_end(form) }}
</div>
{% endblock %}
