{% extends 'base.html.twig' %}

{% block title %}{{ 'preferences.display.tours_title'|trans }} — {{ site_appearance.brandName }}{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script defer src="{{ asset('/' ~ nowo_select_all_choice_asset_path('select-all-choice.js')) }}"></script>
{% endblock %}

{% block body %}
<div class="mx-auto space-y-6">
    <div>
        <h1 class="mb-2 font-[family-name:var(--font-display)] text-2xl font-semibold">{{ 'preferences.display.title'|trans }}</h1>
        <p class="mb-2 text-xs text-[var(--color-ink)]/55">{{ 'preferences.display.tours_intro'|trans }}</p>
    </div>

    {% include 'account/_area_nav.html.twig' %}
    {% include 'account/_display_tabs.html.twig' %}

    {{ form_start(form) }}
        <section class="panel space-y-5" aria-labelledby="display-tour-heading">
            <div>
                <h2 id="display-tour-heading" class="text-lg font-semibold text-[var(--color-ink)]">{{ 'preferences.product_tour_title'|trans }}</h2>
                <p class="mt-1 text-sm text-[var(--color-ink)]/65">{{ 'preferences.product_tour_intro'|trans }}</p>
            </div>

            <div class="space-y-3">
                {% include 'form/_fields.html.twig' with {form: form} only %}
                <p class="text-xs text-[var(--color-ink)]/55">{{ 'preferences.product_tour_save_hint'|trans }}</p>
            </div>

            <div class="flex flex-wrap gap-2 border-t border-[var(--color-sand)] pt-4">
                <button class="btn-primary" type="submit">{{ 'preferences.display.submit'|trans }}</button>
            </div>
        </section>
    {{ form_end(form) }}

    <section class="panel space-y-4" aria-labelledby="display-tour-replay-heading">
        <div>
            <h2 id="display-tour-replay-heading" class="text-lg font-semibold text-[var(--color-ink)]">{{ 'preferences.product_tour_replay_title'|trans }}</h2>
            <p class="mt-1 text-sm text-[var(--color-ink)]/65">{{ 'preferences.product_tour_replay_intro'|trans }}</p>
        </div>
        {{ form_start(replayForm, {action: path('account_product_tour_replay')}) }}
            <button type="submit" class="btn-ghost">{{ 'preferences.product_tour_replay'|trans }}</button>
        {{ form_end(replayForm) }}
    </section>
</div>
{% endblock %}
