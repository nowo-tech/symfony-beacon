{% extends 'base.html.twig' %}

{% block title %}{{ 'preferences.display.notifications_title'|trans }} — {{ site_appearance.brandName }}{% endblock %}

{% block body %}
<div class="mx-auto space-y-4">
    <div>
        <h1 class="mb-2 font-[family-name:var(--font-display)] text-2xl font-semibold">{{ 'preferences.display.title'|trans }}</h1>
        <p class="mb-2 text-xs text-[var(--color-ink)]/55">{{ 'preferences.display.notifications_intro'|trans }}</p>
    </div>

    {% include 'account/_area_nav.html.twig' %}
    {% include 'account/_display_tabs.html.twig' %}

    <section class="panel space-y-4" aria-labelledby="member-alerts-heading" data-testid="member-alerts-section">
        <div>
            <h2 id="member-alerts-heading" class="text-lg font-semibold text-[var(--color-ink)]">{{ 'preferences.member_alerts.title'|trans }}</h2>
            <p class="mt-1 text-sm text-[var(--color-ink)]/65">{{ 'preferences.member_alerts.intro'|trans }}</p>
        </div>

        {{ component('MemberAlertPreferencesLive', {
            initialFormData: member_alert_initial,
            pushAvailable: push_available,
            projects: member_alert_projects,
        }) }}
    </section>

    <section class="panel space-y-3" aria-labelledby="display-pwa-heading">
        <div>
            <h2 id="display-pwa-heading" class="text-lg font-semibold text-[var(--color-ink)]">{{ 'preferences.display.pwa_title'|trans }}</h2>
            <p class="mt-1 text-sm text-[var(--color-ink)]/65">{{ 'preferences.display.pwa_intro'|trans }}</p>
        </div>
        <div class="border-t border-[var(--color-sand)] pt-4 nowo-pwa-install-links-host">
            {{ nowo_pwa_install_links() }}
            {# Host hint (no Twig fork of kit install_links) — shown when neither install nor uninstall control is visible #}
            <p class="nowo-pwa-install-links__hint">{{ 'preferences.display.pwa_unavailable'|trans }}</p>
        </div>
    </section>
</div>
{% endblock %}
