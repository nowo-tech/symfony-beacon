{# Host override: UiKit table + icon-only archive row actions (panel POSTs via FormKit Types). #}
{% extends nowo_site_backup_panel_layout_template %}
{% import '@NowoUiKitBundle/macros/ui.html.twig' as ui %}
{% set _css_fw = nowo_site_backup_css_framework|default('tailwind') %}
{% set _display = nowo_ui_kit_row_actions_display|default('icon') %}
{% set _panel = path('nowo_site_backup_panel') %}
{% set _csrf_id = 'nowo_site_backup_panel' %}
{% set _csrf_field = '_csrf_token' %}

{% block nowo_ui_document_title %}Site Backup panel{% endblock %}

{% block nowo_site_backup_panel_content %}
<section class="nowo-ui-card card">
    <h2>Create backup</h2>
    {% set createBackupForm = csrf_action_form(
        _panel,
        _csrf_id,
        'POST',
        false,
        _csrf_field,
        {action: 'create', label: ''},
        {label: 'text'},
        {label: {
            label: 'Label',
            attr: {placeholder: 'pre-deploy', class: ui.input(_css_fw)},
        }}
    ) %}
    {{ form_start(createBackupForm, {attr: {class: 'nowo-ui-form'}}) }}
        {{ form_row(createBackupForm.label) }}
        <button type="submit" class="{{ ui.btn('primary', null, _css_fw) }}">Create integral backup</button>
    {{ form_end(createBackupForm) }}
</section>

<section class="nowo-ui-card card">
    <h2>Restore progress</h2>
    <p>Phase: <strong>{{ progress.phase }}</strong> — {{ progress.percent|number_format(1) }}%</p>
    <p>{{ progress.message }}</p>
    {% if progress.error %}<p class="{{ ui.flash('error', _css_fw) }}">{{ progress.error }}</p>{% endif %}
    {% if progress.phase in ['completed', 'failed'] %}
        {% set clearRestoreForm = csrf_action_form(
            _panel,
            _csrf_id,
            'POST',
            false,
            _csrf_field,
            {action: 'clear_restore'}
        ) %}
        {{ form_start(clearRestoreForm, {attr: {class: 'nowo-ui-form'}}) }}
            <button type="submit" class="{{ ui.btn('secondary', null, _css_fw) }}">Clear status</button>
        {{ form_end(clearRestoreForm) }}
    {% endif %}
</section>

<section class="nowo-ui-card card">
    <h2>Archives</h2>
    {% if backups is empty %}
        <p class="{{ ui.empty(_css_fw) }}">No backups yet.</p>
    {% else %}
        <div class="{{ ui.table_wrap(_css_fw) }}">
            <table class="{{ ui.table(_css_fw) }}">
                <thead>
                <tr><th>ID</th><th>Created</th><th>Size</th><th>Label</th><th>Actions</th></tr>
                </thead>
                <tbody>
                {% for b in backups %}
                    <tr>
                        <td><code>{{ b.id }}</code></td>
                        <td>{{ b.createdAt|date('Y-m-d H:i') }}</td>
                        <td>{{ b.sizeBytes }}</td>
                        <td>{{ b.label }}</td>
                        <td>
                            <div class="{{ ui.row_actions(_css_fw) }} nowo-ui-row-actions--{{ _display|replace({'_': '-'}) }}">
                                {% set verifyForm = csrf_action_form(
                                    _panel,
                                    _csrf_id,
                                    'POST',
                                    false,
                                    _csrf_field,
                                    {action: 'verify', backup_id: b.id}
                                ) %}
                                {{ form_start(verifyForm, {attr: {class: 'nowo-ui-row-actions__form'}}) }}
                                    <button type="submit" class="{{ ui.action('view', _css_fw) }}" title="Verify" aria-label="Verify">
                                        {% include '@NowoUiKitBundle/partials/_action_inner.html.twig' with {
                                            display: _display,
                                            icon_name: 'view',
                                            label: 'Verify'
                                        } only %}
                                    </button>
                                {{ form_end(verifyForm) }}
                                {% set restoreForm = csrf_action_form(
                                    _panel,
                                    _csrf_id,
                                    'POST',
                                    false,
                                    _csrf_field,
                                    {action: 'restore', backup_id: b.id}
                                ) %}
                                {{ form_start(restoreForm, {
                                    attr: {
                                        class: 'nowo-ui-row-actions__form',
                                        onsubmit: "return confirm('Restore this backup now? Visitors will see the loading page.');"
                                    }
                                }) }}
                                    <button type="submit" class="{{ ui.action('restore', _css_fw) }}" title="Restore" aria-label="Restore">
                                        {% include '@NowoUiKitBundle/partials/_action_inner.html.twig' with {
                                            display: _display,
                                            icon_name: 'restore',
                                            label: 'Restore'
                                        } only %}
                                    </button>
                                {{ form_end(restoreForm) }}
                                {% set deleteBackupForm = csrf_action_form(
                                    _panel,
                                    _csrf_id,
                                    'POST',
                                    false,
                                    _csrf_field,
                                    {action: 'delete', backup_id: b.id}
                                ) %}
                                {{ form_start(deleteBackupForm, {
                                    attr: {
                                        class: 'nowo-ui-row-actions__form',
                                        onsubmit: "return confirm('Delete backup?');"
                                    }
                                }) }}
                                    <button type="submit" class="{{ ui.action('delete', _css_fw) }}" title="Delete" aria-label="Delete">
                                        {% include '@NowoUiKitBundle/partials/_action_inner.html.twig' with {
                                            display: _display,
                                            icon_name: 'delete',
                                            label: 'Delete'
                                        } only %}
                                    </button>
                                {{ form_end(deleteBackupForm) }}
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</section>

{% set logoutForm = csrf_action_form(
    _panel,
    _csrf_id,
    'POST',
    false,
    _csrf_field,
    {action: 'logout'}
) %}
{{ form_start(logoutForm, {attr: {class: 'nowo-ui-form'}}) }}
    <button type="submit" class="{{ ui.btn('secondary', null, _css_fw) }}">Logout</button>
{{ form_end(logoutForm) }}
{% endblock %}
