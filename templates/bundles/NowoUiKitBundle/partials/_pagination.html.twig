{#
  Host override of UiKit pagination — Beacon pills + « / » + page numbers.

  Required:
    - pagination: {page, per_page, total, total_pages}
    - item_count
    - route (+ route_params) OR omit route to use the current request route

  Optional:
    - query
    - nav_label (translation key)
    - trans_domain (default messages) for showing/previous/next
    - nav_trans_domain (default = trans_domain) for aria-label
    - framework
#}
{% import '@NowoUiKitBundle/macros/ui.html.twig' as ui %}
{% set query = query|default({}) %}
{% set nav_label = nav_label|default('pagination.nav') %}
{% set framework = framework|default(null) %}
{% set trans_domain = trans_domain|default('messages') %}
{% set nav_trans_domain = nav_trans_domain|default(trans_domain) %}
{% set route = route|default(app.request.attributes.get('_route')) %}
{% set route_params = route_params|default(app.request.attributes.get('_route_params')|default({})) %}
{% set page = pagination.page|default(1) %}
{% set per_page = pagination.per_page|default(25) %}
{% set total = pagination.total|default(0) %}
{% set total_pages = pagination.total_pages|default(1) %}
{% if total_pages < 1 %}
    {% set total_pages = 1 %}
{% endif %}
{% if total > 0 %}
    {% set from = (page - 1) * per_page + 1 %}
    {% set to = (page - 1) * per_page + item_count %}
    {% set base_params = route_params|merge(query)|merge({per_page: per_page}) %}
    <div class="{{ ui.pagination_wrap(framework) }} table-pagination">
        <p class="nowo-ui-pagination__info table-pagination__info">
            {{ 'pagination.showing'|trans({'%from%': from, '%to%': to, '%total%': total}, trans_domain) }}
        </p>
        {% if total_pages > 1 %}
            <nav class="nowo-ui-pagination__nav table-pagination__nav" aria-label="{{ nav_label|trans({}, nav_trans_domain) }}">
                <ul class="pagination">
                    <li class="page-item{% if page <= 1 %} disabled{% endif %}">
                        {% if page > 1 %}
                            <a class="page-link nowo-ui-pagination__link table-pagination__link" href="{{ path(route, base_params|merge({page: page - 1})) }}" aria-label="{{ 'pagination.previous'|trans({}, trans_domain) }}">«</a>
                        {% else %}
                            <span class="page-link nowo-ui-pagination__link table-pagination__link is-disabled" aria-disabled="true" aria-label="{{ 'pagination.previous'|trans({}, trans_domain) }}">«</span>
                        {% endif %}
                    </li>

                    {% for p in 1..total_pages %}
                        {% if p == page %}
                            <li class="page-item active" aria-current="page">
                                <span class="page-link nowo-ui-pagination__link table-pagination__link is-active">{{ p }}</span>
                            </li>
                        {% elseif p == 1 or p == total_pages or (p >= page - 2 and p <= page + 2) %}
                            <li class="page-item">
                                <a class="page-link nowo-ui-pagination__link table-pagination__link" href="{{ path(route, base_params|merge({page: p})) }}">{{ p }}</a>
                            </li>
                        {% elseif p == page - 3 or p == page + 3 %}
                            <li class="page-item disabled" aria-hidden="true">
                                <span class="page-link nowo-ui-pagination__ellipsis table-pagination__ellipsis">…</span>
                            </li>
                        {% endif %}
                    {% endfor %}

                    <li class="page-item{% if page >= total_pages %} disabled{% endif %}">
                        {% if page < total_pages %}
                            <a class="page-link nowo-ui-pagination__link table-pagination__link" href="{{ path(route, base_params|merge({page: page + 1})) }}" aria-label="{{ 'pagination.next'|trans({}, trans_domain) }}">»</a>
                        {% else %}
                            <span class="page-link nowo-ui-pagination__link table-pagination__link is-disabled" aria-disabled="true" aria-label="{{ 'pagination.next'|trans({}, trans_domain) }}">»</span>
                        {% endif %}
                    </li>
                </ul>
            </nav>
        {% endif %}
    </div>
{% endif %}
