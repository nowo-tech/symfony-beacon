{# Host override: UiKit burger + Beacon sidebar toggle hooks (app.ts). #}
{% import '@NowoUiKitBundle/macros/ui.html.twig' as ui %}
{% set framework = framework|default(null) %}
{% set controls = controls|default('app-sidebar') %}
{% set expanded = expanded|default(true) %}
{% set label = label|default('nav.toggle_sidebar'|trans) %}
<button
    type="button"
    class="{{ ui.burger(framework) }} app-sidebar-toggle"
    data-nowo-ui-burger
    data-sidebar-toggle
    aria-controls="{{ controls }}"
    aria-expanded="{{ expanded ? 'true' : 'false' }}"
    aria-label="{{ label }}"
>
    <svg class="nowo-ui-burger__icon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M4 7h16M4 12h16M4 17h16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
    </svg>
</button>
