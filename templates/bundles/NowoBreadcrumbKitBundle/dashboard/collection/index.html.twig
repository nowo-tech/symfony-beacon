{# Host rewrite: Beacon Administration list chrome (Menus pattern).
   Row actions: btn-ghost/btn-danger + _action_inner (nowo_ui_kit.row_actions_display).
   Kit JS hooks (btn-bk-*, modal ids, data-bk-*) unchanged. #}
{% extends '@NowoBreadcrumbKitBundle/dashboard/base.html.twig' %}
{% trans_default_domain 'NowoBreadcrumbKitBundle' %}
{% import '@NowoUiKitBundle/macros/ui.html.twig' as ui %}
{% set _css_fw = nowo_breadcrumb_kit_css_framework|default('tailwind') %}
{% set _display = nowo_ui_kit_row_actions_display|default('icon') %}
{% set _index = dashboard_routes.index|default('nowo_breadcrumb_kit_dashboard_collections_index') %}

{% block dashboard_title %}{{ 'dashboard.collections_heading'|trans }}{% endblock %}
{% block title %}{{ 'dashboard.collections_heading'|trans }} — {{ site_appearance.brandName }}{% endblock %}

{% set kit_admin_header_actions %}
    <a
        href="{{ path(dashboard_routes.export_all|default('nowo_breadcrumb_kit_dashboard_export_all')) }}"
        class="btn-ghost no-underline"
        target="_blank"
        rel="noopener noreferrer"
    >{{ 'dashboard.export_all'|trans }}</a>
    <button
        type="button"
        class="btn-ghost btn-bk-import"
        {{ ui.modal_toggle_attrs(_css_fw)|raw }}
        {{ ui.modal_target_attr('modal-bk-import', _css_fw)|raw }}
        data-bk-import-url="{{ path(dashboard_routes.import|default('nowo_breadcrumb_kit_dashboard_import')) }}?_partial=1"
    >{{ 'dashboard.import'|trans }}</button>
    <button
        type="button"
        class="btn-primary btn-bk-collection-form"
        {{ ui.modal_toggle_attrs(_css_fw)|raw }}
        {{ ui.modal_target_attr('modal-bk-collection-form', _css_fw)|raw }}
        data-bk-url="{{ path(dashboard_routes.new|default('nowo_breadcrumb_kit_dashboard_collections_new')) }}?_partial=1"
        data-bk-title="{{ 'dashboard.new_collection_modal_title'|trans|e('html_attr') }}"
    >{{ 'dashboard.new_collection'|trans }}</button>
{% endset %}

{% block body %}
    {% set searchForm = search_query_form(path(_index), search, {
        class: 'input min-w-56 flex-1',
        placeholder: 'dashboard.search_placeholder'|trans,
        'aria-label': 'dashboard.search'|trans,
        autocomplete: 'off',
    }) %}
    {{ form_start(searchForm, {attr: {class: 'mb-4 flex flex-wrap gap-2', role: 'search'}}) }}
        {{ form_widget(searchForm.q) }}
        <button type="submit" class="btn-ghost">{{ 'dashboard.filter'|trans }}</button>
        <a href="{{ path(_index) }}" class="btn-ghost no-underline">{{ 'dashboard.clear_filters'|trans }}</a>
    {{ form_end(searchForm) }}

    <section class="panel overflow-x-auto" data-testid="breadcrumb-kit-collections-table">
        <table class="w-full text-left text-sm">
            <thead>
                <tr class="border-b border-[var(--color-sand)] text-[var(--color-ink)]/55">
                    <th class="px-2 py-2 font-medium">{{ 'dashboard.table_code'|trans }}</th>
                    <th class="px-2 py-2 font-medium">{{ 'dashboard.table_name'|trans }}</th>
                    <th class="px-2 py-2 font-medium">{{ 'dashboard.table_items'|trans }}</th>
                    <th class="px-2 py-2 font-medium">{{ 'dashboard.table_context'|trans }}</th>
                    <th class="min-w-[22rem] px-2 py-2 text-end font-medium whitespace-nowrap">{{ 'dashboard.table_actions'|trans }}</th>
                </tr>
            </thead>
            <tbody>
            {% for c in collections %}
                {% set _itemsCount = collection_item_counts[c.id]|default(0) %}
                {% set _label_items = 'dashboard.link_items'|trans %}
                {% set _label_export = 'dashboard.link_export_json'|trans %}
                {% set _label_edit = 'dashboard.link_edit'|trans %}
                {% set _label_delete = 'dashboard.delete'|trans %}
                <tr class="row-hover border-b border-[var(--color-sand)]/70 last:border-0">
                    <td class="px-2 py-3">
                        <a class="font-medium no-underline" href="{{ path('nowo_breadcrumb_kit_dashboard_items_index', {collectionId: c.id}) }}"><code>{{ c.code }}</code></a>
                    </td>
                    <td class="px-2 py-3 text-[var(--color-ink)]/75">{{ c.name|default('—') }}</td>
                    <td class="px-2 py-3">
                        <span class="badge bg-[var(--color-sand)] text-[var(--color-ink)]/75">{{ _itemsCount }}</span>
                    </td>
                    <td class="px-2 py-3 text-xs text-[var(--color-ink)]/55">{{ c.contextKey is not empty ? c.contextKey : '—' }}</td>
                    <td class="min-w-[22rem] px-2 py-3 text-end whitespace-nowrap">
                        <div class="inline-flex flex-nowrap items-center justify-end gap-1 nowo-ui-row-actions nowo-ui-row-actions--{{ _display|replace({'_': '-'}) }}" aria-label="{{ 'dashboard.table_actions'|trans }}">
                            <a
                                href="{{ path('nowo_breadcrumb_kit_dashboard_items_index', {collectionId: c.id}) }}"
                                class="btn-ghost {{ _display == 'icon' ? 'btn-icon' : 'btn-sm btn-label' }} no-underline"
                                title="{{ _label_items }}"
                                aria-label="{{ _label_items }}"
                            >
                                {% include '@NowoUiKitBundle/partials/_action_inner.html.twig' with {display: _display, icon_name: 'view', label: _label_items} only %}
                            </a>
                            <a
                                href="{{ path(dashboard_routes.export|default('nowo_breadcrumb_kit_dashboard_collections_export'), {id: c.id}) }}"
                                class="btn-ghost {{ _display == 'icon' ? 'btn-icon' : 'btn-sm btn-label' }} no-underline"
                                target="_blank"
                                rel="noopener noreferrer"
                                title="{{ _label_export }}"
                                aria-label="{{ _label_export }}"
                            >
                                {% include '@NowoUiKitBundle/partials/_action_inner.html.twig' with {display: _display, icon_name: 'export', label: _label_export} only %}
                            </a>
                            <button
                                type="button"
                                class="btn-ghost {{ _display == 'icon' ? 'btn-icon' : 'btn-sm btn-label' }} btn-bk-collection-form"
                                {{ ui.modal_toggle_attrs(_css_fw)|raw }}
                                {{ ui.modal_target_attr('modal-bk-collection-form', _css_fw)|raw }}
                                data-bk-url="{{ path(dashboard_routes.edit|default('nowo_breadcrumb_kit_dashboard_collections_edit'), {id: c.id}) }}?_partial=1"
                                data-bk-title="{{ 'dashboard.edit_collection_modal_title'|trans({'%code%': c.code})|e('html_attr') }}"
                                title="{{ _label_edit }}"
                                aria-label="{{ _label_edit }}"
                            >
                                {% include '@NowoUiKitBundle/partials/_action_inner.html.twig' with {display: _display, icon_name: 'edit', label: _label_edit} only %}
                            </button>
                            <button
                                type="button"
                                class="btn-danger {{ _display == 'icon' ? 'btn-icon' : 'btn-sm btn-label' }} btn-bk-delete"
                                data-id="{{ c.id }}"
                                data-name="{{ c.code }}{% if c.name %} — {{ c.name }}{% endif %}"
                                data-url="{{ path(dashboard_routes.delete|default('nowo_breadcrumb_kit_dashboard_collections_delete'), {id: c.id}) }}"
                                data-token="{{ csrf_token('delete_collection_' ~ c.id) }}"
                                {{ ui.modal_toggle_attrs(_css_fw)|raw }}
                                {{ ui.modal_target_attr('modal-bk-delete', _css_fw)|raw }}
                                title="{{ _label_delete }}"
                                aria-label="{{ _label_delete }}"
                            >
                                {% include '@NowoUiKitBundle/partials/_action_inner.html.twig' with {display: _display, icon_name: 'delete', label: _label_delete} only %}
                            </button>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td class="px-2 py-4 text-[var(--color-ink)]/55" colspan="5">{{ 'dashboard.empty_collections'|trans }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

        {% if pagination is not null and collections is not empty %}
            {% include 'kit/_pagination.html.twig' with {
                pagination: pagination,
                item_count: collections|length,
                route: _index,
                route_params: {},
                query: search is not empty ? {q: search} : {},
                nav_label: 'pagination.nav',
            } %}
        {% endif %}
    </section>
{% endblock %}

{% block dashboard_scripts %}
<script>
window.__breadcrumbKitDashboard = Object.assign({}, window.__breadcrumbKitDashboard || {}, { page: 'collections_index' });
</script>
{% endblock %}
