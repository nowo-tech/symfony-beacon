{% extends '@NowoBreadcrumbKitBundle/dashboard/base.html.twig' %}
{% trans_default_domain 'NowoBreadcrumbKitBundle' %}
{% import '@NowoBreadcrumbKitBundle/dashboard/_icons.html.twig' as bk_icon %}
{% import '@NowoUiKitBundle/macros/ui.html.twig' as ui %}

{% block title %}{{ 'dashboard.collections_heading'|trans }}{% endblock %}

{% block body %}
    <form method="get" action="{{ path(dashboard_routes.index|default('nowo_breadcrumb_kit_dashboard_collections_index')) }}" class="{{ ui.search_form() }}" role="search">
        <input type="search" name="q" value="{{ search|e('html_attr') }}" class="{{ ui.search_input() }}" placeholder="{{ 'dashboard.search_placeholder'|trans }}" aria-label="{{ 'dashboard.search'|trans }}" autocomplete="off">
        <button type="submit" class="{{ ui.btn('secondary') }}">{{ 'dashboard.filter'|trans }}</button>
        <a href="{{ path(dashboard_routes.index|default('nowo_breadcrumb_kit_dashboard_collections_index')) }}" class="{{ ui.btn('secondary') }}">{{ 'dashboard.clear_filters'|trans }}</a>
    </form>

    <div class="{{ ui.toolbar() }}">
        <a href="{{ path(dashboard_routes.export_all|default('nowo_breadcrumb_kit_dashboard_export_all')) }}" class="{{ ui.btn('secondary') }}" target="_blank" rel="noopener noreferrer">{{ 'dashboard.export_all'|trans }}</a>
        <button type="button" class="{{ ui.btn('secondary') }} btn-bk-import" {{ ui.modal_toggle_attrs()|raw }} {{ ui.modal_target_attr('modal-bk-import')|raw }} data-bk-import-url="{{ path(dashboard_routes.import|default('nowo_breadcrumb_kit_dashboard_import')) }}?_partial=1">{{ 'dashboard.import'|trans }}</button>
        <button type="button" class="{{ ui.btn('primary') }} btn-bk-collection-form" {{ ui.modal_toggle_attrs()|raw }} {{ ui.modal_target_attr('modal-bk-collection-form')|raw }} data-bk-url="{{ path(dashboard_routes.new|default('nowo_breadcrumb_kit_dashboard_collections_new')) }}?_partial=1" data-bk-title="{{ 'dashboard.new_collection_modal_title'|trans|e('html_attr') }}">{{ 'dashboard.new_collection'|trans }}</button>
    </div>

    {% if collections is empty %}
        <p class="{{ ui.empty() }}">{{ 'dashboard.empty_collections'|trans }}</p>
    {% else %}
        <ul class="{{ ui.list() }}">
            {% for c in collections %}
                <li class="{{ ui.list_item() }}">
                    <div>
                        <strong>{{ c.code }}</strong>
                        {% set _itemsCount = collection_item_counts[c.id]|default(0) %}
                        <span class="{{ ui.badge() }}" title="{{ _itemsCount }}">{{ _itemsCount }}</span>
                        {% if c.name %}<span class="{{ ui.muted() }}"> — {{ c.name }}</span>{% endif %}
                        {% if c.contextKey is not empty %}
                            <br><span class="small {{ ui.muted() }}">{{ 'dashboard.context'|trans }}: {{ c.contextKey }}</span>
                        {% endif %}
                    </div>
                    <div class="{{ ui.row_actions() }}">
                        <a href="{{ path('nowo_breadcrumb_kit_dashboard_items_index', {collectionId: c.id}) }}" class="{{ ui.action('view') }}" title="{{ 'dashboard.link_items'|trans }}" aria-label="{{ 'dashboard.link_items'|trans }}">{{ bk_icon.items() }}</a>
                        <a href="{{ path(dashboard_routes.export|default('nowo_breadcrumb_kit_dashboard_collections_export'), {id: c.id}) }}" class="{{ ui.action('view') }}" target="_blank" rel="noopener noreferrer" title="{{ 'dashboard.link_export_json'|trans }}" aria-label="{{ 'dashboard.link_export_json'|trans }}">{{ bk_icon.export_json() }}</a>
                        <button type="button" class="{{ ui.action('edit') }} btn-bk-collection-form" {{ ui.modal_toggle_attrs()|raw }} {{ ui.modal_target_attr('modal-bk-collection-form')|raw }} data-bk-url="{{ path(dashboard_routes.edit|default('nowo_breadcrumb_kit_dashboard_collections_edit'), {id: c.id}) }}?_partial=1" data-bk-title="{{ 'dashboard.edit_collection_modal_title'|trans({'%code%': c.code})|e('html_attr') }}" title="{{ 'dashboard.link_edit'|trans }}" aria-label="{{ 'dashboard.link_edit'|trans }}">{{ bk_icon.edit() }}</button>
                        <button type="button" class="{{ ui.action('delete') }} btn-bk-delete" data-id="{{ c.id }}" data-name="{{ c.code }}{% if c.name %} — {{ c.name }}{% endif %}" data-url="{{ path(dashboard_routes.delete|default('nowo_breadcrumb_kit_dashboard_collections_delete'), {id: c.id}) }}" data-token="{{ csrf_token('delete_collection_' ~ c.id) }}" {{ ui.modal_toggle_attrs()|raw }} {{ ui.modal_target_attr('modal-bk-delete')|raw }} title="{{ 'dashboard.delete'|trans }}" aria-label="{{ 'dashboard.delete'|trans }}">{{ bk_icon.trash() }}</button>
                    </div>
                </li>
            {% endfor %}
        </ul>
        {% if pagination is not null %}
            {% include 'kit/_pagination.html.twig' with {
                pagination: pagination,
                item_count: collections|length,
                route: dashboard_routes.index|default('nowo_breadcrumb_kit_dashboard_collections_index'),
                route_params: {},
                query: search is not empty ? {q: search} : {},
                nav_label: 'pagination.nav',
            } %}
        {% endif %}
    {% endif %}
{% endblock %}

{% block dashboard_scripts %}
<script>
window.__breadcrumbKitDashboard = Object.assign({}, window.__breadcrumbKitDashboard || {}, { page: 'collections_index' });
</script>
{% endblock %}
