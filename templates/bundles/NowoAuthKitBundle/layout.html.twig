{# AuthKit host layout — guest shell + brand chrome; vendor security pages fill auth_panel. #}
{% extends 'layouts/guest_shell.html.twig' %}

{% block guest_shell_width %}max-w-md{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/nowo-auth-kit.css', 'nowo_auth_kit') }}">
    <link rel="stylesheet" href="{{ asset('css/toggle_password.css', 'nowo_password_toggle') }}">
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('password-strength.js', 'nowo_password_strength') }}" defer></script>
    {{ parent() }}
{% endblock %}

{% block cookie_consent_extras %}
    {% if nowo_cookie_consent_should_render() %}
        {% include '@NowoCookieConsentBundle/cookie_consent_preferences_bubble.html.twig' %}
    {% endif %}
{% endblock %}

{% block body %}
    {% block auth_brand %}
        <div class="fade-up mb-8 text-center">
            <p class="mb-3 text-xs font-semibold uppercase tracking-[0.22em] text-[var(--color-moss)]">{{ site_appearance.brandEyebrow }}</p>
            {% include '_brand_mark.html.twig' with {tag: 'h1', size: 'hero'} %}
            <p class="mx-auto mt-2.5 max-w-sm text-sm leading-relaxed text-[var(--color-ink)]/65">
                {{ 'auth.tagline'|trans }}
            </p>
        </div>
    {% endblock %}
    {% block auth_panel %}{% endblock %}
{% endblock %}
