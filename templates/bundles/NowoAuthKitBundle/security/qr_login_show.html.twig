{% extends layout_template %}

{% block title %}{{ 'qr_login.show.title'|trans({}, 'NowoAuthKitBundle') }}{% endblock %}

{% block auth_panel %}
    {% set remaining_seconds = max(0, expires_at - 'now'|date('U')) %}
    {% set remaining_mins = (remaining_seconds // 60) %}
    {% set remaining_secs = remaining_seconds % 60 %}
    {% set remaining_label = '%d:%02d'|format(remaining_mins, remaining_secs) %}
<section class="nowo-auth-kit__panel nowo-auth-kit__panel--qr">
    <h1>{{ 'qr_login.show.heading'|trans({}, 'NowoAuthKitBundle') }}</h1>

    <div
        class="nowo-auth-kit__qr-challenge"
        data-controller="qr-login"
        data-qr-login-status-url-value="{{ path(status_route, auth_kit_route_params({id: challenge_id})) }}"
        data-qr-login-complete-url-value="{{ path(complete_route, auth_kit_route_params({id: challenge_id})) }}"
        data-qr-login-start-url-value="{{ path('nowo_auth_kit_qr_login_start', auth_kit_route_params()) }}"
        data-qr-login-poll-interval-value="{{ poll_interval_ms }}"
        data-qr-login-expires-at-value="{{ expires_at }}"
        data-qr-login-waiting-value="{{ 'qr_login.show.waiting'|trans({}, 'NowoAuthKitBundle') }}"
        data-qr-login-approved-value="{{ 'auth.qr_login.approved'|trans }}"
        data-qr-login-denied-value="{{ 'auth.qr_login.denied'|trans }}"
        data-qr-login-expired-value="{{ 'auth.qr_login.expired'|trans }}"
        data-qr-login-retry-value="{{ 'auth.qr_login.retry'|trans }}"
    >
        {% if qr_data_uri %}
            <img class="nowo-auth-kit__qr-image" src="{{ qr_data_uri }}" alt="{{ 'qr_login.show.qr_alt'|trans({}, 'NowoAuthKitBundle') }}" width="200" height="200">
        {% endif %}
        {# Always expose the approve URL (a11y + E2E dual-device); QR encodes the same payload. #}
        <p class="nowo-auth-kit__qr-url">
            <a href="{{ qr_payload }}" rel="noopener">{{ 'qr_login.show.open_on_phone'|trans({}, 'NowoAuthKitBundle') }}</a>
        </p>

        <p class="nowo-auth-kit__qr-code">
            {{ 'qr_login.show.code_label'|trans({}, 'NowoAuthKitBundle') }}
            <strong>{{ public_code }}</strong>
        </p>

        <p class="nowo-auth-kit__qr-status" data-qr-login-target="status" aria-live="polite">
            {{ 'qr_login.show.waiting'|trans({}, 'NowoAuthKitBundle') }}
        </p>

        <p class="nowo-auth-kit__qr-expires" data-qr-login-target="expiresRow">
            {{ 'qr_login.show.expires_label'|trans({}, 'NowoAuthKitBundle') }}
            {# AuthKit leaves <time> empty for host JS; seed a countdown so it is visible before Stimulus boots. #}
            <time datetime="{{ expires_at|date('c') }}" data-qr-login-target="countdown">{{ remaining_label }}</time>
        </p>

        <p class="nowo-auth-kit__qr-actions" data-qr-login-target="actions" hidden>
            <a class="nowo-auth-kit__qr-retry" data-qr-login-target="retry" href="{{ path('nowo_auth_kit_qr_login_start', auth_kit_route_params()) }}">
                {{ 'auth.qr_login.retry'|trans }}
            </a>
        </p>
    </div>

    <p class="nowo-auth-kit__footer">
        <a href="{{ path(login_route, auth_kit_route_params()) }}">{{ 'qr_login.show.back_to_login'|trans({}, 'NowoAuthKitBundle') }}</a>
    </p>
</section>
{% endblock %}
