{% extends layout_template %}

{% block title %}{{ 'reset.request.title'|trans({}, 'NowoAuthKitBundle') }}{% endblock %}

{% block auth_panel %}
{% if nowo_auth_kit_form_themes is defined and nowo_auth_kit_form_themes is not empty %}
{% form_theme reset_request_form with nowo_auth_kit_form_themes %}
{% else %}
{% form_theme reset_request_form '@NowoPasswordToggleBundle/Form/toggle_password_widget.html.twig' %}
{% endif %}
<section class="nowo-auth-kit__panel">
    {% block auth_panel_heading %}
    <h1>{{ 'reset.request.heading'|trans({}, 'NowoAuthKitBundle') }}</h1>
    {% endblock %}
    <p>{{ 'reset.request.help'|trans({}, 'NowoAuthKitBundle') }}</p>

    {{ form_start(reset_request_form) }}
        {% include 'form/_fields.html.twig' with {form: reset_request_form} only %}
        <button type="submit" class="{{ nowo_auth_kit_button_class|default('nowo-auth-kit__button') }}">{{ 'reset.request.submit'|trans({}, 'NowoAuthKitBundle') }}</button>
    {{ form_end(reset_request_form) }}

    <p class="nowo-auth-kit__footer">
        <a href="{{ path(login_route, auth_kit_route_params()) }}">{{ 'reset.request.back_to_login'|trans({}, 'NowoAuthKitBundle') }}</a>
    </p>
    <p class="nowo-auth-kit__footer">
        <a href="{{ path('nowo_auth_kit_reset_password_code', auth_kit_route_params()) }}">{{ 'reset.code.title'|trans({}, 'NowoAuthKitBundle') }}</a>
    </p>
</section>
{% endblock %}
