{% extends 'error/layout.html.twig' %}

{% block title %}404 — {{ 'error.404.title'|trans }}{% endblock %}

{% block error_illustration %}
<figure class="error-page__figure">
    <img
        class="error-page__img"
        src="{{ asset('illustrations/error-404.png') }}"
        width="1024"
        height="682"
        alt="{{ 'error.404.image_alt'|trans }}"
        decoding="async"
    >
</figure>
{% endblock %}

{% block error_title %}{{ 'error.404.title'|trans }}{% endblock %}
{% block error_lead %}{{ 'error.404.lead'|trans }}{% endblock %}
{% block error_hint %}{{ 'error.404.hint'|trans }}{% endblock %}
