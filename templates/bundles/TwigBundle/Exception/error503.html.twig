{% extends 'error/layout.html.twig' %}

{% block title %}503 — {{ 'error.503.title'|trans }}{% endblock %}

{% block error_illustration %}
<figure class="error-page__figure">
    <img
        class="error-page__img"
        src="{{ asset('illustrations/error-503.png') }}"
        width="1536"
        height="1024"
        alt="{{ 'error.503.image_alt'|trans }}"
        decoding="async"
    >
</figure>
{% endblock %}

{% block error_title %}{{ 'error.503.title'|trans }}{% endblock %}
{% block error_lead %}{{ 'error.503.lead'|trans }}{% endblock %}
{% block error_hint %}{{ 'error.503.hint'|trans }}{% endblock %}
