{# Host override: Issues/admin filter chrome — form_row loop (077 / 081). #}
{% trans_default_domain 'NowoHttpLogBundle' %}
{% set _td = 'NowoHttpLogBundle' %}
{% set _input = 'input w-full min-w-0' %}

{{ form_start(filterForm, {
    attr: {
        class: 'http-log-filters panel mb-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4',
        'data-testid': 'http-log-filters',
        role: 'search',
    },
}) }}
    {% for field in filterForm %}
        {% if not field.rendered and 'hidden' not in field.vars.block_prefixes %}
            {% set _label = field.vars.label is not same as(false) and field.vars.label
                ? field.vars.label|trans({}, _td)
                : field.vars.name %}
            {% set _is_choice = 'choice' in field.vars.block_prefixes %}
            {% set _attr = {
                class: _input,
                'aria-label': _label,
                title: _label,
            } %}
            {% if not _is_choice %}
                {% set _attr = _attr|merge({placeholder: _label}) %}
            {% endif %}
            {% if field.vars.name == 'q' %}
                {% set _attr = _attr|merge({autocomplete: 'off'}) %}
            {% endif %}
            {{ form_row(field, {
                label: false,
                help: false,
                attr: _attr,
                row_attr: {class: (field.vars.name == 'q' ? 'sm:col-span-2 ' : '') ~ 'flex flex-col gap-2'},
            }) }}
        {% endif %}
    {% endfor %}

    <div class="col-span-full flex flex-wrap items-center gap-2">
        <button type="submit" class="btn-ghost">{{ 'common.filter'|trans({}, 'messages') }}</button>
        <a class="btn-ghost no-underline" href="{{ path('nowo_http_log_admin_index') }}">{{ 'common.clear_filters'|trans({}, 'messages') }}</a>
    </div>
    {% include 'form/_fields.html.twig' with {form: filterForm} only %}
{{ form_end(filterForm, {render_rest: false}) }}
