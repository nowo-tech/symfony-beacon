{# Host override: UiKit table + icon row actions (nowo_ui_kit.row_actions_display). #}
{% extends nowo_http_log_layout_template|default('@NowoHttpLogBundle/layout.html.twig') %}
{% import '@NowoUiKitBundle/macros/ui.html.twig' as ui %}
{% set _css_fw = nowo_http_log_css_framework|default('tailwind') %}

{% block title %}{{ 'admin.index.title'|trans({}, 'NowoHttpLogBundle') }} — {{ parent() }}{% endblock %}

{% block nowo_ui_content %}
    {% include '@NowoHttpLogBundle/admin/_filter.html.twig' %}

    <div class="panel http-log-results" data-testid="http-log-results">
        <div class="{{ ui.toolbar(_css_fw) }} http-log-results__toolbar">
            <p class="http-log-results__summary nowo-ui-summary">{{ 'admin.index.total'|trans({'%count%': total}, 'NowoHttpLogBundle') }}</p>
            <div class="{{ ui.row_actions(_css_fw) }} http-log-results__actions">
                <form method="post" action="{{ path('nowo_http_log_admin_export') }}" class="http-log-results__action">
                    <input type="hidden" name="_token" value="{{ csrf_token('http_log_export') }}">
                    <input type="hidden" name="format" value="csv">
                    {% for key, value in criteria %}
                        <input type="hidden" name="{{ key }}" value="{{ value.timestamp is defined ? value|date('Y-m-d\\TH:i') : value }}">
                    {% endfor %}
                    <button type="submit" class="{{ ui.btn('secondary', null, _css_fw) }} nowo-ui-btn-export">{{ 'admin.action.export_csv'|trans({}, 'NowoHttpLogBundle') }}</button>
                </form>
                <form method="post" action="{{ path('nowo_http_log_admin_export') }}" class="http-log-results__action">
                    <input type="hidden" name="_token" value="{{ csrf_token('http_log_export') }}">
                    <input type="hidden" name="format" value="json">
                    {% for key, value in criteria %}
                        <input type="hidden" name="{{ key }}" value="{{ value.timestamp is defined ? value|date('Y-m-d\\TH:i') : value }}">
                    {% endfor %}
                    <button type="submit" class="{{ ui.btn('secondary', null, _css_fw) }} nowo-ui-btn-export">{{ 'admin.action.export_json'|trans({}, 'NowoHttpLogBundle') }}</button>
                </form>
                <form method="post" action="{{ path('nowo_http_log_admin_purge') }}" class="http-log-results__action"
                      onsubmit="return confirm('{{ 'admin.purge.confirm'|trans({}, 'NowoHttpLogBundle')|e('js') }}');">
                    <input type="hidden" name="_token" value="{{ csrf_token('http_log_purge') }}">
                    <button type="submit" class="{{ ui.btn('danger', null, _css_fw) }} nowo-ui-btn-purge">{{ 'admin.action.purge'|trans({}, 'NowoHttpLogBundle') }}</button>
                </form>
            </div>
        </div>

        <div class="{{ ui.table_wrap(_css_fw) }}">
            <table class="{{ ui.table(_css_fw) }}">
                <thead>
                    <tr>
                        <th>{{ 'admin.column.id'|trans({}, 'NowoHttpLogBundle') }}</th>
                        <th>{{ 'admin.column.created_at'|trans({}, 'NowoHttpLogBundle') }}</th>
                        <th>{{ 'admin.column.method'|trans({}, 'NowoHttpLogBundle') }}</th>
                        <th>{{ 'admin.column.path'|trans({}, 'NowoHttpLogBundle') }}</th>
                        <th>{{ 'admin.column.status'|trans({}, 'NowoHttpLogBundle') }}</th>
                        <th>{{ 'admin.column.duration'|trans({}, 'NowoHttpLogBundle') }}</th>
                        <th>{{ 'admin.column.client_ip'|trans({}, 'NowoHttpLogBundle') }}</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for entry in entries %}
                        <tr>
                            <td>{{ entry.id }}</td>
                            <td>{{ entry.createdAt|date('Y-m-d H:i:s') }}</td>
                            <td><span class="{{ ui.badge(null, _css_fw) }}">{{ entry.method }}</span></td>
                            <td class="text-truncate" title="{{ entry.path }}">{{ entry.path }}</td>
                            <td>{{ entry.statusCode }}</td>
                            <td>{{ entry.durationMs|number_format(1) }} ms</td>
                            <td>{{ entry.clientIp }}</td>
                            <td>
                                {% include '@NowoUiKitBundle/partials/_row_actions.html.twig' with {
                                    framework: _css_fw,
                                    actions: [
                                        {
                                            kind: 'view',
                                            href: path('nowo_http_log_admin_show', {id: entry.id}),
                                            label: 'admin.action.view'|trans({}, 'NowoHttpLogBundle')
                                        }
                                    ]
                                } %}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="8" class="{{ ui.muted(_css_fw) }}">{{ 'admin.index.empty'|trans({}, 'NowoHttpLogBundle') }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {% set totalPages = total > 0 ? (total / pageSize)|round(0, 'ceil') : 1 %}
        {% set httpLogQuery = {} %}
        {% for key, value in criteria %}
            {% set httpLogQuery = httpLogQuery|merge({
                (key): value.timestamp is defined ? value|date('Y-m-d\\TH:i') : value
            }) %}
        {% endfor %}
        {% include 'kit/_pagination.html.twig' with {
            page: page,
            pages: totalPages,
            total: total,
            page_size: pageSize,
            item_count: entries|length,
            route: 'nowo_http_log_admin_index',
            route_params: {},
            query: httpLogQuery,
            nav_label: 'admin.index.title',
            trans_domain: 'messages',
            nav_trans_domain: 'NowoHttpLogBundle',
            framework: _css_fw,
        } %}
    </div>
{% endblock %}
