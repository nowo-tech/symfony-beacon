{# Host rewrite: Beacon Administration list chrome (Menus pattern).
   Row actions: btn-ghost + _action_inner (nowo_ui_kit.row_actions_display). #}
{% extends nowo_http_log_layout_template|default('@NowoHttpLogBundle/layout.html.twig') %}
{% set _css_fw = nowo_http_log_css_framework|default('tailwind') %}
{% set _td = 'NowoHttpLogBundle' %}
{% set _display = nowo_ui_kit_row_actions_display|default('icon') %}

{% block title %}{{ 'admin.index.title'|trans({}, _td) }} — {{ parent() }}{% endblock %}

{% set kit_admin_header_actions %}
    <div class="http-log-results__actions inline-flex flex-wrap items-center gap-2">
        {% set exportCriteriaFields = {} %}
        {% for key, value in criteria %}
            {% set exportCriteriaFields = exportCriteriaFields|merge({
                (key): value.timestamp is defined ? value|date('Y-m-d\\TH:i') : value
            }) %}
        {% endfor %}
        {% set exportCsvForm = csrf_action_form(
            path('nowo_http_log_admin_export'),
            'http_log_export',
            'POST',
            false,
            '_token',
            exportCriteriaFields|merge({format: 'csv'})
        ) %}
        {{ form_start(exportCsvForm, {attr: {class: 'inline'}}) }}
            <button type="submit" class="btn-ghost nowo-ui-btn-export">{{ 'admin.action.export_csv'|trans({}, _td) }}</button>
        {{ form_end(exportCsvForm) }}
        {% set exportJsonForm = csrf_action_form(
            path('nowo_http_log_admin_export'),
            'http_log_export',
            'POST',
            false,
            '_token',
            exportCriteriaFields|merge({format: 'json'})
        ) %}
        {{ form_start(exportJsonForm, {attr: {class: 'inline'}}) }}
            <button type="submit" class="btn-ghost nowo-ui-btn-export">{{ 'admin.action.export_json'|trans({}, _td) }}</button>
        {{ form_end(exportJsonForm) }}
        {% set purgeForm = csrf_action_form(path('nowo_http_log_admin_purge'), 'http_log_purge', 'POST', false) %}
        {{ form_start(purgeForm, {
            attr: {
                class: 'inline',
                onsubmit: "return confirm('" ~ 'admin.purge.confirm'|trans({}, _td)|e('js') ~ "');",
            },
        }) }}
            <button type="submit" class="btn-danger nowo-ui-btn-purge">{{ 'admin.action.purge'|trans({}, _td) }}</button>
        {{ form_end(purgeForm) }}
    </div>
{% endset %}

{% block nowo_ui_content %}
    {% include '@NowoHttpLogBundle/admin/_filter.html.twig' %}

    <section class="panel overflow-x-auto http-log-results" data-testid="http-log-results">
        <p class="mb-3 text-sm text-[var(--color-ink)]/70">{{ 'admin.index.total'|trans({'%count%': total}, _td) }}</p>

        <table class="w-full text-left text-sm">
            <thead>
                <tr class="border-b border-[var(--color-sand)] text-[var(--color-ink)]/55">
                    <th class="px-2 py-2 font-medium">{{ 'admin.column.id'|trans({}, _td) }}</th>
                    <th class="px-2 py-2 font-medium">{{ 'admin.column.created_at'|trans({}, _td) }}</th>
                    <th class="px-2 py-2 font-medium">{{ 'admin.column.method'|trans({}, _td) }}</th>
                    <th class="px-2 py-2 font-medium">{{ 'admin.column.path'|trans({}, _td) }}</th>
                    <th class="px-2 py-2 font-medium">{{ 'admin.column.status'|trans({}, _td) }}</th>
                    <th class="px-2 py-2 font-medium">{{ 'admin.column.duration'|trans({}, _td) }}</th>
                    <th class="px-2 py-2 font-medium">{{ 'admin.column.client_ip'|trans({}, _td) }}</th>
                    <th class="w-0 px-2 py-2 text-end font-medium whitespace-nowrap"><span class="visually-hidden">{{ 'admin.action.view'|trans({}, _td) }}</span></th>
                </tr>
            </thead>
            <tbody>
                {% for entry in entries %}
                    {% set _label_view = 'admin.action.view'|trans({}, _td) %}
                    <tr class="row-hover border-b border-[var(--color-sand)]/70 last:border-0">
                        <td class="px-2 py-3">{{ entry.id }}</td>
                        <td class="px-2 py-3 text-[var(--color-ink)]/75">{{ entry.createdAt|date('Y-m-d H:i:s') }}</td>
                        <td class="px-2 py-3">
                            <span class="badge bg-[var(--color-sand)] text-[var(--color-ink)]/75">{{ entry.method }}</span>
                        </td>
                        <td class="max-w-xs truncate px-2 py-3" title="{{ entry.path }}">{{ entry.path }}</td>
                        <td class="px-2 py-3">{{ entry.statusCode }}</td>
                        <td class="px-2 py-3 text-[var(--color-ink)]/75">{{ entry.durationMs|number_format(1) }} ms</td>
                        <td class="px-2 py-3 text-[var(--color-ink)]/75">{{ entry.clientIp }}</td>
                        <td class="w-0 px-2 py-3 text-end whitespace-nowrap">
                            <div class="inline-flex max-w-full items-center justify-end gap-1 {{ _display == 'icon' ? '' : 'flex-wrap' }} nowo-ui-row-actions nowo-ui-row-actions--{{ _display|replace({'_': '-'}) }}">
                                <a
                                    href="{{ path('nowo_http_log_admin_show', {id: entry.id}) }}"
                                    class="btn-ghost {{ _display == 'icon' ? 'btn-icon' : 'btn-sm btn-label' }} no-underline"
                                    title="{{ _label_view }}"
                                    aria-label="{{ _label_view }}"
                                >
                                    {% include '@NowoUiKitBundle/partials/_action_inner.html.twig' with {display: _display, icon_name: 'view', label: _label_view} only %}
                                </a>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td class="px-2 py-4 text-[var(--color-ink)]/55" colspan="8">{{ 'admin.index.empty'|trans({}, _td) }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>

        {% set totalPages = total > 0 ? (total / pageSize)|round(0, 'ceil') : 1 %}
        {% set httpLogQuery = {} %}
        {% for key, value in criteria %}
            {% set httpLogQuery = httpLogQuery|merge({
                (key): value.timestamp is defined ? value|date('Y-m-d\\TH:i') : value
            }) %}
        {% endfor %}
        {% include 'kit/_pagination.html.twig' with {
            page: page,
            pages: totalPages,
            total: total,
            page_size: pageSize,
            item_count: entries|length,
            route: 'nowo_http_log_admin_index',
            route_params: {},
            query: httpLogQuery,
            nav_label: 'admin.index.title',
            trans_domain: 'messages',
            nav_trans_domain: _td,
            framework: _css_fw,
        } %}
    </section>
{% endblock %}
