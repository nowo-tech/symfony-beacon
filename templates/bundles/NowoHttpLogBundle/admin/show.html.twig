{# Host rewrite: Beacon Administration detail chrome (Menus pattern). #}
{% extends nowo_http_log_layout_template|default('@NowoHttpLogBundle/layout.html.twig') %}
{% set _td = 'NowoHttpLogBundle' %}

{% block title %}{{ 'admin.show.title'|trans({'%id%': entry.id}, _td) }} — {{ parent() }}{% endblock %}

{% set kit_admin_header_actions %}
    <a class="btn-ghost no-underline" href="{{ path('nowo_http_log_admin_index') }}">&larr; {{ 'admin.action.back'|trans({}, _td) }}</a>
{% endset %}

{% block nowo_ui_content %}
    <section class="panel http-log-show" data-testid="http-log-show">
        <dl class="http-log-details">
            <dt>{{ 'admin.column.id'|trans({}, _td) }}</dt>
            <dd>{{ entry.id }}</dd>

            <dt>{{ 'admin.field.request_id'|trans({}, _td) }}</dt>
            <dd><code>{{ entry.requestId }}</code></dd>

            <dt>{{ 'admin.column.created_at'|trans({}, _td) }}</dt>
            <dd>{{ entry.createdAt|date('Y-m-d H:i:s') }}</dd>

            <dt>{{ 'admin.column.method'|trans({}, _td) }}</dt>
            <dd>{{ entry.method }}</dd>

            <dt>{{ 'admin.field.url'|trans({}, _td) }}</dt>
            <dd><code>{{ entry.scheme }}://{{ entry.host }}{{ entry.path }}</code></dd>

            <dt>{{ 'admin.field.route'|trans({}, _td) }}</dt>
            <dd>{{ entry.routeName }}</dd>

            <dt>{{ 'admin.column.status'|trans({}, _td) }}</dt>
            <dd>{{ entry.statusCode }}</dd>

            <dt>{{ 'admin.column.duration'|trans({}, _td) }}</dt>
            <dd>{{ entry.durationMs|number_format(2) }} ms</dd>

            <dt>{{ 'admin.column.client_ip'|trans({}, _td) }}</dt>
            <dd>{{ entry.clientIp }}</dd>

            <dt>{{ 'admin.field.user'|trans({}, _td) }}</dt>
            <dd>{{ entry.userIdentifier }}</dd>

            <dt>{{ 'admin.field.content_type'|trans({}, _td) }}</dt>
            <dd>{{ entry.contentType }} ({{ entry.bodyContentType }})</dd>
        </dl>

        {% if entry.queryParams %}
            <h2 class="nowo-ui-section-title">{{ 'admin.field.query_params'|trans({}, _td) }}</h2>
            <pre class="nowo-ui-code">{{ entry.queryParams|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
        {% endif %}

        {% if entry.requestHeaders %}
            <h2 class="nowo-ui-section-title">{{ 'admin.field.request_headers'|trans({}, _td) }}</h2>
            <pre class="nowo-ui-code">{{ entry.requestHeaders|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
        {% endif %}

        {% if entry.responseHeaders %}
            <h2 class="nowo-ui-section-title">{{ 'admin.field.response_headers'|trans({}, _td) }}</h2>
            <pre class="nowo-ui-code">{{ entry.responseHeaders|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
        {% endif %}

        {% if entry.requestBody %}
            <h2 class="nowo-ui-section-title">{{ 'admin.field.request_body'|trans({}, _td) }}{% if entry.requestBodyTruncated %} ({{ 'admin.field.truncated'|trans({}, _td) }}){% endif %}</h2>
            <pre class="nowo-ui-code">{{ entry.requestBody }}</pre>
        {% endif %}

        {% if entry.responseBody %}
            <h2 class="nowo-ui-section-title">{{ 'admin.field.response_body'|trans({}, _td) }}{% if entry.responseBodyTruncated %} ({{ 'admin.field.truncated'|trans({}, _td) }}){% endif %}</h2>
            <pre class="nowo-ui-code">{{ entry.responseBody }}</pre>
        {% endif %}

        {% set deleteForm = csrf_action_form(path('nowo_http_log_admin_delete', {id: entry.id}), 'http_log_delete', 'POST', false) %}
        {{ form_start(deleteForm, {
            attr: {
                class: 'mt-4',
                onsubmit: "return confirm('" ~ 'admin.delete.confirm'|trans({}, _td)|e('js') ~ "');",
            },
        }) }}
            <button type="submit" class="btn-danger">{{ 'admin.action.delete'|trans({}, _td) }}</button>
        {{ form_end(deleteForm) }}
    </section>
{% endblock %}
