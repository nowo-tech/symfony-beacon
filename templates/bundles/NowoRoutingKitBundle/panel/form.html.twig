{# Host rewrite: Beacon kit form chrome (Menus / Administration pattern). #}
{% extends '@NowoRoutingKitBundle/panel/base.html.twig' %}
{% set _is_edit = definition and definition.id %}
{% set _td = 'NowoRoutingKitBundle' %}

{% block title %}{{ (_is_edit ? 'panel.edit_title' : 'panel.create_title')|trans({}, _td) }} — {{ site_appearance.brandName }}{% endblock %}

{% set kit_admin_header_actions %}
    <a class="btn-ghost no-underline" href="{{ path_prefix }}/">&larr; {{ 'panel.title'|trans({}, _td) }}</a>
{% endset %}

{% block body %}
    <section class="panel" data-testid="routing-kit-definition-form">
        <h2 class="mb-1 text-base font-semibold">{{ (_is_edit ? 'panel.edit_title' : 'panel.create_title')|trans({}, _td) }}</h2>
        <p class="mb-4 text-sm text-[var(--color-ink)]/55">{{ 'panel.form_hint'|trans({}, _td) }}</p>

        {% if errors %}
            <div class="mb-4 rounded-md border border-[var(--color-alert)]/30 bg-[var(--color-alert)]/10 px-3 py-2 text-sm text-[var(--color-alert)]" role="alert">
                {% for error in errors %}<div>{{ error }}</div>{% endfor %}
            </div>
        {% endif %}
        {% if conflicts %}
            <div class="mb-4 rounded-md border border-[var(--color-alert)]/30 bg-[var(--color-alert)]/10 px-3 py-2 text-sm text-[var(--color-alert)]" role="alert">
                {% for conflict in conflicts %}<div>{{ conflict }}</div>{% endfor %}
            </div>
        {% endif %}

        {{ form_start(form, {attr: {class: 'nowo-ui-form nowo-ui-form--stack'}}) }}
            {% for child in form %}
                {% if not child.rendered %}
                    {{ form_row(child) }}
                {% endif %}
            {% endfor %}
            <div class="mt-4 flex flex-wrap items-center gap-2">
                <button type="submit" class="btn-primary">{{ 'panel.save'|trans({}, _td) }}</button>
                <a class="btn-ghost no-underline" href="{{ path_prefix }}/">{{ 'panel.cancel'|trans({}, _td) }}</a>
            </div>
        {{ form_end(form) }}
    </section>
{% endblock %}
