{% extends '@NowoPasswordStrengthBundle/Form/password_strength_theme_tailwind2.html.twig' %}

{# Beacon has no Bootstrap button classes — use the app ghost control. #}
{% block password_strength_generate_button_class %}btn-ghost{% endblock %}

{% block password_strength_widget %}
{# Field label/help/placeholder use FormKit form domain; kit UI copy stays on the bundle. #}
{% set trans_domain = 'NowoPasswordStrengthBundle' %}
{% set feedback_position = form.vars.feedback_position|default('below') %}
{% set show_requirements = form.vars.show_requirements|default(true) %}
{% set requirements = form.vars.requirements|default([]) %}
{% set generator_mode = form.vars.generator_mode|default('off') %}
{% set generator_count = form.vars.generator_count|default(3) %}
{% set use_password_toggle = form.vars.use_password_toggle|default(false) %}
{% set toggle_active = use_password_toggle and password_toggle_parent|default(false) and (toggle|default(true)) %}
{% set labels = {
    'requirement.min_length': 'requirement.min_length'|trans({'%count%': form.vars.conditions.min_length|default(0)}, trans_domain),
    'requirement.max_length': 'requirement.max_length'|trans({'%count%': form.vars.conditions.max_length|default(0)}, trans_domain),
    'requirement.lowercase': 'requirement.lowercase'|trans({}, trans_domain),
    'requirement.uppercase': 'requirement.uppercase'|trans({}, trans_domain),
    'requirement.digit': 'requirement.digit'|trans({}, trans_domain),
    'requirement.special': 'requirement.special'|trans({}, trans_domain),
    'requirement.no_whitespace': 'requirement.no_whitespace'|trans({}, trans_domain),
    'requirement.not_contain': 'requirement.not_contain'|trans({}, trans_domain),
    'requirement.min_unique_chars': 'requirement.min_unique_chars'|trans({'%count%': form.vars.conditions.min_unique_chars|default(0)}, trans_domain),
    'requirement.regex': 'requirement.regex'|trans({}, trans_domain),
    'generator.button': 'generator.button'|trans({}, trans_domain),
    'generator.modal_title': 'generator.modal_title'|trans({}, trans_domain),
    'generator.modal_hint': 'generator.modal_hint'|trans({}, trans_domain),
    'generator.copy': 'generator.copy'|trans({}, trans_domain),
    'generator.copied': 'generator.copied'|trans({}, trans_domain),
    'generator.use_password': 'generator.use_password'|trans({}, trans_domain),
    'generator.close': 'generator.close'|trans({}, trans_domain),
    'generator.failed': 'generator.failed'|trans({}, trans_domain),
} %}
{% set attr = attr|merge({
    'data-password-strength-labels-value': labels|json_encode,
    'class': (attr.class|default('') ~ ' password-strength-widget')|trim,
    'data-password-strength-enhanced': '0',
    'data-password-strength-generator-mode': generator_mode,
    'data-password-strength-generator-count': generator_count,
    'data-password-strength-toggle': toggle_active ? '1' : '0',
    'data-password-strength-toggle-visible-label': toggle_active ? visible_label|default('Show') : '',
    'data-password-strength-toggle-hidden-label': toggle_active ? hidden_label|default('Hide') : '',
}) %}
<div class="password-strength-field" data-password-strength-field>
    {% if show_requirements and feedback_position == 'above' %}
        {{ block('password_strength_feedback') }}
    {% endif %}
    <div class="password-strength-input-row {{ toggle_active ? 'password-strength-input-row--toggle' : '' }}">
        <div class="password-strength-input-grow">
            {% if toggle_active %}
                {{ block('toggle_password_widget') }}
            {% else %}
                <input type="password" {{ block('widget_attributes') }} {% if value is not empty %}value="{{ value }}" {% endif %}/>
            {% endif %}
        </div>
        {% if generator_mode != 'off' %}
            <button type="button"
                    class="password-strength-generate-btn {{ block('password_strength_generate_button_class') }}"
                    data-password-strength-generate
                    aria-label="{{ 'generator.button'|trans({}, trans_domain) }}">
                {{ 'generator.button'|trans({}, trans_domain) }}
            </button>
        {% endif %}
    </div>
    {% if show_requirements and feedback_position == 'below' %}
        {{ block('password_strength_feedback') }}
    {% endif %}
</div>
{% endblock %}
