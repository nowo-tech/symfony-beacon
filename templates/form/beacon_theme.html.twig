{% use "form_div_layout.html.twig" %}
{% use "form/_toggle_password_csp.html.twig" %}

{%- block form_row -%}
    <div class="{{ row_attr.class|default('flex flex-col gap-2') }}">
        {{- form_label(form) -}}
        {{- form_widget(form) -}}
        {{- form_errors(form) -}}
        {{- form_help(form) -}}
    </div>
{%- endblock form_row -%}

{%- block form_label -%}
    {% if label is not same as(false) -%}
        {% set label_attr = label_attr|merge({class: (label_attr.class|default('') ~ ' block text-sm font-medium text-[var(--color-ink)]/85')|trim}) %}
        {{- parent() -}}
    {%- endif -%}
{%- endblock form_label -%}

{%- block form_widget_simple -%}
    {% set type = type|default('text') %}
    {% if type == 'hidden' %}
        {{- parent() -}}
    {% elseif type == 'color' %}
        {% set attr = attr|merge({class: (attr.class|default('') ~ ' input-color')|trim}) %}
        {{- parent() -}}
    {% else %}
        {% set attr = attr|merge({class: (attr.class|default('') ~ ' input')|trim}) %}
        {{- parent() -}}
    {% endif %}
{%- endblock form_widget_simple -%}

{%- block toggle_password_widget -%}
    {% set attr = attr|merge({class: (attr.class|default('') ~ ' input')|trim}) %}
    {{- parent() -}}
{%- endblock toggle_password_widget -%}

{%- block textarea_widget -%}
    {% set attr = attr|merge({class: (attr.class|default('') ~ ' input')|trim}) %}
    {{- parent() -}}
{%- endblock textarea_widget -%}

{%- block choice_widget_collapsed -%}
    {% set attr = attr|merge({class: (attr.class|default('') ~ ' input')|trim}) %}
    {{- parent() -}}
{%- endblock choice_widget_collapsed -%}

{#- Expanded multi/single choice: keep checkbox and label on one row (form_div_layout emits naked siblings). -#}
{%- block choice_widget_expanded -%}
    {%- set attr = attr|merge({
        class: (attr.class|default('') ~ ' flex flex-col gap-2.5 rounded-md border border-[var(--color-sand)]/80 bg-[var(--color-sand)]/10 p-3')|trim,
    }) -%}
    <div {{ block('widget_container_attributes') }}>
        {%- for child in form %}
            {%- set choice_label = child.vars.label -%}
            <label class="checkbox-label">
                {{- form_widget(child, {
                    attr: {
                        class: 'checkbox',
                    },
                }) -}}
                {%- if choice_label is not same as(false) -%}
                    <span class="leading-snug">
                        {{- choice_label|trans({}, choice_translation_domain) -}}
                    </span>
                {%- endif -%}
            </label>
        {%- endfor -%}
    </div>
{%- endblock choice_widget_expanded -%}

{%- block checkbox_row -%}
    <div class="{{ row_attr.class|default('flex flex-col gap-2') }}">
        <label class="checkbox-label checkbox-label--start">
            {{- form_widget(form, {
                attr: {
                    class: (attr.class|default('') ~ ' checkbox')|trim,
                },
            }) -}}
            <span class="min-w-0">
                {%- if label is not same as(false) -%}
                    <span class="block font-medium text-[var(--color-ink)]/85">
                        {{- label|trans({}, translation_domain) -}}
                    </span>
                {%- endif -%}
                {{- form_help(form) -}}
            </span>
        </label>
        {{- form_errors(form) -}}
    </div>
{%- endblock checkbox_row -%}

{%- block checkbox_widget -%}
    {%- if 'pref-switch__input' in (attr.class|default('')) -%}
        {%- set attr = attr|merge({class: attr.class|default('')|trim}) -%}
    {%- else -%}
        {%- set attr = attr|merge({class: (attr.class|default('') ~ ' checkbox')|trim}) -%}
    {%- endif -%}
    {{- parent() -}}
{%- endblock checkbox_widget -%}

{%- block form_errors -%}
    {%- if errors|length > 0 -%}
        <ul class="list-none space-y-1 text-sm text-[var(--color-alert)]">
            {%- for error in errors -%}
                <li>{{ error.message }}</li>
            {%- endfor -%}
        </ul>
    {%- endif -%}
{%- endblock form_errors -%}

{%- block form_help -%}
    {%- if help is not empty -%}
        {%- set help_attr = help_attr|merge({class: (help_attr.class|default('') ~ ' text-xs text-[var(--color-ink)]/55')|trim}) -%}
        {{- parent() -}}
    {%- endif -%}
{%- endblock form_help -%}
