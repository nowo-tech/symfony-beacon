{% use "form_div_layout.html.twig" %}
{% use "form/_toggle_password_csp.html.twig" %}

{%- block form_row -%}
    <div class="{{ row_attr.class|default('flex flex-col gap-2') }}">
        {{- form_label(form) -}}
        {{- form_widget(form) -}}
        {{- form_errors(form) -}}
        {{- form_help(form) -}}
    </div>
{%- endblock form_row -%}

{#- Hidden fields: no row chrome (keeps CSS grids / filter layouts clean). -#}
{%- block hidden_row -%}
    {{- form_widget(form) -}}
{%- endblock hidden_row -%}

{#- Color inputs: swatch + live hex readout (settings appearance). -#}
{%- block color_row -%}
    <div class="{{ row_attr.class|default('flex flex-col gap-2') }}">
        {{- form_label(form) -}}
        <div class="flex items-center gap-3">
            {{- form_widget(form) -}}
            <span class="font-mono text-xs text-[var(--color-ink)]/55" data-color-hex-for="{{ id }}">{{ value }}</span>
        </div>
        {{- form_errors(form) -}}
        {{- form_help(form) -}}
    </div>
{%- endblock color_row -%}

{%- block form_label -%}
    {% if label is not same as(false) -%}
        {% if label_attr.class is not defined or label_attr.class is empty %}
            {% set label_attr = label_attr|merge({class: 'block text-sm font-medium text-[var(--color-ink)]/85'}) %}
        {% endif %}
        {{- parent() -}}
    {%- endif -%}
{%- endblock form_label -%}

{%- block form_widget_simple -%}
    {% set type = type|default('text') %}
    {% if type == 'hidden' %}
        {{- parent() -}}
    {% elseif type == 'color' %}
        {% set attr = attr|merge({class: (attr.class|default('') ~ ' input-color')|trim}) %}
        {{- parent() -}}
    {% else %}
        {% set attr = attr|merge({class: (attr.class|default('') ~ ' input')|trim}) %}
        {{- parent() -}}
    {% endif %}
{%- endblock form_widget_simple -%}

{%- block toggle_password_widget -%}
    {% set attr = attr|merge({class: (attr.class|default('') ~ ' input')|trim}) %}
    {{- parent() -}}
{%- endblock toggle_password_widget -%}

{%- block textarea_widget -%}
    {% set attr = attr|merge({class: (attr.class|default('') ~ ' input')|trim}) %}
    {{- parent() -}}
{%- endblock textarea_widget -%}

{%- block choice_widget_collapsed -%}
    {% set attr = attr|merge({class: (attr.class|default('') ~ ' input')|trim}) %}
    {%- if required and placeholder is none and not placeholder_in_choices and not multiple and (attr.size is not defined or attr.size <= 1) -%}
        {% set required = false %}
    {%- endif -%}
    <select {{ block('widget_attributes') }}{% if multiple %} multiple="multiple"{% endif %}>
        {%- if placeholder is not none -%}
            {#- Kits may pre-|trans empty-option copy; only translate catalogue-looking keys. -#}
            {%- set _ph_is_key = placeholder is not same as('') and placeholder is not same as(false) and placeholder matches '/^[a-zA-Z_][a-zA-Z0-9_.]*$/' -%}
            {%- set _ph_skip = translation_domain is same as(false) or not _ph_is_key -%}
            <option value=""{% if placeholder_attr|default({}) %}{% with {attr: placeholder_attr} %}{{ block('attributes') }}{% endwith %}{% endif %}{% if required and value is empty %} selected="selected"{% endif %}>{{ placeholder != '' ? (_ph_skip ? placeholder : placeholder|trans({}, translation_domain)) }}</option>
        {%- endif -%}
        {%- if preferred_choices|length > 0 -%}
            {% set options = preferred_choices %}
            {% set render_preferred_choices = true %}
            {{- block('choice_widget_options') -}}
            {%- if choices|length > 0 and separator is not none -%}
                {%- if separator_html is not defined or separator_html is same as(false) -%}
                    <option disabled="disabled">{{ separator }}</option>
                {% else %}
                    {{ separator|raw }}
                {% endif %}
            {%- endif -%}
        {%- endif -%}
        {%- set options = choices -%}
        {%- set render_preferred_choices = false -%}
        {{- block('choice_widget_options') -}}
    </select>
{%- endblock choice_widget_collapsed -%}

{#- Expanded multi/single choice: keep checkbox and label on one row (form_div_layout emits naked siblings). -#}
{%- block choice_widget_expanded -%}
    {%- set attr = attr|merge({
        class: (attr.class|default('') ~ ' flex flex-col gap-2.5 rounded-md border border-[var(--color-sand)]/80 bg-[var(--color-sand)]/10 p-3')|trim,
    }) -%}
    <div {{ block('widget_container_attributes') }}>
        {%- for child in form %}
            {%- set choice_label = child.vars.label -%}
            <label class="checkbox-label">
                {{- form_widget(child, {
                    attr: {
                        class: 'checkbox',
                    },
                }) -}}
                {%- if choice_label is not same as(false) -%}
                    <span class="leading-snug">
                        {#- Match Symfony form_div_layout: skip |trans when domain is false (literal labels). -#}
                        {{- choice_translation_domain is same as(false) ? choice_label : choice_label|trans({}, choice_translation_domain) -}}
                    </span>
                {%- endif -%}
            </label>
        {%- endfor -%}
    </div>
{%- endblock choice_widget_expanded -%}

{%- block checkbox_row -%}
    <div class="{{ row_attr.class|default('flex flex-col gap-2') }}">
        <label class="checkbox-label checkbox-label--start">
            {{- form_widget(form, {
                attr: {
                    class: (attr.class|default('') ~ ' checkbox')|trim,
                },
            }) -}}
            <span class="min-w-0">
                {%- if label is not same as(false) -%}
                    <span class="block font-medium text-[var(--color-ink)]/85">
                        {{- translation_domain is same as(false) ? label : label|trans({}, translation_domain) -}}
                    </span>
                {%- endif -%}
                {{- form_help(form) -}}
            </span>
        </label>
        {{- form_errors(form) -}}
    </div>
{%- endblock checkbox_row -%}

{%- block checkbox_widget -%}
    {%- if 'pref-switch__input' in (attr.class|default('')) -%}
        {%- set attr = attr|merge({class: attr.class|default('')|trim}) -%}
    {%- else -%}
        {%- set attr = attr|merge({class: (attr.class|default('') ~ ' checkbox')|trim}) -%}
    {%- endif -%}
    {{- parent() -}}
{%- endblock checkbox_widget -%}

{%- block attributes -%}
    {%- for attrname, attrvalue in attr -%}
        {{- ' ' -}}
        {%- if attrname in ['placeholder', 'title'] -%}
            {#- Keys look like form.field.placeholder; kits often pre-|trans literals into attr. -#}
            {%- set _is_key = attrvalue is not null and attrvalue is not same as(false) and attrvalue matches '/^[a-zA-Z_][a-zA-Z0-9_.]*$/' -%}
            {%- set _skip_trans = translation_domain is same as(false) or attrvalue is null or attrvalue is same as(false) or not _is_key -%}
            {{- attrname }}="{{ _skip_trans ? attrvalue : attrvalue|trans(attr_translation_parameters, translation_domain) }}"
        {%- elseif attrvalue is same as(true) -%}
            {{- attrname }}="{{ attrname }}"
        {%- elseif attrvalue is not same as(false) -%}
            {{- attrname }}="{{ attrvalue }}"
        {%- endif -%}
    {%- endfor -%}
{%- endblock attributes -%}

{#- Help size/tone: Symfony form_help uses .help-text (see _components.scss). -#}
{%- block form_help -%}
    {%- if help is not empty -%}
        {{- parent() -}}
    {%- endif -%}
{%- endblock form_help -%}

{%- block form_errors -%}
    {%- if errors|length > 0 -%}
        <ul class="list-none space-y-1 text-sm text-[var(--color-alert)]">
            {%- for error in errors -%}
                <li>{{ error.message }}</li>
            {%- endfor -%}
        </ul>
    {%- endif -%}
{%- endblock form_errors -%}
