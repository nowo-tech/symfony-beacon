<!DOCTYPE html>
<html
    lang="{{ app.request.locale|default('en') }}"
    {% if site_appearance.footerFixed %}data-footer-fixed="1"{% endif %}
    {% if app.user and app.user.preferredTheme in ['light', 'dark'] %}data-theme="{{ app.user.preferredTheme|e('html_attr') }}"{% endif %}
    {% if app.user %}data-user-theme="{{ app.user.preferredTheme|e('html_attr') }}"{% endif %}
    {% if app.user %}
        data-user-density="{{ app.user.preferredUiDensity|e('html_attr') }}"
        data-user-motion="{{ app.user.preferredMotion|e('html_attr') }}"
        data-user-font-scale="{{ app.user.preferredFontScale|e('html_attr') }}"
        data-user-contrast="{{ app.user.preferredContrast|e('html_attr') }}"
        data-user-sidebar="{{ app.user.preferredSidebar|e('html_attr') }}"
    {% endif %}
    data-issue-panel-defaults="{{ (app.user ? app.user.preferredCollapsedIssuePanels : ['raw', 'extra'])|json_encode|e('html_attr') }}"
>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
        {# Blocking IIFE from assets/theme-boot.ts + critical dark/light substrate (FOUC). #}
        {% include '_theme_boot.html.twig' %}
        <title>{% block title %}{{ site_appearance.brandName }}{% endblock %}</title>
        {{ nowo_pwa_head() }}
        <link rel="icon" href="{{ asset('favicon.ico') }}" sizes="any">
        <link rel="icon" href="{{ asset('brand/beacon-mark.svg') }}" type="image/svg+xml">
        <link rel="apple-touch-icon" href="{{ asset('icons/apple-touch-icon.png') }}">
        {% block stylesheets %}
            {# UiKit tokens/components first; Beacon app CSS must win for product chrome. #}
            <link rel="stylesheet" href="{{ asset('css/nowo-ui.css', 'nowo_ui_kit') }}">
            {{ vite_entry_link_tags('app') }}
        {% endblock %}
        {# After app CSS so site palette / radius / border tokens win the cascade. Nonce matches CSP style-src. #}
        <style{% if csp_nonce() %} nonce="{{ csp_nonce() }}"{% endif %}>{{ site_appearance.cssOverrides|raw }}</style>
        {% block javascripts %}
            {{ vite_entry_script_tags('app') }}
            <script src="{{ asset('js/nowo-ui-orb.js', 'nowo_ui_kit') }}" defer></script>
        {% endblock %}
    </head>
    <body class="page-shell{% if app.user %} page-shell--app{% endif %}">
        {% include '_page_loader.html.twig' %}

        {% if app.user %}
            {% set brand_html %}
                {% include '_brand_mark.html.twig' with {size: 'sm'} %}
            {% endset %}
            {% set header_end %}
                {% include '_theme_toggle.html.twig' with {compact: true} %}
                {% include '_content_width_toggle.html.twig' with {compact: true} %}
                {% include '_locale_switcher.html.twig' with {compact: true} %}
                {% include '_user_menu.html.twig' %}
            {% endset %}
            {% set aside_html %}
                <div class="app-sidebar__inner">
                    <p class="app-sidebar__label">{{ app_section.current.labelKey|trans }}</p>
                    <div class="app-sidebar__nav">
                        {% include '_section_nav.html.twig' %}
                    </div>
                </div>
            {% endset %}
            {#
              Open UiKit _shell without capturing {% block body %} (Twig allows one
              definition). Main slot is closed after the shared body blocks below.
            #}
            {% include '@NowoUiKitBundle/partials/_shell_open.html.twig' with {
                framework: 'tailwind',
                brand_html: brand_html,
                header_end: header_end,
                aside_html: aside_html,
                aside_label: app_section.current.labelKey|trans,
                aside_id: 'app-sidebar',
                show_user_menu: false,
                collapsed: app.user.preferredSidebar == 'collapsed',
                content_width: app.user.preferredContentWidth,
                shell_attr: {
                    'data-content-width': app.user.preferredContentWidth,
                    'data-ui-density': app.user.preferredUiDensity,
                    'data-font-scale': app.user.preferredFontScale,
                    'data-contrast': app.user.preferredContrast|default('system'),
                    'data-sidebar-default': app.user.preferredSidebar,
                    'data-theme-sync-url': path('account_theme'),
                    'data-theme-sync-token': csrf_token('account_theme'),
                    'data-content-width-sync-url': path('account_content_width'),
                    'data-content-width-sync-token': csrf_token('account_content_width'),
                }
            } %}
                <main class="app-main__inner">
        {% else %}
            <div class="top-controls">
                {% include '_theme_toggle.html.twig' %}
                {% include '_locale_switcher.html.twig' %}
            </div>
            <main class="auth-shell-main relative z-10 mx-auto flex w-full max-w-6xl flex-1 justify-center px-4 py-12">
        {% endif %}

                        {% if app.user %}
                            {% set beacon_breadcrumbs = breadcrumb_render() %}
                            {% if beacon_breadcrumbs %}
                                <div class="beacon-breadcrumb-wrap mb-6">{{ beacon_breadcrumbs|raw }}</div>
                            {% endif %}
                            {% if is_granted('ROLE_ADMIN') and app.session.get('_beacon_view_as_member') %}
                                <div class="mb-4 flex flex-wrap items-center justify-between gap-3 rounded-md border border-amber-600/40 bg-amber-500/10 px-4 py-3 text-sm" role="status">
                                    <span>{{ 'admin_projects.view_as_banner'|trans }}</span>
                                    {% set form = csrf_action_form(path('admin_view_as_member_disable'), 'admin_view_as_member_disable', fields: {redirect: app.request.requestUri}) %}
                                    {{ form_start(form) }}
                                        <button class="btn-ghost btn-sm" type="submit">{{ 'admin_projects.view_as_exit'|trans }}</button>
                                    {{ form_end(form) }}
                                </div>
                            {% endif %}
                        {% endif %}
                        {% block app_flashes %}
                            {% include '_toasts.html.twig' %}
                        {% endblock %}
                        {# body_before/after let kit host layouts wrap page body without colliding
                           with Dashboard Menu / Breadcrumb Kit pages that also define `body`. #}
                        {% block body_before %}{% endblock %}
                        {% block body %}{% endblock %}
                        {% block body_after %}{% endblock %}

        {% if app.user %}
                </main>
            {% set footer_html %}
                {% include '_legal_footer.html.twig' %}
            {% endset %}
            {% include '@NowoUiKitBundle/partials/_shell_close.html.twig' with {
                footer_html: footer_html
            } %}
            {{ nowo_pwa_install_prompt() }}
            {% include '_issue_realtime.html.twig' %}
        {% else %}
            </main>
            {{ nowo_pwa_install_prompt() }}
            {% include '_legal_footer.html.twig' %}
        {% endif %}

        {# Consent modal only on public routes (skip_render_routes omits app/admin shells). #}
        {% if nowo_cookie_consent_should_render() %}
            {{ render(path('nowo_cookie_consent.show')) }}
        {% endif %}
    </body>
</html>
