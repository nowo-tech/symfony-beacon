{# Beacon host layout for cookie-consent admin Web UI (1.4+).
   Admin pages fill {% block body %}; wrap via body_before/after (same Twig body collision as menus).
   Prefer this shell + kit/_kit_admin_styles over forking admin CRUD Twig. #}
{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    {{ vite_entry_link_tags('kit-admin') }}
    {% include 'kit/_kit_admin_styles.html.twig' %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ vite_entry_script_tags('kit-admin') }}
{% endblock %}

{% block body_before %}
    <div class="kit-admin panel">
{% endblock %}

{% block body_after %}
    </div>
{% endblock %}
