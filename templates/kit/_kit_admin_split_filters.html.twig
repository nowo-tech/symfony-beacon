{# Move .nowo-ui-search above the .panel so filters match admin users/groups (outside the card).
   Bundle body stays unforked; this runs after body_before/body/body_after chrome is in the DOM. #}
<script>
(() => {
  document.querySelectorAll('.kit-admin[data-kit-split-filters]').forEach((root) => {
    if (root.dataset.kitSplitDone === '1') {
      return;
    }
    root.dataset.kitSplitDone = '1';

    const search = root.querySelector(':scope > .nowo-ui-search');
    if (!search) {
      root.classList.add('panel');
      return;
    }

    const panel = document.createElement('div');
    panel.className = 'panel';
    let node = search.nextSibling;
    while (node) {
      const next = node.nextSibling;
      panel.appendChild(node);
      node = next;
    }
    root.appendChild(panel);
  });
})();
</script>
