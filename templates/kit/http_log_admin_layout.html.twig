{# Beacon host layout for Http Log admin UI.
   Admin pages fill {% block nowo_ui_content %} (host forks skip vendor admin/base).
   List/detail chrome: templates/bundles/NowoHttpLogBundle/admin/
   (Beacon panel + kit_admin_header_actions + text row actions). #}
{% extends 'kit/_kit_admin_layout.html.twig' %}

{% set kit_admin_inline = true %}
{% set kit_admin_heading %}{% block page_title %}{{ 'nav.http_log'|trans }}{% endblock %}{% endset %}
{% set kit_admin_intro = 'admin.hub.http_log'|trans %}
{% set kit_admin_wrapper_class = ' nowo-http-log' %}
{% set kit_admin_css_framework = nowo_http_log_css_framework|default('tailwind') %}
{% set kit_admin_data_testid = 'admin-http-log' %}

{% block title %}{{ kit_admin_heading|striptags|trim }} — {{ site_appearance.brandName }}{% endblock %}

{% block kit_admin_extra_styles %}
    <style{% if csp_nonce() %} nonce="{{ csp_nonce() }}"{% endif %}>
        .kit-admin.nowo-http-log .http-log-filters > * {
            min-width: 0;
        }

        .kit-admin.nowo-http-log .http-log-details {
            display: grid;
            grid-template-columns: minmax(8rem, 12rem) 1fr;
            gap: 0.5rem 1rem;
            margin: 0;
        }
        .kit-admin.nowo-http-log .http-log-details dt {
            margin: 0;
            font-size: 0.75rem;
            color: color-mix(in srgb, var(--color-ink, var(--beacon-ink)) 55%, transparent);
        }
        .kit-admin.nowo-http-log .http-log-details dd {
            margin: 0;
            min-width: 0;
            word-break: break-word;
        }
        .kit-admin.nowo-http-log .nowo-ui-code,
        .kit-admin.nowo-http-log .bg-light {
            background: color-mix(in srgb, var(--color-sand, var(--beacon-sand)) 35%, transparent);
            border-radius: 0.375rem;
            overflow-x: auto;
            font-size: 0.75rem;
            padding: 0.75rem;
        }
        .kit-admin.nowo-http-log .h5,
        .kit-admin.nowo-http-log .nowo-ui-section-title {
            font-size: 1rem;
            font-weight: 600;
            margin: 1.25rem 0 0.5rem;
        }
    </style>
{% endblock %}
