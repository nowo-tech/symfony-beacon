{# Beacon host layout for RoutingKit admin panel (REQ-UI-001).
   Panel pages fill {% block body %}; wrap via body_before/after.
   Do NOT load Vite kit-admin: RoutingKit uses css_framework=custom (nowo-ui.css via panel/base). #}
{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    {% include 'kit/_kit_admin_styles.html.twig' %}
{% endblock %}

{% block body_before %}
    <div class="kit-admin panel nowo-ui-routing-kit-panel" data-css-framework="{{ nowo_routing_kit_css_framework|default('custom') }}">
{% endblock %}

{% block body_after %}
    </div>
{% endblock %}
