{# Beacon host layout for RoutingKit admin panel (REQ-UI-001).
   Panel pages fill {% block body %}; wrap via body_before/after.
   nowo-ui.css is loaded from @NowoRoutingKitBundle/panel/base.html.twig. #}
{% extends 'base.html.twig' %}

{% block title %}{{ 'nav.routing'|trans }} — {{ site_appearance.brandName }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ vite_entry_link_tags('kit-admin') }}
    {% include 'kit/_kit_admin_styles.html.twig' %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ vite_entry_script_tags('kit-admin') }}
{% endblock %}

{% block body_before %}
    <header class="kit-admin-page-header mb-6">
        <h1 class="kit-admin-page-header__title">{{ 'nav.routing'|trans }}</h1>
        <p class="kit-admin-page-header__intro">{{ 'admin.hub.routing'|trans }}</p>
    </header>
    <div
        class="kit-admin nowo-ui-routing-kit-panel"
        data-css-framework="{{ nowo_routing_kit_css_framework|default('tailwind') }}"
        data-testid="admin-routing-kit"
    >
{% endblock %}

{% block body_after %}
    </div>
{% endblock %}
