{# Host restyle for kit admin (UiKit nowo-ui.css + nowo_ui_kit: tailwind; remap --nowo-ui-*). #}
<style>
/*
 * Page chrome (outside .kit-admin): title/intro match admin users/groups
 * (text-3xl + muted intro). Element+class > bare h1/p.
 */
h1.kit-admin-page-header__title {
  font-family: var(--font-display), ui-sans-serif, system-ui, sans-serif;
  font-size: 1.875rem;
  font-weight: 700;
  line-height: 2.25rem;
  letter-spacing: normal;
  color: var(--color-ink, var(--beacon-ink));
  margin: 0;
}

p.kit-admin-page-header__intro {
  margin: 0.25rem 0 0;
  font-size: 0.875rem;
  font-weight: 400;
  line-height: 1.25rem;
  color: color-mix(in srgb, var(--color-ink, var(--beacon-ink)) 65%, transparent);
}

/* —— Kit admin (Menus / Breadcrumbs) — type + control scale ——
 * Tokens also on .nowo-ui-modal: kit-admin.ts portals modals to <body>,
 * so they leave .kit-admin and would otherwise keep UiKit slate/blue :root defaults.
 */
.kit-admin,
.nowo-ui-modal {
  --kit-font-body: 0.875rem;
  --kit-font-label: 0.8125rem;
  --kit-font-meta: 0.75rem;
  --kit-font-title: 1.25rem;
  --kit-btn-font: 0.875rem;
  --kit-btn-pad-y: 0.5rem;
  --kit-btn-pad-x: 1rem;
  --kit-btn-sm: 2rem;
  --kit-btn-sm-font: 0.8125rem;
  --kit-btn-radius: 0.375rem;

  /* Menu/Breadcrumb nowo-ui.css tokens (1.0.4 / 2.0.11+) */
  --nowo-ui-primary: var(--beacon-moss);
  --nowo-ui-primary-contrast: #ffffff;
  --nowo-ui-danger: var(--beacon-alert);
  --nowo-ui-danger-text: var(--beacon-alert);
  --nowo-ui-danger-bg: var(--beacon-flash-error-bg);
  --nowo-ui-danger-border: var(--beacon-flash-error-border);
  --nowo-ui-danger-text-strong: var(--beacon-alert);
  --nowo-ui-success-bg: var(--beacon-flash-ok-bg);
  --nowo-ui-success-border: var(--beacon-flash-ok-border);
  --nowo-ui-success-text: var(--beacon-flash-ok-text);
  --nowo-ui-surface: var(--beacon-surface);
  --nowo-ui-surface-muted: var(--beacon-mist);
  --nowo-ui-border: var(--beacon-sand);
  --nowo-ui-border-strong: var(--beacon-sand);
  --nowo-ui-text: var(--beacon-ink);
  --nowo-ui-muted: color-mix(in srgb, var(--beacon-ink) 55%, transparent);
  --nowo-ui-radius: var(--kit-btn-radius);

  --bs-body-color: var(--beacon-ink);
  --bs-body-bg: var(--beacon-surface);
  --bs-border-color: var(--beacon-sand);
  --bs-secondary-color: color-mix(in srgb, var(--beacon-ink) 55%, transparent);
  --bs-link-color: var(--beacon-moss);
  --bs-link-hover-color: var(--beacon-moss-deep);
  --bs-primary: var(--beacon-moss);
  --bs-primary-rgb: 31, 111, 84;
  --bs-danger: var(--beacon-alert);
  --bs-focus-ring-color: color-mix(in srgb, var(--beacon-moss) 35%, transparent);
  font-size: var(--kit-font-body);
  line-height: 1.45;
  color: var(--beacon-ink);
}

[data-theme="dark"] .kit-admin,
[data-theme="dark"] .nowo-ui-modal {
  --bs-primary-rgb: 74, 173, 127;
  --nowo-ui-primary-contrast: #0c1210;
}

.kit-admin .h1,
.kit-admin h1,
.kit-admin .h3,
.kit-admin h3.h3 {
  font-size: var(--kit-font-title);
  font-weight: 600;
  line-height: 1.3;
  letter-spacing: -0.01em;
}

.kit-admin .small,
.kit-admin small,
.kit-admin .form-text {
  font-size: var(--kit-font-meta);
}

/* Default toolbar / form buttons — same metrics as Beacon .btn-primary */
.kit-admin .btn,
.modal .btn {
  --bs-btn-font-size: var(--kit-btn-font, 0.875rem);
  --bs-btn-padding-y: var(--kit-btn-pad-y, 0.5rem);
  --bs-btn-padding-x: var(--kit-btn-pad-x, 1rem);
  --bs-btn-border-radius: var(--kit-btn-radius, 0.375rem);
  --bs-btn-font-weight: 500;
  --bs-btn-line-height: 1.25;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.35rem;
  min-height: 2.25rem;
  border-radius: var(--kit-btn-radius, 0.375rem);
  font-size: var(--kit-btn-font, 0.875rem) !important;
  line-height: 1.25;
  padding: var(--kit-btn-pad-y, 0.5rem) var(--kit-btn-pad-x, 1rem) !important;
  transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease, box-shadow 0.15s ease;
}

/* Row / icon actions — square and aligned */
.kit-admin .btn-sm,
.modal .btn-sm {
  --bs-btn-padding-y: 0.35rem;
  --bs-btn-padding-x: 0.35rem;
  --bs-btn-font-size: var(--kit-btn-sm-font, 0.8125rem);
  width: var(--kit-btn-sm, 2rem);
  min-width: var(--kit-btn-sm, 2rem);
  min-height: var(--kit-btn-sm, 2rem);
  height: var(--kit-btn-sm, 2rem);
  padding: 0.35rem !important;
  font-size: var(--kit-btn-sm-font, 0.8125rem) !important;
  line-height: 1;
}

.kit-admin .btn-sm svg,
.modal .btn-sm svg {
  display: block;
  flex-shrink: 0;
  width: 1rem;
  height: 1rem;
}

/* Textual compact buttons: auto width when not icon-only */
.kit-admin .btn-sm.btn-label {
  width: auto;
  min-width: 0;
  height: auto;
  min-height: var(--kit-btn-sm, 2rem);
  padding: 0.35rem 0.65rem !important;
}

.kit-admin .btn-primary,
.modal .btn-primary {
  --bs-btn-color: #fff;
  --bs-btn-bg: var(--beacon-moss);
  --bs-btn-border-color: var(--beacon-moss);
  --bs-btn-hover-color: #fff;
  --bs-btn-hover-bg: var(--beacon-moss-deep);
  --bs-btn-hover-border-color: var(--beacon-moss-deep);
  --bs-btn-active-color: #fff;
  --bs-btn-active-bg: var(--beacon-moss-deep);
  --bs-btn-active-border-color: var(--beacon-moss-deep);
  --bs-btn-disabled-color: #fff;
  --bs-btn-disabled-bg: var(--beacon-moss);
  --bs-btn-disabled-border-color: var(--beacon-moss);
  font-weight: 600;
}

[data-theme="dark"] .kit-admin .btn-primary,
[data-theme="dark"] .modal .btn-primary {
  --bs-btn-color: #0c1210;
  --bs-btn-hover-color: #0c1210;
  --bs-btn-active-color: #0c1210;
  --bs-btn-disabled-color: #0c1210;
}

.kit-admin .btn-outline-secondary,
.kit-admin .btn-secondary,
.modal .btn-outline-secondary,
.modal .btn-secondary {
  --bs-btn-color: var(--beacon-ink);
  --bs-btn-bg: transparent;
  --bs-btn-border-color: var(--beacon-sand);
  --bs-btn-hover-color: var(--beacon-ink);
  --bs-btn-hover-bg: var(--beacon-surface);
  --bs-btn-hover-border-color: color-mix(in srgb, var(--beacon-moss) 40%, var(--beacon-sand));
  --bs-btn-active-color: var(--beacon-ink);
  --bs-btn-active-bg: var(--beacon-mist);
  --bs-btn-active-border-color: color-mix(in srgb, var(--beacon-moss) 40%, var(--beacon-sand));
  --bs-btn-disabled-color: color-mix(in srgb, var(--beacon-ink) 45%, transparent);
  --bs-btn-disabled-bg: transparent;
  --bs-btn-disabled-border-color: var(--beacon-sand);
}

.kit-admin .btn-secondary,
.modal .btn-secondary {
  --bs-btn-bg: color-mix(in srgb, var(--beacon-surface) 85%, transparent);
}

.kit-admin .btn-outline-primary,
.kit-admin .btn-outline-info,
.kit-admin .btn-outline-success,
.kit-admin .btn-outline-warning,
.modal .btn-outline-primary,
.modal .btn-outline-info,
.modal .btn-outline-success,
.modal .btn-outline-warning {
  --bs-btn-color: var(--beacon-moss);
  --bs-btn-bg: transparent;
  --bs-btn-border-color: color-mix(in srgb, var(--beacon-moss) 55%, var(--beacon-sand));
  --bs-btn-hover-color: var(--beacon-moss-deep);
  --bs-btn-hover-bg: color-mix(in srgb, var(--beacon-moss) 12%, var(--beacon-surface));
  --bs-btn-hover-border-color: var(--beacon-moss);
  --bs-btn-active-color: var(--beacon-moss-deep);
  --bs-btn-active-bg: color-mix(in srgb, var(--beacon-moss) 16%, var(--beacon-surface));
  --bs-btn-active-border-color: var(--beacon-moss);
  --bs-btn-disabled-color: color-mix(in srgb, var(--beacon-moss) 45%, transparent);
  --bs-btn-disabled-bg: transparent;
  --bs-btn-disabled-border-color: var(--beacon-sand);
  color: var(--beacon-moss) !important;
  border-color: color-mix(in srgb, var(--beacon-moss) 55%, var(--beacon-sand)) !important;
  background-color: transparent !important;
}
.kit-admin .btn-outline-primary:hover,
.kit-admin .btn-outline-info:hover,
.kit-admin .btn-outline-success:hover,
.kit-admin .btn-outline-warning:hover,
.kit-admin .btn-outline-primary:focus,
.kit-admin .btn-outline-info:focus,
.kit-admin .btn-outline-success:focus,
.kit-admin .btn-outline-warning:focus,
.modal .btn-outline-primary:hover,
.modal .btn-outline-info:hover,
.modal .btn-outline-success:hover,
.modal .btn-outline-warning:hover {
  color: var(--beacon-moss-deep) !important;
  border-color: var(--beacon-moss) !important;
  background-color: color-mix(in srgb, var(--beacon-moss) 12%, var(--beacon-surface)) !important;
}

.kit-admin .btn-outline-secondary,
.kit-admin .btn-secondary,
.modal .btn-outline-secondary,
.modal .btn-secondary {
  color: var(--beacon-ink) !important;
  border-color: var(--beacon-sand) !important;
  background-color: transparent !important;
}
.kit-admin .btn-outline-secondary:hover,
.kit-admin .btn-secondary:hover,
.modal .btn-outline-secondary:hover,
.modal .btn-secondary:hover {
  color: var(--beacon-ink) !important;
  border-color: color-mix(in srgb, var(--beacon-moss) 40%, var(--beacon-sand)) !important;
  background-color: var(--beacon-surface) !important;
}

.kit-admin .btn-link,
.modal .btn-link {
  --bs-btn-color: var(--beacon-moss);
  --bs-btn-hover-color: var(--beacon-moss-deep);
  min-height: 0;
  padding: 0 !important;
  font-size: var(--kit-font-body, 0.875rem) !important;
  font-weight: 500;
  color: var(--beacon-moss) !important;
  text-decoration: none;
}
.kit-admin .btn-link:hover,
.modal .btn-link:hover {
  color: var(--beacon-moss-deep) !important;
}

.kit-admin .btn-outline-danger,
.modal .btn-outline-danger {
  --bs-btn-color: var(--beacon-alert);
  --bs-btn-bg: transparent;
  --bs-btn-border-color: color-mix(in srgb, var(--beacon-alert) 55%, var(--beacon-sand));
  --bs-btn-hover-color: var(--beacon-alert);
  --bs-btn-hover-bg: color-mix(in srgb, var(--beacon-alert) 12%, var(--beacon-surface));
  --bs-btn-hover-border-color: var(--beacon-alert);
  color: var(--beacon-alert) !important;
  border-color: color-mix(in srgb, var(--beacon-alert) 55%, var(--beacon-sand)) !important;
  background-color: transparent !important;
}
.kit-admin .btn-outline-danger:hover,
.modal .btn-outline-danger:hover {
  color: var(--beacon-alert) !important;
  border-color: var(--beacon-alert) !important;
  background-color: color-mix(in srgb, var(--beacon-alert) 12%, var(--beacon-surface)) !important;
}

.kit-admin .btn-danger,
.modal .btn-danger {
  --bs-btn-color: #fff;
  --bs-btn-bg: var(--beacon-alert);
  --bs-btn-border-color: var(--beacon-alert);
  color: #fff !important;
  background-color: var(--beacon-alert) !important;
  border-color: var(--beacon-alert) !important;
  font-weight: 600;
}

.kit-admin-meta {
  border: 1px solid var(--beacon-sand);
  border-radius: 0.5rem;
  background: color-mix(in srgb, var(--beacon-mist) 55%, var(--beacon-surface));
  color: color-mix(in srgb, var(--beacon-ink) 85%, transparent);
  padding: 0.65rem 0.85rem;
  font-size: var(--kit-font-label);
  line-height: 1.45;
}
.kit-admin-meta code {
  color: var(--beacon-moss);
  font-size: var(--kit-font-meta);
  word-break: break-all;
}

.kit-admin .table {
  --bs-table-bg: transparent;
  --bs-table-color: var(--beacon-ink);
  --bs-table-border-color: var(--beacon-sand);
  --bs-table-hover-bg: color-mix(in srgb, var(--beacon-mist) 55%, transparent);
  --bs-table-hover-color: var(--beacon-ink);
  --bs-table-striped-bg: color-mix(in srgb, var(--beacon-mist) 35%, transparent);
  color: var(--beacon-ink);
  font-size: var(--kit-font-body);
}
.kit-admin .table > :not(caption) > * > * {
  background-color: transparent;
  border-bottom-color: var(--beacon-sand);
  color: var(--beacon-ink);
  vertical-align: middle;
}
.kit-admin .table thead th {
  color: color-mix(in srgb, var(--beacon-ink) 70%, transparent);
  font-size: var(--kit-font-meta);
  font-weight: 600;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

.kit-admin .badge {
  font-size: var(--kit-font-meta);
  font-weight: 600;
  letter-spacing: 0.03em;
  vertical-align: middle;
}

.kit-admin .alert-light {
  background-color: color-mix(in srgb, var(--beacon-mist) 55%, var(--beacon-surface));
  border-color: var(--beacon-sand);
  color: var(--beacon-ink);
  font-size: var(--kit-font-body);
}

.kit-admin .alert-info {
  background-color: color-mix(in srgb, var(--beacon-moss) 14%, var(--beacon-surface));
  border-color: color-mix(in srgb, var(--beacon-moss) 35%, var(--beacon-sand));
  color: var(--beacon-ink);
  font-size: var(--kit-font-body);
}

.kit-admin .btn-close {
  filter: none;
  opacity: 0.65;
}
[data-theme="dark"] .kit-admin .btn-close {
  filter: invert(1) grayscale(100%);
  opacity: 0.75;
}

.kit-admin .form-label {
  font-size: var(--kit-font-label);
  font-weight: 500;
  margin-bottom: 0.35rem;
}

.kit-admin .form-control,
.kit-admin .form-select {
  background-color: var(--beacon-surface);
  border-color: var(--beacon-sand);
  color: var(--beacon-ink);
  font-size: var(--kit-font-body);
  min-height: 2.25rem;
  padding: 0.5rem 0.75rem;
  border-radius: var(--kit-btn-radius);
}
.kit-admin .form-control:focus,
.kit-admin .form-select:focus {
  background-color: var(--beacon-surface);
  border-color: var(--beacon-moss);
  color: var(--beacon-ink);
  box-shadow: 0 0 0 0.2rem color-mix(in srgb, var(--beacon-moss) 20%, transparent);
}
.kit-admin .form-control::placeholder {
  color: color-mix(in srgb, var(--beacon-ink) 40%, transparent);
}

.kit-admin .list-group-item {
  background-color: transparent;
  border-color: var(--beacon-sand);
  color: var(--beacon-ink);
  font-size: var(--kit-font-body);
}

.kit-admin .badge.bg-light {
  background-color: var(--beacon-mist) !important;
  color: var(--beacon-ink) !important;
  border-color: var(--beacon-sand) !important;
}

.kit-admin .badge.bg-secondary {
  background-color: color-mix(in srgb, var(--beacon-sand) 70%, var(--beacon-mist)) !important;
  color: var(--beacon-ink) !important;
}

/* Match product / UiKit table pagination (Beacon pills, not Bootstrap filled active). */
.kit-admin .nowo-ui-pagination,
.kit-admin nav.nowo-ui-pagination {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
  margin-top: 0.85rem;
  padding-top: 0.85rem;
  border-top: 1px solid var(--beacon-sand);
}

.kit-admin .nowo-ui-pagination > ul.pagination,
.kit-admin .nowo-ui-pagination__nav {
  order: 2;
}

.kit-admin .nowo-ui-pagination > p,
.kit-admin .nowo-ui-pagination__info {
  order: 1;
  margin: 0;
  color: color-mix(in srgb, var(--beacon-ink) 65%, transparent);
  font-size: var(--kit-font-meta);
}

.kit-admin .nowo-ui-pagination__nav {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.25rem;
}

.kit-admin .nowo-ui-pagination__nav > .pagination {
  margin: 0;
}

.kit-admin .pagination {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.25rem;
  list-style: none;
  margin: 0;
  padding: 0;
}

.kit-admin .pagination .page-item {
  margin: 0;
}

.kit-admin .pagination .page-link,
.kit-admin .nowo-ui-pagination__link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 2rem;
  min-height: 2rem;
  padding: 0.35rem 0.65rem;
  border: 1px solid var(--beacon-sand);
  border-radius: 0.375rem;
  background: var(--beacon-surface);
  color: var(--beacon-ink);
  font-size: var(--kit-font-meta);
  font-weight: 500;
  line-height: 1.25;
  text-decoration: none;
}

.kit-admin .pagination .page-link:hover,
.kit-admin .nowo-ui-pagination__link:hover {
  border-color: var(--beacon-moss);
  color: var(--beacon-moss);
  background: var(--beacon-surface);
}

.kit-admin .pagination .page-item.active .page-link,
.kit-admin .nowo-ui-pagination__link.is-active {
  border-color: var(--beacon-moss);
  background: color-mix(in srgb, var(--beacon-moss) 12%, var(--beacon-surface));
  color: var(--beacon-moss);
  font-weight: 600;
}

.kit-admin .pagination .page-item.disabled .page-link,
.kit-admin .nowo-ui-pagination__link.is-disabled {
  opacity: 0.45;
  pointer-events: none;
  background: var(--beacon-surface);
  border-color: var(--beacon-sand);
  color: color-mix(in srgb, var(--beacon-ink) 55%, transparent);
}

.kit-admin .nowo-ui-pagination__ellipsis {
  padding: 0 0.25rem;
  color: color-mix(in srgb, var(--beacon-ink) 45%, transparent);
}

.kit-admin .text-muted {
  color: color-mix(in srgb, var(--beacon-ink) 55%, transparent) !important;
}
.kit-admin .alert-success {
  background-color: var(--beacon-flash-ok-bg);
  border-color: var(--beacon-flash-ok-border);
  color: var(--beacon-flash-ok-text);
}
.kit-admin .alert-danger {
  background-color: var(--beacon-flash-error-bg);
  border-color: var(--beacon-flash-error-border);
  color: var(--beacon-alert);
}

/*
 * Kit modals (css_framework: tailwind): UiKit opens via .nowo-ui-modal-open (not Bootstrap .show).
 * kit-admin.ts portals .nowo-ui-modal to <body> — match Beacon .confirm-dialog chrome.
 * Specificity must beat vendor .nowo-ui-modal.nowo-ui-modal-open .modal-* (nowo-ui.css).
 */
.nowo-ui-modal.nowo-ui-modal-open {
  z-index: 1080;
  background: rgb(0 0 0 / 0.45);
  padding: 1.25rem;
  align-items: flex-start;
}

html[data-theme='dark'] .nowo-ui-modal.nowo-ui-modal-open {
  background: rgb(0 0 0 / 0.68);
}

.nowo-ui-modal.nowo-ui-modal-open .modal-dialog {
  /* Match Beacon .confirm-dialog default width (vendor defaults to 560px) */
  max-width: min(32rem, calc(100vw - 2rem));
  margin: auto;
}

.nowo-ui-modal.nowo-ui-modal-open .modal-dialog.modal-lg {
  max-width: min(36rem, calc(100vw - 2rem));
}

.nowo-ui-modal.nowo-ui-modal-open .modal-dialog.modal-xl {
  max-width: min(56rem, calc(100vw - 2rem));
}

.nowo-ui-modal.nowo-ui-modal-open .modal-content {
  border-radius: 0.75rem;
  border: 1px solid var(--beacon-sand);
  background: var(--beacon-surface);
  color: var(--beacon-ink);
  box-shadow: 0 12px 40px rgb(var(--beacon-shadow) / 22%);
  overflow: hidden;
  font-size: var(--kit-font-body, 0.875rem);
}

.nowo-ui-modal.nowo-ui-modal-open .modal-header {
  align-items: flex-start;
  gap: 0.75rem;
  padding: 1.15rem 1.25rem 0.9rem;
  border-bottom: 1px solid var(--beacon-sand);
  background: color-mix(in srgb, var(--beacon-mist) 35%, var(--beacon-surface));
}

.nowo-ui-modal.nowo-ui-modal-open .modal-title {
  margin: 0;
  flex: 1;
  font-size: 1.125rem;
  font-weight: 600;
  line-height: 1.35;
  letter-spacing: -0.01em;
  color: var(--beacon-ink);
}

.nowo-ui-modal.nowo-ui-modal-open .btn-close {
  margin: 0.1rem -0.15rem 0 0;
  padding: 0.45rem;
  border-radius: 0.3rem;
  color: var(--beacon-ink);
  opacity: 0.55;
}

.nowo-ui-modal.nowo-ui-modal-open .btn-close:hover,
.nowo-ui-modal.nowo-ui-modal-open .btn-close:focus-visible {
  opacity: 1;
  background: color-mix(in srgb, var(--beacon-mist) 55%, var(--beacon-surface));
}

.nowo-ui-modal.nowo-ui-modal-open .modal-body {
  padding: 1.15rem 1.25rem 1.25rem;
  color: var(--beacon-ink);
}

.nowo-ui-modal.nowo-ui-modal-open .modal-footer {
  padding: 0.9rem 1.25rem 1.15rem;
  border-top: 1px solid var(--beacon-sand);
