{# Beacon host layout for dashboard-menu CRUD.
   Bundle pages: @NowoDashboardMenuBundle/dashboard/*.html.twig → base → this shell.
   Do NOT fork dashboard pages — only this layout + CSS so kit upgrades flow in.

   Twig note: kit pages also define `{% block body %}`, so wrap with body_before/after
   (not body). Modals included in body_after; restyle with kit/_kit_admin_styles. #}
{% extends 'base.html.twig' %}

{% set kit_heading %}{% block dashboard_title %}{{ 'dashboard.title'|trans({}, 'NowoDashboardMenuBundle') }}{% endblock %}{% endset %}

{% block title %}{{ kit_heading|striptags|trim }} — {{ site_appearance.brandName }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    {# Load before vendor nowo-ui.css append; .kit-admin .nowo-ui-* specificity still wins. #}
    {% include 'kit/_kit_admin_styles.html.twig' %}
    <style>
        body > .ts-dropdown { z-index: 1060; }
    </style>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    {% include 'kit/_kit_modal_body_portals.html.twig' %}
    <script>
    {% if icon_selector_script_url is defined and icon_selector_script_url %}
    window.dashboardMenuIconSelectorScriptUrl = {{ (icon_selector_script_url starts with 'http') ? icon_selector_script_url : asset(icon_selector_script_url)|json_encode|raw }};
    {% endif %}
    window.__nowoDashboardMenuConfig = Object.assign(window.__nowoDashboardMenuConfig || {}, {
        cssFramework: {{ (nowo_dashboard_menu_css_framework|default('bootstrap5'))|json_encode|raw }}
    });
    window.dashboardMenuI18n = {
        loading: {{ 'dashboard.loading'|trans({}, 'NowoDashboardMenuBundle')|json_encode|raw }},
        errorLoadingForm: {{ 'dashboard.error_loading_form'|trans({}, 'NowoDashboardMenuBundle')|json_encode|raw }},
        deleteMenuConfirm: {{ 'dashboard.delete_menu_confirm'|trans({}, 'NowoDashboardMenuBundle')|json_encode|raw }},
        editItem: {{ 'dashboard.edit_item'|trans({}, 'NowoDashboardMenuBundle')|json_encode|raw }},
        editLabels: {{ 'dashboard.edit_labels'|trans({}, 'NowoDashboardMenuBundle')|json_encode|raw }},
        editTypePositionIcon: {{ 'dashboard.edit_type_position_icon'|trans({}, 'NowoDashboardMenuBundle')|json_encode|raw }},
        editConfig: {{ 'dashboard.edit_config'|trans({}, 'NowoDashboardMenuBundle')|json_encode|raw }},
        editMenu: {{ 'dashboard.edit_menu'|trans({}, 'NowoDashboardMenuBundle')|json_encode|raw }},
        addItem: {{ 'dashboard.add_item'|trans({}, 'NowoDashboardMenuBundle')|json_encode|raw }},
        deleteItemConfirm: {{ 'dashboard.delete_item_confirm'|trans({}, 'NowoDashboardMenuBundle')|json_encode|raw }}
    };
    </script>
    {% if stimulus_script_url is defined and stimulus_script_url %}
        <script type="module" src="{{ (stimulus_script_url starts with 'http') ? stimulus_script_url : asset(stimulus_script_url) }}"></script>
    {% endif %}
    {% if icon_selector_script_url is defined and icon_selector_script_url %}
        <script src="{{ (icon_selector_script_url starts with 'http') ? icon_selector_script_url : asset(icon_selector_script_url) }}" defer></script>
    {% endif %}
{% endblock %}

{% block body_before %}
    <header class="kit-admin-page-header mb-6">
        <h1 class="kit-admin-page-header__title">{{ kit_heading }}</h1>
        <p class="kit-admin-page-header__intro">{{ 'admin.hub.menus'|trans }}</p>
    </header>
    {# panel class applied by _kit_admin_split_filters (search stays outside the card). #}
    <div class="kit-admin" data-kit-split-filters>
{% endblock %}

{% block body_after %}
    {% include 'kit/_kit_admin_split_filters.html.twig' %}
    </div>
    {# Bundle base nests modals in nowo_dashboard_menu_content; that block is not rendered
       when the host wraps `{% block body %}` via body_before/after — include once here. #}
    {% include '@NowoDashboardMenuBundle/dashboard/_menu_dashboard_modals.html.twig' %}
{% endblock %}

