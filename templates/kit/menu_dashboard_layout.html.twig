{# Beacon host layout for dashboard-menu CRUD.
   Bundle pages: @NowoDashboardMenuBundle/dashboard/*.html.twig → base → this shell.
   Do NOT fork dashboard pages — only this layout + CSS so kit upgrades flow in. #}
{% extends 'kit/_kit_admin_layout.html.twig' %}

{% set kit_admin_heading %}{% block dashboard_title %}{{ 'dashboard.title'|trans({}, 'NowoDashboardMenuBundle') }}{% endblock %}{% endset %}
{% set kit_admin_intro = 'admin.hub.menus'|trans %}
{% set kit_admin_css_framework = nowo_dashboard_menu_css_framework|default('tailwind') %}
{% set kit_admin_split_filters = true %}

{% block kit_admin_extra_styles %}
    <style>
        body > .ts-dropdown { z-index: 1060; }
    </style>
{% endblock %}

{% block kit_admin_boot_json %}
    {% set _icon_url = null %}
    {% if icon_selector_script_url is defined and icon_selector_script_url %}
        {% set _icon_url = (icon_selector_script_url starts with 'http') ? icon_selector_script_url : asset(icon_selector_script_url) %}
    {% endif %}
    <script type="application/json" id="beacon-dashboard-menu-boot">{{ {
        iconSelectorScriptUrl: _icon_url,
        cssFramework: nowo_dashboard_menu_css_framework|default('tailwind'),
        i18n: {
            loading: 'dashboard.loading'|trans({}, 'NowoDashboardMenuBundle'),
            errorLoadingForm: 'dashboard.error_loading_form'|trans({}, 'NowoDashboardMenuBundle'),
            deleteMenuConfirm: 'dashboard.delete_menu_confirm'|trans({}, 'NowoDashboardMenuBundle'),
            editItem: 'dashboard.edit_item'|trans({}, 'NowoDashboardMenuBundle'),
            editLabels: 'dashboard.edit_labels'|trans({}, 'NowoDashboardMenuBundle'),
            editTypePositionIcon: 'dashboard.edit_type_position_icon'|trans({}, 'NowoDashboardMenuBundle'),
            editConfig: 'dashboard.edit_config'|trans({}, 'NowoDashboardMenuBundle'),
            editMenu: 'dashboard.edit_menu'|trans({}, 'NowoDashboardMenuBundle'),
            addItem: 'dashboard.add_item'|trans({}, 'NowoDashboardMenuBundle'),
            deleteItemConfirm: 'dashboard.delete_item_confirm'|trans({}, 'NowoDashboardMenuBundle'),
        },
    }|json_encode|raw }}</script>
{% endblock %}

{% block kit_admin_extra_javascripts %}
    {% include 'kit/_kit_modal_body_portals.html.twig' %}
    {% if stimulus_script_url is defined and stimulus_script_url %}
        <script type="module" src="{{ (stimulus_script_url starts with 'http') ? stimulus_script_url : asset(stimulus_script_url) }}"></script>
    {% endif %}
    {% set _icon_url = null %}
    {% if icon_selector_script_url is defined and icon_selector_script_url %}
        {% set _icon_url = (icon_selector_script_url starts with 'http') ? icon_selector_script_url : asset(icon_selector_script_url) %}
    {% endif %}
    {% if _icon_url %}
        <script src="{{ _icon_url }}" defer></script>
    {% endif %}
{% endblock %}

{% block kit_admin_modals %}
    {# Bundle base nests modals in nowo_dashboard_menu_content; that block is not rendered
       when the host wraps `{% block body %}` via body_before/after — include once here. #}
    {% include '@NowoDashboardMenuBundle/dashboard/_menu_dashboard_modals.html.twig' %}
{% endblock %}
