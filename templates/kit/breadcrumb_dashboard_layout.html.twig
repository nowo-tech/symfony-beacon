{# Beacon host layout for breadcrumb-kit CRUD.
   Bundle pages: @NowoBreadcrumbKitBundle/dashboard/*.html.twig → base → this shell.
   Do NOT fork dashboard pages — only this layout + CSS so kit upgrades flow in.

   Twig note: kit pages also define `{% block body %}`, so wrap with body_before/after.
   Restyle with kit/_kit_admin_styles (.kit-admin .nowo-ui-*). #}
{% extends 'base.html.twig' %}
{% trans_default_domain 'NowoBreadcrumbKitBundle' %}

{% set kit_heading %}{% block dashboard_title %}{{ 'nav.breadcrumbs'|trans({}, 'messages') }}{% endblock %}{% endset %}

{% block title %}{{ kit_heading|striptags|trim }} — {{ site_appearance.brandName }}{% endblock %}


{% block stylesheets %}
    {{ parent() }}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    {# Load before vendor nowo-ui.css append; .kit-admin .nowo-ui-* specificity still wins. #}
    {% include 'kit/_kit_admin_styles.html.twig' %}
    <style>
        body > .ts-dropdown { z-index: 1060; }
    </style>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    {% include 'kit/_kit_modal_body_portals.html.twig' %}
    <script>
    window.breadcrumbKitI18n = {
        loading: {{ 'dashboard.loading'|trans|json_encode|raw }},
        errorLoadingForm: {{ 'dashboard.error_loading_form'|trans|json_encode|raw }},
        defaultCollectionModalTitle: {{ 'dashboard.collection_modal_title'|trans|json_encode|raw }},
        defaultItemModalTitle: {{ 'dashboard.item_modal_title'|trans|json_encode|raw }},
        deleteCollectionConfirm: {{ 'dashboard.delete_collection_confirm'|trans|json_encode|raw }},
        deleteItemConfirm: {{ 'dashboard.delete_item_confirm'|trans|json_encode|raw }}
    };
    window.__breadcrumbKitDashboard = window.__breadcrumbKitDashboard || {};
    {% set _bk_dr = dashboard_routes|default({}) %}
    window.__breadcrumbKitDashboard.cssFramework = {{ (nowo_breadcrumb_kit_css_framework|default('bootstrap5'))|json_encode|raw }};
    window.__breadcrumbKitDashboard.importPartialUrl = {{ (path(_bk_dr.import|default('nowo_breadcrumb_kit_dashboard_import')) ~ '?_partial=1')|json_encode|raw }};
    window.__breadcrumbKitDashboard.dashboardBase = {{ path(_bk_dr.collections_index|default('nowo_breadcrumb_kit_dashboard_collections_index'))|json_encode|raw }};
    </script>
{% endblock %}

{% block body_before %}
    <header class="kit-admin-page-header mb-6">
        <h1 class="kit-admin-page-header__title">{{ kit_heading }}</h1>
        <p class="kit-admin-page-header__intro">{{ 'admin.hub.breadcrumbs'|trans }}</p>
    </header>
    {# panel class applied by _kit_admin_split_filters (search stays outside the card). #}
    <div class="kit-admin" data-kit-split-filters>
{% endblock %}

{% block body_after %}
    {% include 'kit/_kit_admin_split_filters.html.twig' %}
    </div>
    {% include '@NowoBreadcrumbKitBundle/dashboard/_dashboard_modals.html.twig' %}
{% endblock %}

