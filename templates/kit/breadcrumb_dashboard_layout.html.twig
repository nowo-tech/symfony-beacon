{# Beacon host layout for breadcrumb-kit CRUD.
   Bundle pages: @NowoBreadcrumbKitBundle/dashboard/*.html.twig → base → this shell.
   Host forks: collection/item index (Menus chrome + text row actions). #}
{% extends 'kit/_kit_admin_layout.html.twig' %}
{% trans_default_domain 'NowoBreadcrumbKitBundle' %}

{% set kit_admin_heading %}{% block dashboard_title %}{{ 'nav.breadcrumbs'|trans({}, 'messages') }}{% endblock %}{% endset %}
{% set kit_admin_intro = 'admin.hub.breadcrumbs'|trans({}, 'messages') %}
{% set kit_admin_css_framework = nowo_breadcrumb_kit_css_framework|default('tailwind') %}
{# Explicit panel.nowo-ui-table-wrap in dashboard pages (Cookie Consent pattern); no JS split. #}

{% block kit_admin_extra_styles %}
    <style{% if csp_nonce() %} nonce="{{ csp_nonce() }}"{% endif %}>
        body > .ts-dropdown { z-index: 1060; }
    </style>
{% endblock %}

{% block kit_admin_boot_json %}
    {% set _bk_dr = dashboard_routes|default({}) %}
    <script type="application/json" id="beacon-breadcrumb-kit-boot">{{ {
        cssFramework: nowo_breadcrumb_kit_css_framework|default('tailwind'),
        importPartialUrl: path(_bk_dr.import|default('nowo_breadcrumb_kit_dashboard_import')) ~ '?_partial=1',
        dashboardBase: path(_bk_dr.collections_index|default('nowo_breadcrumb_kit_dashboard_collections_index')),
        i18n: {
            loading: 'dashboard.loading'|trans,
            errorLoadingForm: 'dashboard.error_loading_form'|trans,
            defaultCollectionModalTitle: 'dashboard.collection_modal_title'|trans,
            defaultItemModalTitle: 'dashboard.item_modal_title'|trans,
            deleteCollectionConfirm: 'dashboard.delete_collection_confirm'|trans,
            deleteItemConfirm: 'dashboard.delete_item_confirm'|trans,
        },
    }|json_encode|raw }}</script>
{% endblock %}

{% block kit_admin_extra_javascripts %}
    {% include 'kit/_kit_modal_body_portals.html.twig' %}
{% endblock %}

{% block kit_admin_modals %}
    {% include '@NowoBreadcrumbKitBundle/dashboard/_dashboard_modals.html.twig' %}
    {% include 'kit/_kit_config_boot.html.twig' %}
{% endblock %}
