{# Friendly SiteBackup token gate — host chrome (REQ-SETUP-009).
   Primary action: paste token. How-to steps stay behind a disclosure. #}
{% extends nowo_site_backup_setup_layout_template %}

{% set token_example = pathPrefix ~ '?token=…' %}

{% block title %}{{ brandName|default(site_appearance.brandName|default('Beacon')) }} — {{ 'setup.token.title'|trans }}{% endblock %}

{% block nowo_site_backup_content %}
<div class="setup-token-gate" data-testid="setup-token-gate">
    <div class="setup-token-gate__art">
        <img
            class="setup-token-gate__img"
            src="{{ asset('illustrations/error-403.png') }}"
            width="1024"
            height="682"
            alt="{{ 'error.403.image_alt'|trans }}"
            decoding="async"
        >
    </div>

    <h1 class="setup-token-gate__title">{{ 'setup.token.title'|trans }}</h1>
    <p class="setup-token-gate__lead">{{ 'setup.token.lead'|trans }}</p>

    <div class="setup-token-gate__panel">
        {% set token_form = get_filter_form(
            'App\\Setup\\Form\\SetupTokenGateType',
            {token: app.request.query.get('token', '')},
            {
                action: pathPrefix,
                method: 'GET',
            }
        ) %}
        {% form_theme token_form with ['form/beacon_theme.html.twig'] %}
        {{ form_start(token_form, {attr: {class: 'setup-token-gate__form'}}) }}
            <label for="setup-token">{{ 'setup.token.field_label'|trans }}</label>
            <div class="setup-token-gate__row">
                {{ form_row(token_form.token, {
                    attr: {
                        placeholder: 'setup.token.field_placeholder'|trans,
                    },
                }) }}
                <button type="submit">{{ 'setup.token.submit'|trans }}</button>
            </div>
            {% include 'form/_fields.html.twig' with {form: token_form} only %}
        {{ form_end(token_form, {render_rest: false}) }}

        <details class="setup-token-gate__howto">
            <summary>{{ 'setup.token.howto'|trans }}</summary>
            <ol class="setup-token-gate__steps">
                <li>{{ 'setup.token.step_env'|trans }}</li>
                <li>{{ 'setup.token.step_url'|trans({'%path%': token_example}) }}</li>
                <li>{{ 'setup.token.step_header'|trans }}</li>
            </ol>
        </details>
    </div>
</div>
{% endblock %}
