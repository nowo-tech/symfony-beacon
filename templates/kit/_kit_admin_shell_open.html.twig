<header class="kit-admin-page-header mb-6 flex flex-wrap items-start justify-between gap-3">
    <div class="min-w-0">
        <h1 class="kit-admin-page-header__title mt-2 font-[family-name:var(--font-display)] text-2xl font-semibold">{% block kit_admin_heading %}{{ kit_admin_heading|default('') }}{% endblock %}</h1>
        <p class="mt-1 text-xs text-[var(--color-ink)]/55">{% block kit_admin_intro %}{{ kit_admin_intro|default('') }}{% endblock %}</p>
    </div>
    {% if kit_admin_header_actions is defined and kit_admin_header_actions|default('')|trim != '' %}
        <div class="kit-admin-page-header__actions flex flex-wrap items-center justify-end gap-2">
            {{ kit_admin_header_actions|raw }}
        </div>
    {% endif %}
</header>
{# panel class applied by kit-admin.ts (search stays outside the card) when data-kit-split-filters is set. #}
<div
    class="kit-admin{{ kit_admin_wrapper_class|default('') }}"
    {% block kit_admin_wrapper_attrs %}
        {% if kit_admin_css_framework is defined %}data-css-framework="{{ kit_admin_css_framework }}"{% endif %}
        {% if kit_admin_data_testid is defined %}data-testid="{{ kit_admin_data_testid }}"{% endif %}
        {% if kit_admin_split_filters|default(false) %} data-kit-split-filters{% endif %}
    {% endblock %}
>
