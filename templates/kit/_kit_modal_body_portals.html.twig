{#
  Kit modals (.nowo-ui-modal) are portaled to <body> by kit-admin.ts so they escape
  .app-main__inner stacking contexts. Token remap for portaled modals lives in
  _kit_admin_styles.html.twig (.nowo-ui-modal { --nowo-ui-*: … }).
#}
<style>
  body > .nowo-ui-modal,
  body > .modal {
    z-index: 1080;
  }
  body > .modal-backdrop {
    z-index: 1070;
  }
</style>
