{#
  Issue detail event body. Expects `event`.
  Order: Highlights → Query → Stack → Breadcrumbs → Request → Console → Messenger → Scheduler → Monolog → Fatal → Tags → Contexts → Extra → Raw
#}
{% set payload = event.payload %}
{% set exceptionValues = payload.exception.values|default([]) %}
{% set exception = exceptionValues[0]|default(null) %}
{% set queryFacts = beacon_query_facts(payload) %}
{% set frames = exception.stacktrace.frames|default(payload.stacktrace.frames|default([])) %}
{% set breadcrumbs = payload.breadcrumbs.values|default([]) %}
{% set user = payload.user|default(null) %}
{% set runtime = payload.contexts.runtime|default(null) %}
{% set framework = payload.contexts.framework|default(null) %}
{% set os = payload.contexts.os|default(null) %}
{% set request = payload.request|default(payload.contexts.request|default(null)) %}
{% set requestUrl = request.url|default(request.request_uri|default(payload.extra.request_uri|default(null))) %}
{% set requestMethod = request.method|default(request.request_method|default(payload.extra.request_method|default(null))) %}
{% set headers = request.headers|default({}) %}
{% set http = payload.extra.http|default(request|default({})) %}
{% set httpRoute = http.route|default(request.route|default(null)) %}
{% set httpController = http.controller|default(request.controller|default(null)) %}
{% set httpStatus = http.status_code|default(null) %}
{% set httpQueryKeys = http.query_keys|default(request.query_keys|default([])) %}
{% set httpClient = http.client|default(request.client|default(null)) %}
{% set console = payload.extra.console|default({}) %}
{% set consoleCommand = console.command|default(null) %}
{% set consoleCommandClass = console.command_class|default(null) %}
{% set hasConsoleExit = console.exit_code is defined %}
{% set consolePhpSapi = console.php_sapi|default(null) %}
{% set consoleArguments = console.arguments|default({}) %}
{% set consoleOptions = console.options|default({}) %}
{% set consoleMissing = console.missing_arguments|default([]) %}
{% set hasConsole = consoleCommand or consoleCommandClass or hasConsoleExit or consolePhpSapi or consoleArguments or consoleOptions or consoleMissing or console.interactive is defined %}
{% set messenger = payload.extra.messenger|default({}) %}
{% set messengerClass = messenger.message_class|default(null) %}
{% set messengerReceiver = messenger.receiver_name|default(null) %}
{% set hasMessengerRetry = messenger.retry_count is defined %}
{% set messengerBus = messenger.bus|default(null) %}
{% set messengerTransport = messenger.transport|default(null) %}
{% set messengerHandler = messenger.handler_class|default(null) %}
{% set hasMessenger = messengerClass or messengerReceiver or hasMessengerRetry or messengerBus or messengerTransport or messengerHandler %}
{% set scheduler = payload.extra.scheduler|default({}) %}
{% set schedulerName = scheduler.schedule_name|default(null) %}
{% set schedulerRecurring = scheduler.recurring_id|default(null) %}
{% set schedulerTrigger = scheduler.trigger|default(null) %}
{% set hasScheduler = schedulerName or schedulerRecurring or schedulerTrigger %}
{% set monolog = payload.extra.monolog|default(null) %}
{% set monologChannel = monolog is iterable ? monolog.channel|default(null) : (monolog ? 'app' : null) %}
{% set monologLevel = monolog is iterable ? monolog.level|default(null) : null %}
{% set hasMonolog = monologChannel or monologLevel or monolog is same as(true) %}
{% set fatal = payload.extra.fatal|default(null) %}
{% set hasFatal = fatal is iterable and fatal %}
{% set traceId = payload.extra.trace_id|default(payload.tags.trace_id|default(null)) %}
{% set levelLabel = payload.level|default(issue is defined ? issue.level : 'error') %}

{% embed 'issue/_collapse_section.html.twig' with {panel_id: 'highlights', title: 'issues.highlights'|trans} %}
    {% block body %}
        <table class="issue-kv">
            <tbody>
                <tr>
                    <th>{{ 'issues.col.level'|trans }}</th>
                    <td><span class="issue-badge issue-badge--level">{{ levelLabel }}</span></td>
                </tr>
                {% if payload.logger is defined %}
                    <tr>
                        <th>{{ 'issues.logger'|trans }}</th>
                        <td class="font-mono">{{ payload.logger }}</td>
                    </tr>
                {% endif %}
                {% if queryFacts and queryFacts.sqlstate %}
                    <tr>
                        <th>{{ 'issues.query_sqlstate'|trans }}</th>
                        <td class="font-mono" data-testid="issue-query-sqlstate">{{ queryFacts.sqlstate }}</td>
                    </tr>
                {% endif %}
                {% if queryFacts and queryFacts.vendorCode %}
                    <tr>
                        <th>{{ 'issues.query_code'|trans }}</th>
                        <td class="font-mono" data-testid="issue-query-code">{{ queryFacts.vendorCode }}</td>
                    </tr>
                {% endif %}
                {% if payload.server_name is defined %}
                    <tr>
                        <th>{{ 'issues.server_name'|trans }}</th>
                        <td class="font-mono">{{ payload.server_name }}</td>
                    </tr>
                {% endif %}
                {% if requestUrl %}
                    <tr>
                        <th>{{ 'issues.request_url'|trans }}</th>
                        <td class="font-mono break-all">
                            {% if requestMethod %}<span class="issue-badge">{{ requestMethod }}</span> {% endif %}
                            {{ requestUrl }}
                        </td>
                    </tr>
                {% endif %}
                {% if httpRoute %}
                    <tr>
                        <th>{{ 'issues.http_route'|trans }}</th>
                        <td class="font-mono break-all" data-testid="issue-http-route">{{ httpRoute }}</td>
                    </tr>
                {% endif %}
                {% if httpController %}
                    <tr>
                        <th>{{ 'issues.http_controller'|trans }}</th>
                        <td class="font-mono break-all" data-testid="issue-http-controller">{{ httpController }}</td>
                    </tr>
                {% endif %}
                {% if httpStatus %}
                    <tr>
                        <th>{{ 'issues.http_status'|trans }}</th>
                        <td class="font-mono" data-testid="issue-http-status">{{ httpStatus }}</td>
                    </tr>
                {% endif %}
                {% if consoleCommand %}
                    <tr>
                        <th>{{ 'issues.console_command'|trans }}</th>
                        <td class="font-mono break-all" data-testid="issue-console-command">
                            <span class="issue-badge">CLI</span>
                            {{ consoleCommand }}
                        </td>
                    </tr>
                {% endif %}
                {% if consoleMissing is iterable and consoleMissing is not empty %}
                    <tr>
                        <th>{{ 'issues.console_missing_arguments'|trans }}</th>
                        <td class="font-mono" data-testid="issue-console-missing">{{ consoleMissing|join(', ') }}</td>
                    </tr>
                {% endif %}
                {% if messengerClass %}
                    <tr>
                        <th>{{ 'issues.messenger_message'|trans }}</th>
                        <td class="font-mono break-all" data-testid="issue-messenger-message">
                            <span class="issue-badge">Messenger</span>
                            {{ messengerClass }}
                        </td>
                    </tr>
                {% endif %}
                {% if schedulerName or schedulerRecurring %}
                    <tr>
                        <th>{{ 'issues.scheduler'|trans }}</th>
                        <td class="font-mono break-all" data-testid="issue-scheduler">
                            <span class="issue-badge">Scheduler</span>
                            {{ schedulerName|default('—') }}{% if schedulerRecurring %} / {{ schedulerRecurring }}{% endif %}
                        </td>
                    </tr>
                {% endif %}
                {% if monologChannel or hasMonolog %}
                    <tr>
                        <th>{{ 'issues.monolog'|trans }}</th>
                        <td class="font-mono break-all" data-testid="issue-monolog">
                            <span class="issue-badge">Monolog</span>
                            {{ monologChannel|default('app') }}{% if monologLevel %} · {{ monologLevel }}{% endif %}
                        </td>
                    </tr>
                {% endif %}
                {% if hasFatal %}
                    <tr>
                        <th>{{ 'issues.fatal'|trans }}</th>
                        <td class="font-mono break-all" data-testid="issue-fatal">
                            <span class="issue-badge">Fatal</span>
                            {{ fatal.file|default('?') }}:{{ fatal.line|default('?') }}
                        </td>
                    </tr>
                {% endif %}
                {% if traceId %}
                    <tr>
                        <th>{{ 'issues.trace_id'|trans }}</th>
                        <td class="font-mono break-all" data-testid="issue-trace-id">{{ traceId }}</td>
                    </tr>
                {% endif %}
                <tr>
                    <th>{{ 'issues.release'|trans }}</th>
                    <td>{{ event.releaseVersion|default(payload.release|default('common.na'|trans)) }}</td>
                </tr>
                <tr>
                    <th>{{ 'issues.filter.environment'|trans }}</th>
                    <td>{{ event.environment|default(payload.environment|default('common.na'|trans)) }}</td>
                </tr>
                <tr>
                    <th>{{ 'issues.occurred_at'|trans }}</th>
                    <td class="font-mono">{{ event.eventTimestamp|date('Y-m-d H:i:s.u') }} UTC</td>
                </tr>
                <tr>
                    <th>{{ 'issues.received_at'|trans }}</th>
                    <td class="font-mono">{{ event.receivedAt|date('Y-m-d H:i:s.u') }} UTC</td>
                </tr>
                {% if payload.fingerprint is defined and payload.fingerprint %}
                    <tr>
                        <th>{{ 'issues.fingerprint'|trans }}</th>
                        <td class="font-mono text-xs">{{ payload.fingerprint|join(' · ') }}</td>
                    </tr>
                {% endif %}
            </tbody>
        </table>
    {% endblock %}
{% endembed %}

{% if queryFacts %}
{% embed 'issue/_collapse_section.html.twig' with {panel_id: 'query', title: 'issues.query'|trans} %}
    {% block body %}
        <div class="issue-query" data-testid="issue-query">
            <table class="issue-kv">
                <tbody>
                    {% if queryFacts.sqlstate %}
                        <tr>
                            <th>{{ 'issues.query_sqlstate'|trans }}</th>
                            <td class="font-mono" data-testid="issue-query-panel-sqlstate">{{ queryFacts.sqlstate }}</td>
                        </tr>
                    {% endif %}
                    {% if queryFacts.vendorCode %}
                        <tr>
                            <th>{{ 'issues.query_code'|trans }}</th>
                            <td class="font-mono" data-testid="issue-query-panel-code">{{ queryFacts.vendorCode }}</td>
                        </tr>
                    {% endif %}
                    {% if queryFacts.driver %}
                        <tr>
                            <th>{{ 'issues.query_driver'|trans }}</th>
                            <td class="font-mono">{{ queryFacts.driver }}</td>
                        </tr>
                    {% endif %}
                    {% if queryFacts.sqlMode %}
                        <tr>
                            <th>{{ 'issues.query_sql_mode'|trans }}</th>
                            <td class="font-mono">{{ queryFacts.sqlMode }}</td>
                        </tr>
                    {% endif %}
                </tbody>
            </table>
            {% if queryFacts.sql %}
                <h3 class="issue-section__subtitle">{{ 'issues.query_sql'|trans }}</h3>
                <div class="issue-query__sql">
                    <span
                        class="issue-stack__copy"
                        data-controller="clipboard-copy"
                        data-clipboard-copy-text-value="{{ queryFacts.sql|e('html_attr') }}"
                        data-clipboard-copy-label-value="{{ 'issues.query_copy_sql'|trans|e('html_attr') }}"
                        data-clipboard-copy-done-label-value="{{ 'issues.path_copied'|trans|e('html_attr') }}"
                    >
                        <button
                            type="button"
                            class="issue-stack__copy-btn"
                            data-action="click->clipboard-copy#copy"
                        >{{ 'issues.query_copy_sql'|trans }}</button>
                    </span>
                    <pre class="code-block" data-testid="issue-query-sql">{{ queryFacts.sql }}</pre>
                    {% if queryFacts.sqlTruncated %}
                        <p class="issue-tags__hint">{{ 'issues.query_truncated'|trans }}</p>
                    {% endif %}
                </div>
            {% endif %}
            {% if queryFacts.bindings is iterable and queryFacts.bindings is not empty %}
                <h3 class="issue-section__subtitle">{{ 'issues.query_bindings'|trans }}</h3>
                <pre class="code-block" data-testid="issue-query-bindings">{{ queryFacts.bindings|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
            {% endif %}
        </div>
    {% endblock %}
{% endembed %}
{% endif %}

{% if frames is not empty or exception %}
{% embed 'issue/_collapse_section.html.twig' with {panel_id: 'stacktrace', title: 'issues.stacktrace'|trans} %}
    {% block body %}
        {% for ex in exceptionValues|default(exception ? [exception] : []) %}
            <div class="issue-exception{% if not loop.first %} mt-4{% endif %}">
                <p class="issue-exception__type font-mono">{{ ex.type|default('common.unknown'|trans) }}</p>
                {% if ex.value is defined and ex.value %}
                    <p class="issue-exception__value">{{ ex.value }}</p>
                {% endif %}
            </div>
            {% set exFrames = beacon_stack_frames(ex.stacktrace.frames|default([])) %}
            {% if exFrames is not empty %}
                {% include 'issue/_stack_frames.html.twig' with {display_frames: exFrames} only %}
            {% endif %}
        {% else %}
            {% if payload.message is defined and payload.message %}
                <p class="issue-exception__value mb-3">{{ payload.message }}</p>
            {% endif %}
            {% set rootFrames = beacon_stack_frames(payload.stacktrace.frames|default([])) %}
            {% if rootFrames is not empty %}
                {% include 'issue/_stack_frames.html.twig' with {display_frames: rootFrames} only %}
            {% endif %}
        {% endfor %}
    {% endblock %}
{% endembed %}
{% elseif payload.message is defined and payload.message %}
{% embed 'issue/_collapse_section.html.twig' with {panel_id: 'message', title: 'issues.message'|trans} %}
    {% block body %}
        <p class="issue-exception__value whitespace-pre-wrap font-mono text-sm">{{ payload.message }}</p>
    {% endblock %}
{% endembed %}
{% endif %}

{% if breadcrumbs is not empty %}
{% embed 'issue/_collapse_section.html.twig' with {panel_id: 'breadcrumbs', title: 'issues.breadcrumbs'|trans} %}
    {% block body %}
        <ol class="issue-crumbs">
            {% for crumb in breadcrumbs %}
                <li class="issue-crumbs__item">
                    <span class="issue-crumbs__time font-mono">{{ crumb.timestamp|default('') }}</span>
                    <span class="issue-badge">{{ crumb.category|default('default') }}</span>
                    {% if crumb.level is defined %}<span class="issue-badge issue-badge--level">{{ crumb.level }}</span>{% endif %}
                    <span class="issue-crumbs__msg">{{ crumb.message|default('') }}</span>
                    {% if crumb.data is defined and crumb.data %}
                        <pre class="code-block issue-crumbs__data">{{ crumb.data|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
                    {% endif %}
                </li>
            {% endfor %}
        </ol>
    {% endblock %}
{% endembed %}
{% endif %}

{% if request or requestUrl %}
{% embed 'issue/_collapse_section.html.twig' with {panel_id: 'request', title: 'issues.request'|trans} %}
    {% block body %}
        <table class="issue-kv">
            <tbody>
                {% if requestMethod %}
                    <tr>
                        <th>{{ 'issues.request_method'|trans }}</th>
                        <td class="font-mono">{{ requestMethod }}</td>
                    </tr>
                {% endif %}
                {% if requestUrl %}
                    <tr>
                        <th>{{ 'issues.request_url'|trans }}</th>
                        <td class="font-mono break-all">{{ requestUrl }}</td>
                    </tr>
                {% endif %}
                {% if request.query_string is defined and request.query_string %}
                    <tr>
                        <th>{{ 'issues.request_query'|trans }}</th>
                        <td class="font-mono break-all">{{ request.query_string }}</td>
                    </tr>
                {% endif %}
                {% if httpRoute %}
                    <tr>
                        <th>{{ 'issues.http_route'|trans }}</th>
                        <td class="font-mono break-all">{{ httpRoute }}</td>
                    </tr>
                {% endif %}
                {% if httpController %}
                    <tr>
                        <th>{{ 'issues.http_controller'|trans }}</th>
                        <td class="font-mono break-all">{{ httpController }}</td>
                    </tr>
                {% endif %}
                {% if httpStatus %}
                    <tr>
                        <th>{{ 'issues.http_status'|trans }}</th>
                        <td class="font-mono">{{ httpStatus }}</td>
                    </tr>
                {% endif %}
                {% if httpQueryKeys is iterable and httpQueryKeys is not empty %}
                    <tr>
                        <th>{{ 'issues.http_query_keys'|trans }}</th>
                        <td class="font-mono">{{ httpQueryKeys|join(', ') }}</td>
                    </tr>
                {% endif %}
                {% if httpClient %}
                    <tr>
                        <th>{{ 'issues.http_client'|trans }}</th>
                        <td class="font-mono break-all">
                            {% if httpClient.ip is defined %}{{ httpClient.ip }}{% endif %}
                            {% if httpClient.user_agent is defined %} · {{ httpClient.user_agent }}{% endif %}
                        </td>
                    </tr>
                {% endif %}
            </tbody>
        </table>
        {% if headers is iterable and headers is not empty %}
            <h3 class="issue-section__subtitle">{{ 'issues.request_headers'|trans }}</h3>
            <table class="issue-kv">
                <tbody>
                    {% for name, value in headers %}
                        <tr>
                            <th class="font-mono">{{ name }}</th>
                            <td class="font-mono break-all text-xs">{{ value is iterable ? value|join(', ') : value }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    {% endblock %}
{% endembed %}
{% endif %}


{% if hasConsole %}
{% embed 'issue/_collapse_section.html.twig' with {panel_id: 'console', title: 'issues.console'|trans} %}
    {% block body %}
        <table class="issue-kv" data-testid="issue-console">
            <tbody>
                {% if consoleCommand %}
                    <tr><th>{{ 'issues.console_command'|trans }}</th><td class="font-mono break-all">{{ consoleCommand }}</td></tr>
                {% endif %}
                {% if consoleCommandClass %}
                    <tr><th>{{ 'issues.console_command_class'|trans }}</th><td class="font-mono break-all">{{ consoleCommandClass }}</td></tr>
                {% endif %}
                {% if hasConsoleExit %}
                    <tr><th>{{ 'issues.console_exit_code'|trans }}</th><td class="font-mono" data-testid="issue-console-exit-code">{{ console.exit_code }}</td></tr>
                {% endif %}
                {% if consolePhpSapi %}
                    <tr><th>{{ 'issues.console_php_sapi'|trans }}</th><td class="font-mono">{{ consolePhpSapi }}</td></tr>
                {% endif %}
                {% if console.interactive is defined %}
                    <tr><th>{{ 'issues.console_interactive'|trans }}</th><td class="font-mono">{{ console.interactive ? 'yes' : 'no' }}</td></tr>
                {% endif %}
                {% if console.verbosity is defined %}
                    <tr><th>{{ 'issues.console_verbosity'|trans }}</th><td class="font-mono">{{ console.verbosity }}</td></tr>
                {% endif %}
                {% if console.cwd is defined %}
                    <tr><th>{{ 'issues.console_cwd'|trans }}</th><td class="font-mono break-all">{{ console.cwd }}</td></tr>
                {% endif %}
                {% if consoleMissing is iterable and consoleMissing is not empty %}
                    <tr><th>{{ 'issues.console_missing_arguments'|trans }}</th><td class="font-mono" data-testid="issue-console-missing-panel">{{ consoleMissing|join(', ') }}</td></tr>
                {% endif %}
            </tbody>
        </table>
        {% if consoleArguments is iterable and consoleArguments is not empty %}
            <h3 class="issue-section__subtitle">{{ 'issues.console_arguments'|trans }}</h3>
            <pre class="code-block" data-testid="issue-console-arguments">{{ consoleArguments|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
        {% endif %}
        {% if consoleOptions is iterable and consoleOptions is not empty %}
            <h3 class="issue-section__subtitle">{{ 'issues.console_options'|trans }}</h3>
            <pre class="code-block" data-testid="issue-console-options">{{ consoleOptions|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
        {% endif %}
    {% endblock %}
{% endembed %}
{% endif %}

{% if hasMessenger %}
{% embed 'issue/_collapse_section.html.twig' with {panel_id: 'messenger', title: 'issues.messenger'|trans} %}
    {% block body %}
        <table class="issue-kv" data-testid="issue-messenger">
            <tbody>
                {% if messengerClass %}<tr><th>{{ 'issues.messenger_message'|trans }}</th><td class="font-mono break-all">{{ messengerClass }}</td></tr>{% endif %}
                {% if messengerHandler %}<tr><th>{{ 'issues.messenger_handler'|trans }}</th><td class="font-mono break-all">{{ messengerHandler }}</td></tr>{% endif %}
                {% if messengerReceiver %}<tr><th>{{ 'issues.messenger_receiver'|trans }}</th><td class="font-mono">{{ messengerReceiver }}</td></tr>{% endif %}
                {% if messengerTransport %}<tr><th>{{ 'issues.messenger_transport'|trans }}</th><td class="font-mono">{{ messengerTransport }}</td></tr>{% endif %}
                {% if hasMessengerRetry %}<tr><th>{{ 'issues.messenger_retry_count'|trans }}</th><td class="font-mono">{{ messenger.retry_count }}</td></tr>{% endif %}
                {% if messengerBus %}<tr><th>{{ 'issues.messenger_bus'|trans }}</th><td class="font-mono">{{ messengerBus }}</td></tr>{% endif %}
                {% if messenger.transport_message_id is defined %}<tr><th>{{ 'issues.messenger_transport_id'|trans }}</th><td class="font-mono break-all">{{ messenger.transport_message_id }}</td></tr>{% endif %}
                {% if messenger.first_failure_at is defined %}<tr><th>{{ 'issues.messenger_first_failure'|trans }}</th><td class="font-mono">{{ messenger.first_failure_at }}</td></tr>{% endif %}
            </tbody>
        </table>
    {% endblock %}
{% endembed %}
{% endif %}

{% if hasScheduler %}
{% embed 'issue/_collapse_section.html.twig' with {panel_id: 'scheduler', title: 'issues.scheduler'|trans} %}
    {% block body %}
        <table class="issue-kv" data-testid="issue-scheduler-panel">
            <tbody>
                {% if schedulerName %}<tr><th>{{ 'issues.scheduler_name'|trans }}</th><td class="font-mono">{{ schedulerName }}</td></tr>{% endif %}
                {% if schedulerRecurring %}<tr><th>{{ 'issues.scheduler_recurring'|trans }}</th><td class="font-mono">{{ schedulerRecurring }}</td></tr>{% endif %}
                {% if schedulerTrigger %}<tr><th>{{ 'issues.scheduler_trigger'|trans }}</th><td class="font-mono break-all">{{ schedulerTrigger }}</td></tr>{% endif %}
                {% if scheduler.triggered_at is defined %}<tr><th>{{ 'issues.scheduler_triggered_at'|trans }}</th><td class="font-mono">{{ scheduler.triggered_at }}</td></tr>{% endif %}
            </tbody>
        </table>
    {% endblock %}
{% endembed %}
{% endif %}

{% if hasMonolog %}
{% embed 'issue/_collapse_section.html.twig' with {panel_id: 'monolog', title: 'issues.monolog'|trans} %}
    {% block body %}
        <table class="issue-kv" data-testid="issue-monolog-panel">
            <tbody>
                {% if monologChannel %}<tr><th>{{ 'issues.monolog_channel'|trans }}</th><td class="font-mono">{{ monologChannel }}</td></tr>{% endif %}
                {% if monologLevel %}<tr><th>{{ 'issues.monolog_level'|trans }}</th><td class="font-mono">{{ monologLevel }}</td></tr>{% endif %}
            </tbody>
        </table>
        {% if payload.extra.context is defined and payload.extra.context %}
            <h3 class="issue-section__subtitle">{{ 'issues.monolog_context'|trans }}</h3>
            <pre class="code-block">{{ payload.extra.context|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
        {% endif %}
    {% endblock %}
{% endembed %}
{% endif %}

{% if hasFatal %}
{% embed 'issue/_collapse_section.html.twig' with {panel_id: 'fatal', title: 'issues.fatal'|trans} %}
    {% block body %}
        <table class="issue-kv" data-testid="issue-fatal-panel">
            <tbody>
                {% if fatal.file is defined %}<tr><th>{{ 'issues.fatal_file'|trans }}</th><td class="font-mono break-all">{{ fatal.file }}</td></tr>{% endif %}
                {% if fatal.line is defined %}<tr><th>{{ 'issues.fatal_line'|trans }}</th><td class="font-mono">{{ fatal.line }}</td></tr>{% endif %}
                {% if fatal.type is defined %}<tr><th>{{ 'issues.fatal_type'|trans }}</th><td class="font-mono">{{ fatal.type }}</td></tr>{% endif %}
            </tbody>
        </table>
    {% endblock %}
{% endembed %}
{% endif %}

{% embed 'issue/_collapse_section.html.twig' with {panel_id: 'tags', title: 'issues.tags'|trans} %}
    {% block body %}
        {% set customTags = payload.tags|default({}) %}
        {% if customTags is iterable and customTags|length > 0 %}
            <h3 class="issue-section__subtitle">{{ 'issues.tags_custom'|trans }}</h3>
            <ul class="issue-tags issue-tags--custom">
                {% for key, value in customTags %}
                    <li>
                        <span class="issue-tags__key">{{ key }}</span>
                        <span class="issue-tags__val">{{ value is iterable ? value|json_encode : value }}</span>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}

        <h3 class="issue-section__subtitle{% if customTags is iterable and customTags|length > 0 %} issue-section__subtitle--spaced{% endif %}">{{ 'issues.tags_system'|trans }}</h3>
        <ul class="issue-tags">
            <li><span class="issue-tags__key">environment</span><span class="issue-tags__val">{{ event.environment|default(payload.environment|default('—')) }}</span></li>
            <li><span class="issue-tags__key">level</span><span class="issue-tags__val">{{ levelLabel }}</span></li>
            <li><span class="issue-tags__key">platform</span><span class="issue-tags__val">{{ event.platform|default(payload.platform|default('php')) }}</span></li>
            {% if event.releaseVersion or payload.release is defined %}
                <li><span class="issue-tags__key">release</span><span class="issue-tags__val">{% if event.releaseVersion %}{{ event.releaseVersion }}{% else %}{{ payload.release }}{% endif %}</span></li>
            {% endif %}
            {% if payload.server_name is defined %}
                <li><span class="issue-tags__key">server_name</span><span class="issue-tags__val">{{ payload.server_name }}</span></li>
            {% endif %}
            {% if traceId %}
                <li><span class="issue-tags__key">trace_id</span><span class="issue-tags__val">{{ traceId }}</span></li>
            {% endif %}
            {% if httpRoute %}
                <li><span class="issue-tags__key">http.route</span><span class="issue-tags__val">{{ httpRoute }}</span></li>
            {% endif %}
            {% if consoleCommand %}
                <li><span class="issue-tags__key">console.command</span><span class="issue-tags__val">{{ consoleCommand }}</span></li>
            {% endif %}
            {% if messengerClass %}
                <li><span class="issue-tags__key">messenger.message_class</span><span class="issue-tags__val">{{ messengerClass }}</span></li>
            {% endif %}
            {% if messengerHandler %}
                <li><span class="issue-tags__key">messenger.handler</span><span class="issue-tags__val">{{ messengerHandler }}</span></li>
            {% endif %}
            {% if schedulerName %}
                <li><span class="issue-tags__key">scheduler.schedule</span><span class="issue-tags__val">{{ schedulerName }}</span></li>
            {% endif %}
            {% if monologChannel %}
                <li><span class="issue-tags__key">monolog.channel</span><span class="issue-tags__val">{{ monologChannel }}</span></li>
            {% endif %}
            {% if hasFatal %}
                <li><span class="issue-tags__key">fatal</span><span class="issue-tags__val">true</span></li>
            {% endif %}
            {% if event.phpVersion or runtime %}
                <li><span class="issue-tags__key">runtime</span><span class="issue-tags__val">php {{ event.phpVersion|default(runtime.version|default('')) }}</span></li>
            {% endif %}
            {% if event.symfonyVersion or framework %}
                <li><span class="issue-tags__key">framework</span><span class="issue-tags__val">symfony {{ event.symfonyVersion|default(framework.version|default('')) }}</span></li>
            {% endif %}
            {% if os %}
                <li><span class="issue-tags__key">os</span><span class="issue-tags__val">{{ os.name|default('?') }}{% if os.version is defined %} {{ os.version }}{% endif %}</span></li>
            {% endif %}
            {% if event.userIdentifier or user %}
                <li><span class="issue-tags__key">user</span><span class="issue-tags__val">{{ event.userIdentifier|default(user.username|default(user.id|default(user.email|default('—')))) }}</span></li>
            {% endif %}
            {% if payload.logger is defined %}
                <li><span class="issue-tags__key">logger</span><span class="issue-tags__val">{{ payload.logger }}</span></li>
            {% endif %}
        </ul>
        <p class="issue-tags__hint">{{ 'issues.tags_hint'|trans }}</p>
    {% endblock %}
{% endembed %}

{% embed 'issue/_collapse_section.html.twig' with {panel_id: 'contexts', title: 'issues.contexts'|trans} %}
    {% block body %}
        <div class="issue-contexts">
            {% if runtime %}
                <div class="issue-contexts__card">
                    <h3>{{ 'issues.context_runtime'|trans }}</h3>
                    <table class="issue-kv issue-kv--compact">
                        <tr><th>name</th><td>{{ runtime.name|default('php') }}</td></tr>
                        <tr><th>version</th><td>{{ runtime.version|default(event.phpVersion|default('—')) }}</td></tr>
                    </table>
                </div>
            {% endif %}
            {% if framework %}
                <div class="issue-contexts__card">
                    <h3>{{ 'issues.context_framework'|trans }}</h3>
                    <table class="issue-kv issue-kv--compact">
                        <tr><th>name</th><td>{{ framework.name|default('symfony') }}</td></tr>
                        <tr><th>version</th><td>{{ framework.version|default(event.symfonyVersion|default('—')) }}</td></tr>
                    </table>
                </div>
            {% endif %}
            {% if os %}
                <div class="issue-contexts__card">
                    <h3>{{ 'issues.os'|trans }}</h3>
                    <table class="issue-kv issue-kv--compact">
                        <tr><th>name</th><td>{{ os.name|default('—') }}</td></tr>
                        {% if os.version is defined %}<tr><th>version</th><td>{{ os.version }}</td></tr>{% endif %}
                    </table>
                </div>
            {% endif %}
            {% if user or event.userIdentifier %}
                <div class="issue-contexts__card">
                    <h3>{{ 'issues.user'|trans }}</h3>
                    <table class="issue-kv issue-kv--compact">
                        {% if user.id is defined %}<tr><th>id</th><td>{{ user.id }}</td></tr>{% endif %}
                        {% if user.username is defined %}<tr><th>username</th><td>{{ user.username }}</td></tr>{% endif %}
                        {% if user.email is defined %}<tr><th>email</th><td>{{ user.email }}</td></tr>{% endif %}
                        {% if not user and event.userIdentifier %}<tr><th>id</th><td>{{ event.userIdentifier }}</td></tr>{% endif %}
                    </table>
                </div>
            {% endif %}
            {% if not runtime and not framework and not os and not user and not event.userIdentifier %}
                <p class="text-sm text-[var(--color-ink)]/55">{{ 'common.na'|trans }}</p>
            {% endif %}
        </div>
    {% endblock %}
{% endembed %}

{% if payload.extra is defined and payload.extra %}
{% embed 'issue/_collapse_section.html.twig' with {panel_id: 'extra', title: 'issues.extra'|trans} %}
    {% block body %}
        <pre class="code-block">{{ payload.extra|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
    {% endblock %}
{% endembed %}
{% endif %}

{% embed 'issue/_collapse_section.html.twig' with {panel_id: 'raw', title: 'issues.raw_payload'|trans} %}
    {% block body %}
        <pre class="code-block">{{ payload|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
    {% endblock %}
{% endembed %}
