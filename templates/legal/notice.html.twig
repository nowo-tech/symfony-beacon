{% extends 'legal/layout.html.twig' %}

{% block title %}{{ 'legal.notice.title'|trans }} — {{ site_appearance.brandName }}{% endblock %}

{% block legal_body %}
<article class="legal-doc prose-legal">
    <h1>{{ 'legal.notice.title'|trans }}</h1>
    <p class="legal-doc__meta">{{ 'legal.last_updated'|trans({'%date%': '2026-09-18'}) }}</p>

    <p>{{ 'legal.notice.intro'|trans({'%brand%': site_appearance.brandName}) }}</p>

    <h2>{{ 'legal.notice.publisher_heading'|trans }}</h2>
    <p>{{ 'legal.notice.publisher_body'|trans }}</p>
    <ul>
        <li>{{ 'legal.identity.name_line'|trans }}</li>
        <li>{{ 'legal.identity.tax_line'|trans }}</li>
        <li>{{ 'legal.identity.address_line'|trans }}</li>
        <li>{{ 'legal.identity.registry_line'|trans }}</li>
        <li>{{ 'legal.identity.contact_line'|trans }}</li>
    </ul>

    <h2>{{ 'legal.notice.lssi_heading'|trans }}</h2>
    <p>{{ 'legal.notice.lssi_body'|trans }}</p>

    <h2>{{ 'legal.notice.self_host_heading'|trans }}</h2>
    <p>{{ 'legal.notice.self_host_body'|trans }}</p>

    <h2>{{ 'legal.notice.hosting_heading'|trans }}</h2>
    <p>{{ 'legal.notice.hosting_body'|trans }}</p>

    <h2>{{ 'legal.notice.ip_heading'|trans }}</h2>
    <p>{{ 'legal.notice.ip_body'|trans }}</p>

    <h2>{{ 'legal.notice.liability_heading'|trans }}</h2>
    <p>{{ 'legal.notice.liability_body'|trans }}</p>

    <h2>{{ 'legal.notice.law_heading'|trans }}</h2>
    <p>{{ 'legal.notice.law_body'|trans }}</p>

    {% include 'legal/_nav.html.twig' with {current: 'notice'} only %}
</article>
{% endblock %}
