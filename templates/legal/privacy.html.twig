{% extends 'legal/layout.html.twig' %}

{% block title %}{{ 'legal.privacy.title'|trans }} — {{ site_appearance.brandName }}{% endblock %}

{% block legal_body %}
<article class="legal-doc prose-legal">
    <h1>{{ 'legal.privacy.title'|trans }}</h1>
    <p class="legal-doc__meta">{{ 'legal.last_updated'|trans({'%date%': '2026-09-18'}) }}</p>

    <p>{{ 'legal.privacy.intro'|trans({'%brand%': site_appearance.brandName}) }}</p>

    <h2>{{ 'legal.privacy.controller_heading'|trans }}</h2>
    <p>{{ 'legal.privacy.controller_body'|trans }}</p>
    <ul>
        <li>{{ 'legal.identity.name_line'|trans }}</li>
        <li>{{ 'legal.identity.tax_line'|trans }}</li>
        <li>{{ 'legal.identity.address_line'|trans }}</li>
        <li>{{ 'legal.identity.contact_line'|trans }}</li>
    </ul>
    <p>{{ 'legal.privacy.controller_self_host'|trans }}</p>

    <h2>{{ 'legal.privacy.data_heading'|trans }}</h2>
    <p>{{ 'legal.privacy.data_body'|trans }}</p>
    <ul>
        <li>{{ 'legal.privacy.data_account'|trans }}</li>
        <li>{{ 'legal.privacy.data_telemetry'|trans }}</li>
        <li>{{ 'legal.privacy.data_security'|trans }}</li>
        <li>{{ 'legal.privacy.data_logs'|trans }}</li>
        <li>{{ 'legal.privacy.data_cookies'|trans }}</li>
    </ul>

    <h2>{{ 'legal.privacy.purpose_heading'|trans }}</h2>
    <p>{{ 'legal.privacy.purpose_body'|trans }}</p>

    <h2>{{ 'legal.privacy.basis_heading'|trans }}</h2>
    <ul>
        <li>{{ 'legal.privacy.basis_contract'|trans }}</li>
        <li>{{ 'legal.privacy.basis_legitimate'|trans }}</li>
        <li>{{ 'legal.privacy.basis_consent'|trans }}</li>
        <li>{{ 'legal.privacy.basis_legal'|trans }}</li>
    </ul>

    <h2>{{ 'legal.privacy.recipients_heading'|trans }}</h2>
    <p>{{ 'legal.privacy.recipients_body'|trans }}</p>

    <h2>{{ 'legal.privacy.transfers_heading'|trans }}</h2>
    <p>{{ 'legal.privacy.transfers_body'|trans }}</p>

    <h2>{{ 'legal.privacy.retention_heading'|trans }}</h2>
    <ul>
        <li>{{ 'legal.privacy.retention_account'|trans }}</li>
        <li>{{ 'legal.privacy.retention_telemetry'|trans }}</li>
        <li>{{ 'legal.privacy.retention_cookies'|trans }}</li>
        <li>{{ 'legal.privacy.retention_logs'|trans }}</li>
    </ul>

    <h2>{{ 'legal.privacy.rights_heading'|trans }}</h2>
    <p>{{ 'legal.privacy.rights_body'|trans }}</p>

    <h2>{{ 'legal.privacy.authority_heading'|trans }}</h2>
    <p>{{ 'legal.privacy.authority_body'|trans }}</p>

    <h2>{{ 'legal.privacy.automated_heading'|trans }}</h2>
    <p>{{ 'legal.privacy.automated_body'|trans }}</p>

    <h2>{{ 'legal.privacy.cookies_heading'|trans }}</h2>
    <p>{{ 'legal.privacy.cookies_body'|trans }}</p>
    <p>
        <a href="{{ path('legal_cookies', {_locale: app.request.locale|default(default_locale)}) }}">{{ 'legal.cookies.title'|trans }}</a>
        ·
        <a href="#" data-nowo-open-consent>{{ 'legal.manage_cookies'|trans }}</a>
    </p>

    {% include 'legal/_nav.html.twig' with {current: 'privacy'} only %}
</article>
{% endblock %}
