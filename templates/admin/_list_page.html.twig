{#
    Shared shell for admin index/list pages: header, search form, table panel.

    Blocks: header_actions, search_extras, table_head, table_body, after_table.
#}
<div class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <div>
        <h1 class="font-[family-name:var(--font-display)] text-2xl font-semibold">{{ title|trans }}</h1>
        <p class="mt-1 text-xs text-[var(--color-ink)]/55">{{ intro|trans }}</p>
    </div>
    {% block header_actions %}
        {% if create_route is defined %}
            <a class="btn-primary no-underline" href="{{ path(create_route) }}">{{ create_label|trans }}</a>
        {% endif %}
    {% endblock %}
</div>

{{ form_start(searchForm, {attr: {class: 'mb-4 flex flex-wrap items-end gap-2'}}) }}
    {# Translate once here — AdminSearchType sets translation_domain: false on q. #}
    {% for field in searchForm %}
        {% if not field.rendered and 'hidden' not in field.vars.block_prefixes %}
            {{ form_row(field, {
                label: false,
                attr: {
                    class: 'input min-w-56 flex-1',
                    placeholder: search_placeholder|trans,
                    autocomplete: 'off',
                },
                row_attr: {class: 'grow min-w-56'},
            }) }}
        {% endif %}
    {% endfor %}
    {% block search_extras %}{% endblock %}
    <button class="btn-ghost" type="submit">{{ 'common.filter'|trans }}</button>
    <a class="btn-ghost no-underline" href="{{ path(search_route) }}">{{ 'common.clear_filters'|trans }}</a>
    {% include 'form/_fields.html.twig' with {form: searchForm} only %}
{{ form_end(searchForm, {render_rest: false}) }}

<section class="panel overflow-x-auto">
    <table class="w-full text-left text-sm">
        {% block table_head %}{% endblock %}
        {% block table_body %}{% endblock %}
    </table>
</section>

{% if pagination is defined and pagination.total > 0 %}
    {% include 'shared/_table_pagination.html.twig' with {
        pagination: pagination,
        item_count: pagination.total > pagination.offset ? min(pagination.per_page, pagination.total - pagination.offset) : 0,
        route: search_route,
        query: q is defined and q is not empty ? {q: q} : {},
        nav_label: 'pagination.nav'
    } only %}
{% endif %}

{% block after_table %}{% endblock %}
