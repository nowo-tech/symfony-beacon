{#
    Shared shell for admin index/list pages: header, search form, table panel.

    Blocks: header_actions, search_extras, table_head, table_body, after_table.
#}
<div class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <div>
        <h1 class="font-[family-name:var(--font-display)] text-2xl font-semibold">{{ title|trans }}</h1>
        <p class="mt-1 text-xs text-[var(--color-ink)]/55">{{ intro|trans }}</p>
    </div>
    {% block header_actions %}
        {% if create_route is defined %}
            <a class="btn-primary no-underline" href="{{ path(create_route) }}">{{ create_label|trans }}</a>
        {% endif %}
    {% endblock %}
</div>

{{ form_start(searchForm, {attr: {class: 'mb-4 flex flex-wrap gap-2'}}) }}
    {{ form_widget(searchForm.q, {
        attr: {
            class: 'input min-w-56 flex-1',
            placeholder: search_placeholder|trans,
            autocomplete: 'off'
        }
    }) }}
    {% block search_extras %}{% endblock %}
    <button class="btn-ghost" type="submit">{{ 'common.filter'|trans }}</button>
    <a class="btn-ghost no-underline" href="{{ path(search_route) }}">{{ 'common.clear_filters'|trans }}</a>
{{ form_end(searchForm, {render_rest: false}) }}

<section class="panel overflow-x-auto">
    <table class="w-full text-left text-sm">
        {% block table_head %}{% endblock %}
        {% block table_body %}{% endblock %}
    </table>
</section>

{% block after_table %}{% endblock %}
