{% extends 'base.html.twig' %}

{% block title %}{{ 'legal.admin.title'|trans }} — {{ site_appearance.brandName }}{% endblock %}

{% block body %}
<div class="mb-6">
    <h1 class="font-[family-name:var(--font-display)] text-2xl font-semibold">{{ 'legal.admin.title'|trans }}</h1>
    <p class="mt-1 max-w-3xl text-sm text-[var(--color-ink)]/70">{{ 'legal.admin.intro'|trans }}</p>
</div>

<div class="flex flex-col gap-6">
    {% for slug in slugs %}
        <section class="panel">
            <h2 class="text-lg font-semibold">{{ ('legal.' ~ slug ~ '.title')|trans }}</h2>
            <ul class="mt-3 flex flex-wrap gap-2">
                {% for locale in locales %}
                    <li>
                        <a class="btn-ghost no-underline" href="{{ path('admin_legal_edit', {slug: slug, locale: locale}) }}">
                            {{ locale }}
                            <span class="text-[var(--color-ink)]/55">
                                — {{ (custom[slug][locale]|default(false) ? 'legal.admin.custom' : 'legal.admin.builtin')|trans }}
                            </span>
                        </a>
                    </li>
                {% endfor %}
            </ul>
        </section>
    {% endfor %}
</div>
{% endblock %}
