{% extends 'base.html.twig' %}

{% block title %}{{ is_edit ? 'groups.edit_title'|trans : 'groups.create'|trans }} — {{ site_appearance.brandName }}{% endblock %}

{% block body %}
<div class="mb-6">
    <h1 class="font-[family-name:var(--font-display)] text-3xl font-bold">{{ is_edit ? 'groups.edit_title'|trans : 'groups.create'|trans }}</h1>
</div>

{% include 'admin/_crud_form.html.twig' with {
    form: form,
    submit_label: is_edit ? 'groups.save' : 'groups.create',
    cancel_href: is_edit ? path('admin_groups_show', {id: group.uuid}) : path('admin_groups'),
    cancel_label: 'groups.cancel',
} only %}

{% if is_edit and group %}
    <section class="panel mt-6 max-w-xl">
        <h2 class="mb-3 text-lg font-semibold">{{ 'common.audit.title'|trans }}</h2>
        {% include 'shared/_audit_meta.html.twig' with {entity: group, class: 'sm:grid-cols-2'} only %}
    </section>
{% endif %}
{% endblock %}
