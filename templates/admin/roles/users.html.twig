{% extends 'base.html.twig' %}

{% block title %}{{ 'roles.users_title'|trans }} — {{ role|rbac_role_name }}{% endblock %}

{% block body %}
{% include 'admin/roles/_header.html.twig' %}
{% include 'admin/roles/_tabs.html.twig' %}

<section class="panel" data-testid="admin-role-users">
    <h2 class="mb-3 text-lg font-semibold">{{ 'roles.users_title'|trans }}</h2>
    <ul class="space-y-2 text-sm">
        {% for user in role.users %}
            <li class="flex flex-wrap items-center justify-between gap-2 border-b border-[var(--color-sand)] py-2 last:border-0">
                <div>
                    <div class="font-medium">{{ user.displayName }}</div>
                    <div class="text-xs text-[var(--color-ink)]/55">{{ user.email }}</div>
                </div>
                {{ form_start(removeUserForms[user.id]) }}
                    <button class="btn-ghost" type="submit">{{ 'roles.remove_user'|trans }}</button>
                {{ form_end(removeUserForms[user.id]) }}
            </li>
        {% else %}
            <li class="text-[var(--color-ink)]/55">{{ 'roles.users_empty'|trans }}</li>
        {% endfor %}
    </ul>

    {{ form_start(addUserForm, {attr: {class: 'mt-4 flex flex-wrap gap-2'}}) }}
        {{ form_widget(addUserForm.email, {
            attr: {
                class: 'input min-w-56 flex-1',
                placeholder: 'roles.user_email_placeholder'|trans,
                autocomplete: 'off',
            }
        }) }}
        <button class="btn-primary" type="submit">{{ 'roles.add_user'|trans }}</button>
    {{ form_end(addUserForm) }}
    <p class="mt-2 text-xs text-[var(--color-ink)]/55">{{ 'roles.add_user_help'|trans }}</p>
</section>
{% endblock %}
