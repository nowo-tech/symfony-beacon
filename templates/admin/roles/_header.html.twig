{# Shared instance role header (title + edit modal / delete). #}
{% set role_return_route = return_route|default(app.request.attributes.get('_route')) %}
{% if role_return_route not in ['admin_roles_show', 'admin_roles_users', 'admin_roles_permissions'] %}
    {% set role_return_route = 'admin_roles_show' %}
{% endif %}
<div class="mb-6 flex flex-wrap items-start justify-between gap-3">
    <div>
        <a href="{{ path('admin_roles') }}" class="text-sm no-underline">{{ 'roles.back'|trans }}</a>
        <h1 class="mt-2 font-[family-name:var(--font-display)] text-3xl font-bold">{{ role|rbac_role_name }}</h1>
    </div>
    <div class="flex flex-wrap gap-2">
        {% if editForm is defined %}
            {% embed 'shared/_confirm_dialog.html.twig' with {
                custom_form: true,
                dialog_modifier: 'confirm-dialog--md',
                open_on_connect: open_edit|default(false),
                aria_labelledby: 'role-edit-dialog-title',
            } %}
                {% block trigger %}
                    <button
                        type="button"
                        class="btn-ghost"
                        data-action="confirm-dialog#open"
                        data-testid="admin-role-edit"
                    >{{ 'roles.edit'|trans }}</button>
                {% endblock %}
                {% block form %}
                    {{ form_start(editForm, {attr: {class: 'confirm-dialog__panel'}}) }}
                        <input type="hidden" name="_return" value="{{ role_return_route }}">
                        <div class="confirm-dialog__header">
                            <h2 id="role-edit-dialog-title" class="confirm-dialog__title">{{ 'roles.edit_title'|trans }}</h2>
                            <p class="confirm-dialog__body">{{ 'roles.form_intro'|trans }}</p>
                        </div>
                        <div class="confirm-dialog__content">
                            {% include 'admin/roles/_form_fields.html.twig' with {form: editForm} only %}
                        </div>
                        <div class="confirm-dialog__actions">
                            <button type="button" class="btn-ghost" data-confirm-dialog-close>{{ 'roles.cancel'|trans }}</button>
                            <button class="btn-primary" type="submit">{{ 'roles.save'|trans }}</button>
                        </div>
                    {{ form_end(editForm) }}
                {% endblock %}
            {% endembed %}
        {% endif %}
        {% if not role.system %}
            <form
                method="post"
                action="{{ path('admin_roles_delete', {id: role.uuid}) }}"
                data-controller="confirm-submit"
                data-confirm-submit-message-value="{{ 'roles.delete_confirm'|trans|e('html_attr') }}"
                data-action="submit->confirm-submit#confirm"
            >
                <input type="hidden" name="_token" value="{{ csrf_token('admin_instance_role_delete_' ~ role.id) }}">
                <button class="btn-danger" type="submit">{{ 'roles.delete'|trans }}</button>
            </form>
        {% endif %}
    </div>
</div>
