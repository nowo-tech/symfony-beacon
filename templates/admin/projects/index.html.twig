{% extends 'base.html.twig' %}

{% block title %}{{ 'admin_projects.title'|trans }} — {{ site_appearance.brandName }}{% endblock %}

{% block body %}
{% embed 'admin/_list_page.html.twig' with {
    title: 'admin_projects.title',
    intro: 'admin_projects.intro',
    create_route: 'admin_projects_new',
    create_label: 'admin_projects.create',
    search_route: 'admin_projects',
    search_placeholder: 'admin_projects.search_placeholder',
    q: q,
} %}
    {% block table_head %}
        <thead>
            <tr class="border-b border-[var(--color-sand)] text-[var(--color-ink)]/55">
                <th class="px-2 py-2 font-medium">{{ 'admin_projects.col.project'|trans }}</th>
                <th class="px-2 py-2 font-medium">{{ 'admin_projects.col.slug'|trans }}</th>
                <th class="px-2 py-2 font-medium">{{ 'admin_projects.col.members'|trans }}</th>
                <th class="px-2 py-2 font-medium">{{ 'admin_projects.col.groups'|trans }}</th>
                <th class="px-2 py-2 font-medium">{{ 'admin_projects.col.activity'|trans }}</th>
                <th class="px-2 py-2 font-medium">{{ 'admin_projects.col.status'|trans }}</th>
                <th class="px-2 py-2 font-medium">{{ 'admin_projects.col.audit'|trans }}</th>
                <th class="px-2 py-2 font-medium">{{ 'admin_projects.col.actions'|trans }}</th>
            </tr>
        </thead>
    {% endblock %}
    {% block table_body %}
        <tbody>
            {% for project in projects %}
                {% set stats = opsStats[project.id] ?? null %}
                <tr class="row-hover border-b border-[var(--color-sand)]/70 last:border-0">
                    <td class="px-2 py-3">
                        <a class="font-medium no-underline" href="{{ path('admin_projects_show', {id: project.uuid}) }}">{{ project.name }}</a>
                        {% if project.description %}
                            <p class="mt-0.5 line-clamp-2 text-xs text-[var(--color-ink)]/55">{{ project.description }}</p>
                        {% endif %}
                    </td>
                    <td class="px-2 py-3 text-[var(--color-ink)]/75">{{ project.slug }}</td>
                    <td class="px-2 py-3">
                        <span class="badge bg-[var(--color-sand)] text-[var(--color-ink)]/75">
                            {{ 'admin_projects.member_count'|trans({'%count%': access_counts[project.id].members|default(0)}) }}
                        </span>
                    </td>
                    <td class="px-2 py-3">
                        <span class="badge bg-[var(--color-sand)] text-[var(--color-ink)]/75">
                            {{ 'admin_projects.group_count'|trans({'%count%': access_counts[project.id].groups|default(0)}) }}
                        </span>
                    </td>
                    <td class="px-2 py-3 text-[var(--color-ink)]/75">
                        {% if stats %}
                            <div>{{ 'admin_projects.stats_open_issues'|trans({'%count%': stats.open_issues}) }}</div>
                            <div class="text-xs text-[var(--color-ink)]/55">{{ 'admin_projects.stats_events_7d'|trans({'%count%': stats.events_last_7d}) }}</div>
                        {% else %}
                            <span class="text-[var(--color-ink)]/40">{{ 'common.na'|trans }}</span>
                        {% endif %}
                    </td>
                    <td class="px-2 py-3">
                        {% if project.ingestEnabled %}
                            <span class="badge bg-[var(--color-moss)]/15 text-[var(--color-moss)]">{{ 'admin_projects.status.active'|trans }}</span>
                        {% else %}
                            <span class="badge bg-[var(--color-alert)]/15 text-[var(--color-alert)]">{{ 'admin_projects.ingest_suspended_badge'|trans }}</span>
                        {% endif %}
                    </td>
                    <td class="px-2 py-3 align-top">
                        {% include 'shared/_audit_meta.html.twig' with {entity: project} only %}
                    </td>
                    <td class="px-2 py-3">
                        <div class="flex flex-wrap items-center gap-2">
                            <a class="btn-ghost btn-sm no-underline" href="{{ path('admin_projects_show', {id: project.uuid}) }}">{{ 'admin_projects.open'|trans }}</a>
                            <a class="btn-ghost btn-sm no-underline" href="{{ path('project_settings', {id: project.uuid}) }}">{{ 'admin_projects.open_settings'|trans }}</a>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td class="px-2 py-4 text-[var(--color-ink)]/55" colspan="8">{{ 'admin_projects.empty'|trans }}</td>
                </tr>
            {% endfor %}
        </tbody>
    {% endblock %}
{% endembed %}

<section class="panel mt-6">
    <h2 class="mb-2 text-lg font-semibold">{{ 'admin_projects.config.title'|trans }}</h2>
    <p class="mb-3 text-sm text-[var(--color-ink)]/60">{{ 'admin_projects.config.help'|trans }}</p>
    <div class="flex flex-wrap items-center gap-3">
        <a class="btn-ghost no-underline" href="{{ path('admin_projects_export') }}">{{ 'admin_projects.config.export_all'|trans }}</a>
        <form method="post" action="{{ path('admin_projects_import') }}" enctype="multipart/form-data" class="flex flex-wrap items-center gap-2">
            <input type="hidden" name="_token" value="{{ csrf_token('admin_projects_import') }}">
            <input class="input" type="file" name="bundle" accept="application/json,.json" required>
            <button class="btn-primary" type="submit">{{ 'admin_projects.config.import'|trans }}</button>
        </form>
    </div>
    <p class="mt-2 text-xs text-[var(--color-ink)]/55">{{ 'admin_projects.config.note'|trans }}</p>
</section>
{% endblock %}
