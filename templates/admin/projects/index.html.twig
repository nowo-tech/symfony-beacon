{% extends 'base.html.twig' %}

{% block title %}{{ 'admin_projects.title'|trans }} — {{ site_appearance.brandName }}{% endblock %}

{% block body %}
{% embed 'admin/_list_page.html.twig' with {
    title: 'admin_projects.title',
    intro: 'admin_projects.intro',
    create_route: 'admin_projects_new',
    create_label: 'admin_projects.create',
    search_route: 'admin_projects',
    search_placeholder: 'admin_projects.search_placeholder',
    q: q,
} %}
    {% block table_head %}
        <thead>
            <tr class="border-b border-[var(--color-sand)] text-[var(--color-ink)]/55">
                <th class="px-2 py-2 font-medium">{{ 'admin_projects.col.project'|trans }}</th>
                <th class="px-2 py-2 font-medium">{{ 'admin_projects.col.slug'|trans }}</th>
                <th class="px-2 py-2 font-medium">{{ 'admin_projects.col.members'|trans }}</th>
                <th class="px-2 py-2 font-medium">{{ 'admin_projects.col.groups'|trans }}</th>
                <th class="px-2 py-2 font-medium">{{ 'admin_projects.col.activity'|trans }}</th>
                <th class="px-2 py-2 font-medium">{{ 'admin_projects.col.status'|trans }}</th>
                <th class="px-2 py-2 font-medium">{{ 'admin_projects.col.audit'|trans }}</th>
                <th class="px-2 py-2 font-medium">{{ 'admin_projects.col.actions'|trans }}</th>
            </tr>
        </thead>
    {% endblock %}
    {% block table_body %}
        <tbody>
            {% for project in projects %}
                {% set stats = opsStats[project.id] ?? null %}
                <tr class="row-hover border-b border-[var(--color-sand)]/70 last:border-0">
                    <td class="px-2 py-3">
                        <a class="font-medium no-underline" href="{{ path('admin_projects_show', {id: project.uuid}) }}">{{ project.name }}</a>
                        {% if project.description %}
                            <p class="mt-0.5 line-clamp-2 text-xs text-[var(--color-ink)]/55">{{ project.description }}</p>
                        {% endif %}
                    </td>
                    <td class="px-2 py-3 text-[var(--color-ink)]/75">{{ project.slug }}</td>
                    <td class="px-2 py-3">
                        <span class="badge bg-[var(--color-sand)] text-[var(--color-ink)]/75">
                            {{ 'admin_projects.member_count'|trans({'%count%': access_counts[project.id].members|default(0)}) }}
                        </span>
                    </td>
                    <td class="px-2 py-3">
                        <span class="badge bg-[var(--color-sand)] text-[var(--color-ink)]/75">
                            {{ 'admin_projects.group_count'|trans({'%count%': access_counts[project.id].groups|default(0)}) }}
                        </span>
                    </td>
                    <td class="px-2 py-3 text-[var(--color-ink)]/75">
                        {% if stats %}
                            <div>{{ 'admin_projects.stats_open_issues'|trans({'%count%': stats.open_issues}) }}</div>
                            <div class="text-xs text-[var(--color-ink)]/55">{{ 'admin_projects.stats_events_7d'|trans({'%count%': stats.events_last_7d}) }}</div>
                        {% else %}
                            <span class="text-[var(--color-ink)]/40">{{ 'common.na'|trans }}</span>
                        {% endif %}
                    </td>
                    <td class="px-2 py-3">
                        {% if project.ingestEnabled %}
                            <span class="badge bg-[var(--color-moss)]/15 text-[var(--color-moss)]">{{ 'admin_projects.status.active'|trans }}</span>
                        {% else %}
                            <span class="badge bg-[var(--color-alert)]/15 text-[var(--color-alert)]">{{ 'admin_projects.ingest_suspended_badge'|trans }}</span>
                        {% endif %}
                    </td>
                    <td class="px-2 py-3 align-top">
                        {% include 'shared/_audit_meta.html.twig' with {entity: project} only %}
                    </td>
                    <td class="px-2 py-3">
                        <div class="flex flex-wrap items-center gap-2">
                            <a class="btn-ghost btn-sm no-underline" href="{{ path('admin_projects_show', {id: project.uuid}) }}">{{ 'admin_projects.open'|trans }}</a>
                            <a class="btn-ghost btn-sm no-underline" href="{{ path('project_settings', {id: project.uuid}) }}">{{ 'admin_projects.open_settings'|trans }}</a>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td class="px-2 py-4 text-[var(--color-ink)]/55" colspan="8">{{ 'admin_projects.empty'|trans }}</td>
                </tr>
            {% endfor %}
        </tbody>
    {% endblock %}
{% endembed %}

<section class="panel mt-6" data-testid="admin-projects-config-portability">
    <h2 class="mb-2 text-lg font-semibold">{{ 'admin_projects.config.title'|trans }}</h2>
    <p class="mb-3 text-sm text-[var(--color-ink)]/60">{{ 'admin_projects.config.help'|trans }}</p>

    <div
        data-controller="tabs"
        data-tabs-active-tab-value="admin-projects-config-export"
        class="grid gap-3"
    >
        <nav
            role="tablist"
            aria-label="{{ 'admin_projects.config.tabs_label'|trans|e('html_attr') }}"
            class="flex h-auto w-full flex-wrap justify-start gap-1 border-b border-[var(--color-sand)]"
        >
            <button
                type="button"
                id="tab-admin-projects-config-export"
                data-action="click->tabs#open"
                data-tabs-target="trigger"
                data-tab-id="admin-projects-config-export"
                role="tab"
                aria-controls="tab-admin-projects-config-export-panel"
                aria-selected="true"
                data-active
                class="relative inline-flex min-w-10 items-center justify-center px-2.5 py-1.5 text-sm font-medium text-[var(--color-ink)]/55 transition-colors hover:text-[var(--color-ink)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-moss)] data-[active]:text-[var(--color-ink)] data-[active]:after:absolute data-[active]:after:inset-x-0 data-[active]:after:bottom-[-1px] data-[active]:after:h-0.5 data-[active]:after:bg-[var(--color-ink)]"
            >{{ 'admin_projects.config.tab_export'|trans }}</button>
            <button
                type="button"
                id="tab-admin-projects-config-import"
                data-action="click->tabs#open"
                data-tabs-target="trigger"
                data-tab-id="admin-projects-config-import"
                role="tab"
                aria-controls="tab-admin-projects-config-import-panel"
                aria-selected="false"
                class="relative inline-flex min-w-10 items-center justify-center px-2.5 py-1.5 text-sm font-medium text-[var(--color-ink)]/55 transition-colors hover:text-[var(--color-ink)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-moss)] data-[active]:text-[var(--color-ink)] data-[active]:after:absolute data-[active]:after:inset-x-0 data-[active]:after:bottom-[-1px] data-[active]:after:h-0.5 data-[active]:after:bg-[var(--color-ink)]"
            >{{ 'admin_projects.config.tab_import'|trans }}</button>
        </nav>

        <div
            id="tab-admin-projects-config-export-panel"
            data-tabs-target="tab"
            data-tab-id="admin-projects-config-export"
            role="tabpanel"
            aria-labelledby="tab-admin-projects-config-export"
            data-active
            data-state="active"
        >
            <div class="grid gap-3 pt-1">
                <p class="text-sm text-[var(--color-ink)]/60">{{ 'admin_projects.config.export_help'|trans }}</p>
                <div>
                    <a class="btn-primary no-underline" href="{{ path('admin_projects_export') }}" data-testid="admin-projects-config-download">{{ 'admin_projects.config.export_all'|trans }}</a>
                </div>
            </div>
        </div>

        <div
            id="tab-admin-projects-config-import-panel"
            data-tabs-target="tab"
            data-tab-id="admin-projects-config-import"
            role="tabpanel"
            aria-labelledby="tab-admin-projects-config-import"
            data-state="inactive"
            class="hidden"
            hidden
        >
            <div class="grid gap-3 pt-1" data-testid="admin-projects-config-import">
                <p class="text-sm text-[var(--color-ink)]/60">{{ 'admin_projects.config.import_help'|trans }}</p>
                {{ form_start(importForm, {attr: {class: 'grid gap-3 sm:max-w-md', 'data-testid': 'admin-projects-config-import-form'}}) }}
                    <label class="grid gap-1.5">
                        <span class="text-sm font-medium text-[var(--color-ink)]">{{ 'admin_projects.config.file'|trans }}</span>
                        {{ form_widget(importForm.bundle, {attr: {class: 'input', accept: 'application/json,.json', 'data-testid': 'admin-projects-config-file'}}) }}
                    </label>
                    <div>
                        <button class="btn-primary" type="submit" data-testid="admin-projects-config-import-submit">{{ 'admin_projects.config.import'|trans }}</button>
                    </div>
                {{ form_end(importForm) }}
                <p class="text-xs text-[var(--color-ink)]/55">{{ 'admin_projects.config.note'|trans }}</p>
            </div>
        </div>
    </div>
</section>
{% endblock %}
