{% extends 'base.html.twig' %}

{% block title %}{{ project.name }} — {{ 'admin_projects.title'|trans }}{% endblock %}

{% block body %}
<div class="mb-6 flex flex-wrap items-start justify-between gap-3" data-testid="admin-project-show">
    <div>
        <a href="{{ path('admin_projects') }}" class="text-sm no-underline">{{ 'admin_projects.back'|trans }}</a>
        <h1 class="mt-2 font-[family-name:var(--font-display)] text-2xl font-semibold">{{ project.name }}</h1>
        <p class="mt-1 text-xs text-[var(--color-ink)]/55">
            {{ project.slug }}
            {% if project.description %}
                · {{ project.description }}
            {% endif %}
            {% if not project.ingestEnabled %}
                · <span class="text-[var(--color-alert)]">{{ 'admin_projects.ingest_suspended_badge'|trans }}</span>
            {% endif %}
        </p>
    </div>
    <div class="flex flex-wrap gap-2">
        <a class="btn-ghost no-underline" href="{{ path('admin_project_export', {id: project.uuid}) }}" data-testid="admin-project-config-download">{{ 'admin_projects.config.export_one'|trans }}</a>
        <a class="btn-ghost no-underline" href="{{ path('issue_index', {id: project.uuid}) }}">{{ 'admin_projects.open_issues'|trans }}</a>
        <a class="btn-ghost no-underline" href="{{ path('project_settings', {id: project.uuid}) }}">{{ 'admin_projects.open_settings'|trans }}</a>
        <a class="btn-ghost no-underline" href="{{ path('admin_projects_edit', {id: project.uuid}) }}">{{ 'admin_projects.edit'|trans }}</a>
    </div>
</div>

<section class="panel mb-6" data-testid="admin-project-stats">
    <h2 class="mb-3 text-lg font-semibold">{{ 'admin_projects.stats_title'|trans }}</h2>
    <dl class="grid gap-3 text-sm sm:grid-cols-3">
        <div>
            <dt class="text-[var(--color-ink)]/55">{{ 'admin_projects.stats_open_issues_label'|trans }}</dt>
            <dd class="mt-1 text-lg font-semibold">{{ opsStats.open_issues }}</dd>
        </div>
        <div>
            <dt class="text-[var(--color-ink)]/55">{{ 'admin_projects.stats_events_7d_label'|trans }}</dt>
            <dd class="mt-1 text-lg font-semibold">{{ opsStats.events_last_7d }}</dd>
        </div>
        <div>
            <dt class="text-[var(--color-ink)]/55">{{ 'admin_projects.stats_last_ingest_label'|trans }}</dt>
            <dd class="mt-1 text-lg font-semibold">
                {% if opsStats.last_ingest_at %}
                    {{ opsStats.last_ingest_at|date('Y-m-d H:i') }}
                {% else %}
                    {{ 'admin_projects.stats_never'|trans }}
                {% endif %}
            </dd>
        </div>
    </dl>
    {{ form_start(ingestToggleForm, {attr: {class: 'mt-4 flex flex-wrap items-center gap-2'}}) }}
        {% include 'form/_fields.html.twig' with {form: ingestToggleForm} only %}
        {% if project.ingestEnabled %}
            <button class="btn-ghost" type="submit">{{ 'admin_projects.suspend_ingest'|trans }}</button>
            <span class="text-xs text-[var(--color-ink)]/55">{{ 'admin_projects.suspend_ingest_help'|trans }}</span>
        {% else %}
            <button class="btn-primary" type="submit">{{ 'admin_projects.resume_ingest'|trans }}</button>
            <span class="text-xs text-[var(--color-ink)]/55">{{ 'admin_projects.resume_ingest_help'|trans }}</span>
        {% endif %}
    {{ form_end(ingestToggleForm, {render_rest: false}) }}
    {{ form_start(viewAsMemberForm, {attr: {class: 'mt-3'}}) }}
        {% include 'form/_fields.html.twig' with {form: viewAsMemberForm} only %}
        <button class="btn-ghost" type="submit">{{ 'admin_projects.view_as_member'|trans }}</button>
    {{ form_end(viewAsMemberForm, {render_rest: false}) }}
</section>

<section class="panel mb-6">
    <h2 class="mb-3 text-lg font-semibold">{{ 'project.health.title'|trans }}</h2>
    <p class="mb-4 text-sm text-[var(--color-ink)]/65">{{ 'project.health.intro'|trans }}</p>
    <dl class="mb-4 grid gap-3 text-sm sm:grid-cols-2">
        <div>
            <dt class="text-[var(--color-ink)]/55">{{ 'project.health.messenger_pending'|trans }}</dt>
            <dd class="mt-1 font-medium">
                {% if messengerQueue.available %}
                    {{ messengerQueue.pending }}
                    <span class="text-xs font-normal text-[var(--color-ink)]/55">({{ 'project.health.instance_wide'|trans }})</span>
                {% else %}
                    {{ 'project.health.messenger_unavailable'|trans }}
                    — <a href="{{ path('health_ready') }}">{{ 'project.health.ready_link'|trans }}</a>
                {% endif %}
            </dd>
        </div>
        <div>
            <dt class="text-[var(--color-ink)]/55">{{ 'project.health.ready_probe'|trans }}</dt>
            <dd class="mt-1"><a href="{{ path('health_ready') }}">/health/ready</a></dd>
        </div>
    </dl>
    <h3 class="mb-2 text-sm font-semibold">{{ 'project.health.destinations_title'|trans }}</h3>
    {% set destinations = project.notificationDestinations %}
    {% if destinations is empty %}
        <p class="text-sm text-[var(--color-ink)]/55">{{ 'project.health.destinations_empty'|trans }}</p>
    {% else %}
        <ul class="space-y-2 text-sm">
            {% for destination in destinations %}
                <li class="rounded-md border border-[var(--color-sand)] bg-[var(--color-paper)] p-3">
                    <div class="font-medium">{{ destination.label }}</div>
                    <div class="mt-1 text-xs text-[var(--color-ink)]/60">
                        {% if destination.lastDeliveryAt %}
                            {{ 'project.health.last_delivery'|trans }}
                            {{ destination.lastDeliveryAt|date('Y-m-d H:i') }}
                            —
                            {% if destination.lastDeliverySuccess %}
                                <span class="text-emerald-700">{{ 'project.health.delivery_ok'|trans }}</span>
                            {% else %}
                                <span class="text-[var(--color-alert)]">{{ 'project.health.delivery_fail'|trans }}</span>
                                {% if destination.lastDeliveryError %}
                                    · {{ destination.lastDeliveryError }}
                                {% endif %}
                            {% endif %}
                        {% else %}
                            {{ 'project.health.never_delivered'|trans }}
                        {% endif %}
                    </div>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
</section>

<section class="panel mb-6">
    <h2 class="mb-3 text-lg font-semibold">{{ 'admin_projects.members_title'|trans }}</h2>
    <ul class="space-y-2 text-sm">
        {% for member in project.memberships %}
            {% set memberUser = member.user %}
            {% set isOwnerMember = member.role.value == 'owner' %}
            <li class="flex flex-wrap items-start justify-between gap-3 border-b border-[var(--color-sand)] py-2 last:border-0">
                <div class="min-w-0">
                    <div class="font-medium">{{ memberUser.displayName }}</div>
                    <div class="text-xs text-[var(--color-ink)]/55">{{ memberUser.email }}</div>
                    <div class="mt-1">
                        <span class="badge bg-[var(--color-sand)]">{{ ('project.members.role.' ~ member.role.value)|trans }}</span>
                    </div>
                </div>
                {% if not isOwnerMember %}
                <div class="flex shrink-0 flex-wrap items-center gap-2">
                    {{ form_start(memberRoleForms[member.id], {attr: {class: 'flex flex-wrap items-center gap-2'}}) }}
                        {% for field in memberRoleForms[member.id] %}
                            {% if not field.rendered and 'hidden' not in field.vars.block_prefixes %}
                                {{ form_row(field, {label: false, attr: {class: 'input'}}) }}
                            {% endif %}
                        {% endfor %}
                        <button class="btn-ghost" type="submit">{{ 'project.members.update_role'|trans }}</button>
                        {% include 'form/_fields.html.twig' with {form: memberRoleForms[member.id]} only %}
                    {{ form_end(memberRoleForms[member.id], {render_rest: false}) }}
                    {{ form_start(removeMemberForms[member.id], {
                        attr: {
                            'data-controller': 'confirm-submit',
                            'data-confirm-submit-message-value': 'admin_projects.remove_member_confirm'|trans({'%email%': memberUser.email})|e('html_attr'),
                            'data-action': 'submit->confirm-submit#confirm',
                        }
                    }) }}
                        <button class="btn-ghost" type="submit">{{ 'admin_projects.remove_member'|trans }}</button>
                    {{ form_end(removeMemberForms[member.id]) }}
                </div>
                {% endif %}
            </li>
        {% else %}
            <li class="text-[var(--color-ink)]/55">{{ 'admin_projects.members_empty'|trans }}</li>
        {% endfor %}
    </ul>

    {{ form_start(addMemberForm, {attr: {class: 'mt-4 grid gap-2 sm:grid-cols-[1fr_auto_auto]'}}) }}
        {% for field in addMemberForm %}
            {% if not field.rendered and 'hidden' not in field.vars.block_prefixes %}
                {{ form_row(field) }}
            {% endif %}
        {% endfor %}
        <button class="btn-primary" type="submit">{{ 'project.members.add'|trans }}</button>
        {% include 'form/_fields.html.twig' with {form: addMemberForm} only %}
    {{ form_end(addMemberForm, {render_rest: false}) }}
    <p class="mt-2 text-xs text-[var(--color-ink)]/55">{{ 'admin_projects.add_member_help'|trans }}</p>
</section>

<section class="panel mb-6">
    {% include 'admin/_audit_timeline.html.twig' with {
        form_action: path('admin_projects_show', {id: project.uuid}),
        reset_path: path('admin_projects_show', {id: project.uuid}),
        title_key: 'admin_projects.audit_title',
        intro_key: 'admin_projects.audit_intro',
        empty_key: 'admin_projects.audit_empty',
        audit_actions: projectAuditActions,
        audit_filter: projectAuditFilter,
        auditFilterForm: auditFilterForm,
        audit_entries: projectAuditEntries,
        timeline_id: 'project-audit-timeline',
        entry_testid: 'project-audit-entry'
    } only %}
</section>

<section class="panel mb-6">
    <h2 class="mb-1 text-lg font-semibold">{{ 'admin_projects.groups_title'|trans }}</h2>
    <p class="mb-3 text-sm text-[var(--color-ink)]/60">{{ 'admin_projects.groups_intro'|trans }}</p>
    <ul class="space-y-2 text-sm">
        {% for groupAccess in project.groupAccesses %}
            {% set linkedGroup = groupAccess.userGroup %}
            <li class="flex flex-wrap items-start justify-between gap-3 border-b border-[var(--color-sand)] py-2 last:border-0">
                <div class="min-w-0">
                    <a class="font-medium no-underline" href="{{ path('admin_groups_show', {id: linkedGroup.uuid}) }}">{{ linkedGroup.name }}</a>
                    <div class="text-xs text-[var(--color-ink)]/55">{{ 'project.groups.member_count'|trans({'%count%': group_member_counts[linkedGroup.id]|default(0)}) }}</div>
                    <div class="mt-1">
                        <span class="badge bg-[var(--color-sand)]">{{ ('project.members.role.' ~ groupAccess.role.value)|trans }}</span>
                    </div>
                </div>
                <div class="flex shrink-0 flex-wrap items-center gap-2">
                    {{ form_start(groupRoleForms[groupAccess.id], {attr: {class: 'flex flex-wrap items-center gap-2'}}) }}
                        {% for field in groupRoleForms[groupAccess.id] %}
                            {% if not field.rendered and 'hidden' not in field.vars.block_prefixes %}
                                {{ form_row(field, {label: false, attr: {class: 'input'}}) }}
                            {% endif %}
                        {% endfor %}
                        <button class="btn-ghost" type="submit">{{ 'project.members.update_role'|trans }}</button>
                        {% include 'form/_fields.html.twig' with {form: groupRoleForms[groupAccess.id]} only %}
                    {{ form_end(groupRoleForms[groupAccess.id], {render_rest: false}) }}
                    {{ form_start(removeGroupForms[groupAccess.id], {
                        attr: {
                            'data-controller': 'confirm-submit',
                            'data-confirm-submit-message-value': 'admin_projects.unlink_group_confirm'|trans({'%name%': linkedGroup.name})|e('html_attr'),
                            'data-action': 'submit->confirm-submit#confirm',
                        }
                    }) }}
                        <button class="btn-ghost" type="submit">{{ 'project.groups.remove'|trans }}</button>
                    {{ form_end(removeGroupForms[groupAccess.id]) }}
                </div>
            </li>
        {% else %}
            <li class="text-[var(--color-ink)]/55">{{ 'project.groups.empty'|trans }}</li>
        {% endfor %}
    </ul>

    {% if availableGroups is not empty %}
        {{ form_start(addGroupForm, {attr: {class: 'mt-4 grid gap-2 sm:grid-cols-[1fr_auto_auto]'}}) }}
            {% for field in addGroupForm %}
                {% if not field.rendered and 'hidden' not in field.vars.block_prefixes %}
                    {{ form_row(field) }}
                {% endif %}
            {% endfor %}
            <button class="btn-primary" type="submit">{{ 'project.groups.add'|trans }}</button>
            {% include 'form/_fields.html.twig' with {form: addGroupForm} only %}
        {{ form_end(addGroupForm, {render_rest: false}) }}
    {% else %}
        <p class="mt-3 text-xs text-[var(--color-ink)]/55">{{ 'admin_projects.groups_none_available'|trans }}</p>
    {% endif %}
</section>

<section class="panel panel--danger">
    <h2 class="mb-2 text-lg font-semibold text-[var(--color-alert)]">{{ 'admin_projects.danger_title'|trans }}</h2>
    <p class="mb-4 text-sm text-[var(--color-ink)]/65">{{ 'admin_projects.danger_intro'|trans }}</p>
    {% embed 'shared/_confirm_dialog.html.twig' with {
        custom_form: true,
        expected_value: project.name,
        trigger_class: 'btn-danger',
        trigger_label: 'admin_projects.delete_open'|trans,
        title_id: 'admin-project-delete-title-' ~ project.id,
        aria_labelledby: 'admin-project-delete-title-' ~ project.id,
    } %}
        {% block form %}
            {{ form_start(deleteProjectForm, {attr: {class: 'confirm-dialog__panel'}}) }}
                <div class="confirm-dialog__header">
                    <h2 id="admin-project-delete-title-{{ project.id }}" class="confirm-dialog__title">{{ 'project.danger.delete_title'|trans }}</h2>
                    <p class="confirm-dialog__body">{{ 'project.danger.delete_body'|trans({'%name%': project.name}) }}</p>
                </div>
                <div class="confirm-dialog__content">
                    {{ form_row(deleteProjectForm.confirmation, {
                        label: 'project.danger.delete_type_label'|trans({'%name%': project.name}),
                        translation_domain: false,
                    }) }}
                    {% include 'form/_fields.html.twig' with {form: deleteProjectForm} only %}
                </div>
                <div class="confirm-dialog__actions">
                    <button type="button" class="btn-ghost" data-confirm-dialog-close>{{ 'project.danger.cancel'|trans }}</button>
                    <button type="submit" class="btn-danger" data-confirm-dialog-target="submit" disabled>{{ 'project.danger.delete_confirm'|trans }}</button>
                </div>
            {{ form_end(deleteProjectForm, {render_rest: false}) }}
        {% endblock %}
    {% endembed %}
</section>
{% endblock %}
