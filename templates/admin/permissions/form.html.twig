{% extends 'base.html.twig' %}

{% block title %}{{ is_edit ? 'permissions.edit_title'|trans : 'permissions.create'|trans }} — {{ site_appearance.brandName }}{% endblock %}

{% block body %}
<div class="mb-6">
    <h1 class="font-[family-name:var(--font-display)] text-2xl font-semibold">{{ is_edit ? 'permissions.edit_title'|trans : 'permissions.create'|trans }}</h1>
    <p class="mt-1 text-xs text-[var(--color-ink)]/55">{{ 'permissions.form_intro'|trans }}</p>
</div>

{% include 'admin/_crud_form.html.twig' with {
    form: form,
    submit_label: is_edit ? 'permissions.save' : 'permissions.create',
    cancel_href: path('admin_permissions'),
    cancel_label: 'permissions.cancel',
} only %}
{% endblock %}
