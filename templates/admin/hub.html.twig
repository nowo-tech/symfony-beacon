{% extends 'base.html.twig' %}

{% block title %}{{ 'admin.hub.title'|trans }} — {{ site_appearance.brandName }}{% endblock %}

{% block body %}
{% include '_product_tour.html.twig' %}
<div class="mb-6">
    <h1 class="font-[family-name:var(--font-display)] text-3xl font-bold">{{ 'admin.hub.title'|trans }}</h1>
    <p class="mt-1 text-sm text-[var(--color-ink)]/65">{{ 'admin.hub.intro'|trans }}</p>
</div>

{% set hub_sections = [
    {
        heading: 'admin.hub.section.overview',
        tiles: [
            {href: path('admin_ops_overview'), title: 'nav.ops', intro: 'admin.hub.ops', tour: 'admin-ops'},
        ],
    },
    {
        heading: 'admin.hub.section.access',
        tiles: [
            {href: path('admin_users'), title: 'nav.users', intro: 'admin.hub.users', tour: 'admin-users'},
            {href: path('admin_roles'), title: 'nav.roles', intro: 'admin.hub.roles', testid: 'admin-roles'},
            {href: path('admin_permissions'), title: 'nav.permissions', intro: 'admin.hub.permissions', testid: 'admin-permissions'},
            {href: path('admin_groups'), title: 'nav.groups', intro: 'admin.hub.groups'},
            {href: path('admin_projects'), title: 'nav.admin_projects', intro: 'admin.hub.projects', tour: 'admin-projects'},
        ],
    },
    {
        heading: 'admin.hub.section.instance',
        tiles: [
            {href: path('admin_appearance'), title: 'nav.appearance', intro: 'admin.hub.appearance'},
            {href: path('admin_mailer'), title: 'nav.mailer', intro: 'admin.hub.mailer', tour: 'admin-mailer'},
            {href: path('admin_mercure'), title: 'nav.mercure', intro: 'admin.hub.mercure'},
            {href: path('admin_social_login'), title: 'nav.social_login', intro: 'admin.hub.social_login', testid: 'admin-social-login'},
            {href: path('admin_ops_defaults'), title: 'nav.ops_defaults', intro: 'admin.hub.ops_defaults', testid: 'admin-ops-defaults'},
            {href: path('admin_instance_config'), title: 'nav.instance_config', intro: 'admin.hub.instance_config', testid: 'admin-instance-config'},
            {href: path('nowo_site_backup_setup'), title: 'nav.setup', intro: 'admin.hub.setup', tour: 'admin-setup'},
        ],
    },
    {
        heading: 'admin.hub.section.navigation',
        tiles: [
            {href: path('nowo_dashboard_menu_dashboard_index'), title: 'nav.menus', intro: 'admin.hub.menus'},
            {href: path('nowo_breadcrumb_kit_dashboard_collections_index'), title: 'nav.breadcrumbs', intro: 'admin.hub.breadcrumbs'},
            {href: path('admin_cookie_consent'), title: 'nav.cookie_consent', intro: 'admin.hub.cookie_consent', testid: 'admin-cookie-consent'},
            {href: path('nowo_routing_kit_panel'), title: 'nav.routing', intro: 'admin.hub.routing', testid: 'admin-routing'},
        ],
    },
    {
        heading: 'admin.hub.section.observability',
        tiles: [
            {href: path('nowo_http_log_admin_index'), title: 'nav.http_log', intro: 'admin.hub.http_log', testid: 'admin-http-log'},
            {href: path('admin_api_doc'), title: 'nav.api_docs', intro: 'admin.hub.api_docs'},
        ],
    },
] %}

<div class="flex flex-col gap-8">
    {% for section in hub_sections %}
        <section>
            <h2 class="mb-3 text-xs font-semibold uppercase tracking-wide text-[var(--color-ink)]/45">{{ section.heading|trans }}</h2>
            <div class="grid gap-4 sm:grid-cols-2">
                {% for tile in section.tiles %}
                    {% include 'admin/_hub_tile.html.twig' with tile only %}
                {% endfor %}
            </div>
        </section>
    {% endfor %}
</div>
{% endblock %}
