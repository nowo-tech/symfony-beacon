{% extends 'base.html.twig' %}

{% block title %}{{ section.tabLabelKey()|trans }} — {{ 'ops_defaults.title'|trans }} — {{ site_appearance.brandName }}{% endblock %}

{% block body %}
<div class="mb-6">
    <p class="text-sm"><a class="text-[var(--color-moss)] no-underline hover:underline" href="{{ path('admin_hub') }}">{{ 'admin.hub.title'|trans }}</a></p>
    <h1 class="mt-2 font-[family-name:var(--font-display)] text-3xl font-bold">{{ 'ops_defaults.title'|trans }}</h1>
    <p class="mt-1 text-sm text-[var(--color-ink)]/65">{{ 'ops_defaults.intro'|trans }}</p>
</div>

{% set tab_items = [] %}
{% for item in sections %}
    {% set tab_items = tab_items|merge([{
        label: item.tabLabelKey()|trans,
        href: path('settings_ops_defaults_section', {section: item.value}),
        current: item == section,
        attr: {'data-testid': 'ops-defaults-tab-' ~ item.value},
    }]) %}
{% endfor %}
{% include 'shared/_tabs.html.twig' with {
    aria_label: 'ops_defaults.tabs_label'|trans,
    nav_class: 'mb-6',
    attr: {'data-testid': 'ops-defaults-tabs'},
    items: tab_items,
} only %}

{{ form_start(form, {attr: {class: 'panel space-y-4', 'data-testid': 'ops-defaults-form', 'data-ops-section': section.value}}) }}
    <fieldset class="space-y-4">
        <legend class="text-lg font-semibold">{{ section.tabLabelKey()|trans }}</legend>
        <p class="text-sm text-[var(--color-ink)]/60">{{ section.helpKey()|trans }}</p>

        {% include 'form/_fields.html.twig' with {form: form} only %}

        {% if section.value == 'metrics' and settings.hasMetricsToken %}
            <p class="text-sm text-[var(--color-ink)]/60" data-testid="ops-metrics-token-configured">{{ 'ops_defaults.metrics_token.configured'|trans }}</p>
        {% endif %}
        {% if section.value == 'inbound' and settings.hasInboundWebhookSecret %}
            <p class="text-sm text-[var(--color-ink)]/60" data-testid="ops-inbound-secret-configured">{{ 'ops_defaults.inbound_webhook_secret.configured'|trans }}</p>
        {% endif %}
    </fieldset>

    <div class="flex flex-wrap gap-2 border-t border-[var(--color-sand)] pt-4">
        <button class="btn-primary" type="submit" data-testid="ops-defaults-submit">{{ 'ops_defaults.submit'|trans }}</button>
        <a class="btn-ghost no-underline" href="{{ path('admin_hub') }}">{{ 'common.cancel'|trans }}</a>
    </div>
{{ form_end(form) }}
{% endblock %}
