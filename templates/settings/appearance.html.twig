{% extends 'base.html.twig' %}

{% block title %}{{ 'appearance.title'|trans }} — {{ site_appearance.brandName }}{% endblock %}

{% macro color_field(field) %}
    <div class="flex flex-col gap-2">
        {{ form_label(field) }}
        <div class="flex items-center gap-3">
            {{ form_widget(field) }}
            <span class="font-mono text-xs text-[var(--color-ink)]/55" data-color-hex-for="{{ field.vars.id }}">{{ field.vars.value }}</span>
        </div>
        {{ form_errors(field) }}
        {{ form_help(field) }}
    </div>
{% endmacro %}

{% block body %}
{% import _self as ui %}
<div class="mx-auto">
    <h1 class="mb-2 font-[family-name:var(--font-display)] text-3xl font-bold">{{ 'appearance.title'|trans }}</h1>
    <p class="mb-6 text-sm text-[var(--color-ink)]/65">{{ 'appearance.intro'|trans }}</p>

    {{ form_start(form, {attr: {class: 'panel space-y-4'}}) }}
        {{ form_row(form.brandName) }}
        {{ form_row(form.brandEyebrow) }}

        <fieldset class="space-y-3 border-t border-[var(--color-sand)] pt-4">
            <legend class="text-sm font-semibold">{{ 'appearance.section.light'|trans }}</legend>
            <div class="grid gap-4 sm:grid-cols-2">
                {{ ui.color_field(form.accentColor) }}
                {{ ui.color_field(form.accentDeepColor) }}
            </div>
        </fieldset>

        <fieldset class="space-y-3 border-t border-[var(--color-sand)] pt-4">
            <legend class="text-sm font-semibold">{{ 'appearance.section.dark'|trans }}</legend>
            <div class="grid gap-4 sm:grid-cols-2">
                {{ ui.color_field(form.accentColorDark) }}
                {{ ui.color_field(form.accentDeepColorDark) }}
            </div>
        </fieldset>

        <fieldset class="space-y-3 border-t border-[var(--color-sand)] pt-4">
            <legend class="text-sm font-semibold">{{ 'appearance.section.danger'|trans }}</legend>
            <div class="grid gap-4 sm:grid-cols-2">
                {{ ui.color_field(form.dangerColor) }}
                {{ ui.color_field(form.dangerColorDark) }}
            </div>
        </fieldset>

        <fieldset class="space-y-3 border-t border-[var(--color-sand)] pt-4">
            <legend class="text-sm font-semibold">{{ 'appearance.section.warn'|trans }}</legend>
            <div class="grid gap-4 sm:grid-cols-2">
                {{ ui.color_field(form.warnColor) }}
                {{ ui.color_field(form.warnColorDark) }}
            </div>
        </fieldset>

        <fieldset class="space-y-3 border-t border-[var(--color-sand)] pt-4">
            <legend class="text-sm font-semibold">{{ 'appearance.section.surfaces'|trans }}</legend>
            <div class="grid gap-4 sm:grid-cols-2">
                {{ ui.color_field(form.paperColor) }}
                {{ ui.color_field(form.paperColorDark) }}
                {{ ui.color_field(form.inkColor) }}
                {{ ui.color_field(form.inkColorDark) }}
                {{ ui.color_field(form.surfaceColor) }}
                {{ ui.color_field(form.surfaceColorDark) }}
            </div>
        </fieldset>

        <div class="flex flex-wrap gap-2 border-t border-[var(--color-sand)] pt-4">
            <button class="btn-primary" type="submit">{{ 'appearance.submit'|trans }}</button>
            <button class="btn-ghost" type="submit" name="reset" value="1">{{ 'appearance.reset'|trans }}</button>
        </div>
    {{ form_end(form) }}
</div>
{% endblock %}
