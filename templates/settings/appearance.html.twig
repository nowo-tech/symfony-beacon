{% extends 'base.html.twig' %}

{% block title %}{{ section.tabLabelKey()|trans }} — {{ 'appearance.title'|trans }} — {{ site_appearance.brandName }}{% endblock %}

{% macro color_field(field) %}
    <div class="flex flex-col gap-2">
        {{ form_label(field) }}
        <div class="flex items-center gap-3">
            {{ form_widget(field) }}
            <span class="font-mono text-xs text-[var(--color-ink)]/55" data-color-hex-for="{{ field.vars.id }}">{{ field.vars.value }}</span>
        </div>
        {{ form_errors(field) }}
        {{ form_help(field) }}
    </div>
{% endmacro %}

{% macro theme_card(theme, activeThemeId) %}
    {% set selected = activeThemeId == theme.id %}
    {% set previewPaper = theme.mode == 'dark' ? theme.paperDark : theme.paper %}
    {% set previewSurface = theme.mode == 'dark' ? theme.surfaceDark : theme.surface %}
    {% set previewInk = theme.mode == 'dark' ? theme.inkDark : theme.ink %}
    {% set previewAccent = theme.mode == 'dark' ? theme.accentDark : theme.accent %}
    <button
        type="submit"
        name="apply_theme"
        value="{{ theme.id }}"
        class="group relative flex flex-col overflow-hidden rounded-lg border text-left transition focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-moss)] {% if selected %}border-[var(--color-moss)] ring-2 ring-[var(--color-moss)]/35{% else %}border-[var(--color-sand)] hover:border-[var(--color-moss)]/50{% endif %}"
        aria-pressed="{{ selected ? 'true' : 'false' }}"
    >
        <span
            class="js-theme-preview block h-20 w-full p-3"
            data-paper="{{ previewPaper }}"
            data-surface="{{ previewSurface }}"
            data-ink="{{ previewInk }}"
            data-accent="{{ previewAccent }}"
        >
            <span class="js-theme-preview-surface flex h-full flex-col justify-between rounded-md p-2 shadow-sm">
                <span class="js-theme-preview-accent block h-1.5 w-10 rounded-sm"></span>
                <span class="flex items-center justify-between gap-2">
                    <span class="js-theme-preview-ink block h-1 w-8 rounded-sm opacity-40"></span>
                    <span class="js-theme-preview-accent block h-4 w-4 rounded-sm"></span>
                </span>
            </span>
        </span>
        <span class="flex items-center justify-between gap-2 bg-[var(--color-surface)] px-3 py-2">
            <span class="text-sm font-medium text-[var(--color-ink)]">{{ ('appearance.theme.' ~ theme.id)|trans }}</span>
            {% if selected %}
                <span class="text-[0.65rem] font-semibold uppercase tracking-wide text-[var(--color-moss)]">{{ 'appearance.theme.active'|trans }}</span>
            {% endif %}
        </span>
    </button>
{% endmacro %}

{% block body %}
{% import _self as ui %}
<div class="mx-auto">
    <h1 class="mb-2 font-[family-name:var(--font-display)] text-2xl font-semibold">{{ 'appearance.title'|trans }}</h1>
    <p class="mb-6 text-xs text-[var(--color-ink)]/55">{{ 'appearance.intro'|trans }}</p>

    {% set tab_items = [] %}
    {% for item in sections %}
        {% set href_params = {section: item.value} %}
        {% if item.defaultSubtab() %}
            {% set href_params = href_params|merge({sub: item.defaultSubtab().value}) %}
        {% endif %}
        {% set tab_items = tab_items|merge([{
            label: item.tabLabelKey()|trans,
            href: path('admin_appearance_section', href_params),
            current: item == section,
            attr: {'data-testid': 'appearance-tab-' ~ item.value},
        }]) %}
    {% endfor %}
    {% include 'shared/_tabs.html.twig' with {
        aria_label: 'appearance.tabs_label'|trans,
        nav_class: 'mb-4',
        attr: {'data-testid': 'appearance-tabs'},
        items: tab_items,
    } only %}

    {% set section_subtabs = section.subtabs() %}
    {% if section_subtabs is not empty %}
        {% set sub_items = [] %}
        {% for item in section_subtabs %}
            {% set sub_items = sub_items|merge([{
                label: item.tabLabelKey()|trans,
                href: path('admin_appearance_section', {section: section.value, sub: item.value}),
                current: subtab is not null and item == subtab,
                attr: {'data-testid': 'appearance-subtab-' ~ item.value},
            }]) %}
        {% endfor %}
        {% include 'shared/_tabs.html.twig' with {
            aria_label: 'appearance.subtabs_label'|trans,
            nav_class: 'mb-6 beacon-tabs--sections',
            attr: {'data-testid': 'appearance-subtabs'},
            items: sub_items,
        } only %}
    {% endif %}

    {% if section.value == 'themes' %}
        <section class="panel space-y-5" aria-labelledby="appearance-themes-heading">
            <div>
                <h2 id="appearance-themes-heading" class="text-lg font-semibold">{{ section.tabLabelKey()|trans }}</h2>
                <p class="mt-1 text-sm text-[var(--color-ink)]/65">{{ section.helpKey()|trans }}</p>
                {% if activeThemeIdLight == 'custom' or activeThemeIdDark == 'custom' %}
                    <p class="mt-2 text-xs font-medium text-[var(--color-warn)]">{{ 'appearance.themes.custom'|trans }}</p>
                {% endif %}
                {% if activeThemeIdLight != 'custom' and activeThemeIdDark != 'custom' %}
                    <p class="mt-2 text-xs text-[var(--color-ink)]/55">
                        {{ 'appearance.themes.pair'|trans({
                            '%light%': ('appearance.theme.' ~ activeThemeIdLight)|trans,
                            '%dark%': ('appearance.theme.' ~ activeThemeIdDark)|trans,
                        }) }}
                    </p>
                {% endif %}
            </div>

            {{ form_start(appearanceThemeForm, {attr: {class: 'space-y-5'}}) }}
                {{ form_widget(appearanceThemeForm._token) }}
                <div>
                    <h3 class="mb-3 text-sm font-semibold">{{ 'appearance.themes.light'|trans }}</h3>
                    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
                        {% for theme in lightThemes %}
                            {{ ui.theme_card(theme, activeThemeIdLight) }}
                        {% endfor %}
                    </div>
                </div>
                <div>
                    <h3 class="mb-3 text-sm font-semibold">{{ 'appearance.themes.dark'|trans }}</h3>
                    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
                        {% for theme in darkThemes %}
                            {{ ui.theme_card(theme, activeThemeIdDark) }}
                        {% endfor %}
                    </div>
                </div>
            {{ form_end(appearanceThemeForm, {render_rest: false}) }}
        </section>
    {% else %}
        {{ form_start(form, {attr: {class: 'panel space-y-4', 'data-testid': 'appearance-form', 'data-appearance-section': section.value}}) }}
            <fieldset class="space-y-4">
                <legend class="text-lg font-semibold">{{ section.tabLabelKey()|trans }}</legend>
                <p class="text-sm text-[var(--color-ink)]/60">{{ section.helpKey()|trans }}</p>

                {% if section.value == 'colors' %}
                    <div class="grid gap-4 sm:grid-cols-2">
                        {% for child in form %}
                            {% if not child.rendered %}
                                {{ ui.color_field(child) }}
                            {% endif %}
                        {% endfor %}
                    </div>
                {% else %}
                    {% include 'form/_fields.html.twig' with {form: form} only %}
                {% endif %}
            </fieldset>

            <div class="flex flex-wrap gap-2 border-t border-[var(--color-sand)] pt-4">
                <button class="btn-primary" type="submit">{{ 'appearance.submit'|trans }}</button>
                <button class="btn-ghost" type="submit" name="reset" value="1">{{ 'appearance.reset'|trans }}</button>
            </div>
        {{ form_end(form) }}
    {% endif %}
</div>
{% endblock %}
