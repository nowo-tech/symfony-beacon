<div{{ attributes }} data-testid="member-project-alert-preferences-live" data-project-uuid="{{ this.projectUuid }}">
    {% set _formName = form.vars.name %}
    {% set _projectOn = this.isProjectEnabled() %}

    {{ form_start(form, {
        attr: {
            'data-testid': 'member-alerts-project-form',
        },
    }) }}
        <div class="space-y-3">
            <div class="pref-switch-row">
                <span class="pref-switch-row__copy">
                    <span class="pref-switch-row__title">{{ 'preferences.member_alerts.project_enabled'|trans }}</span>
                </span>
                <label class="pref-switch">
                    <span class="sr-only">{{ 'preferences.member_alerts.project_enabled'|trans }}</span>
                    {{ form_widget(form.enabled, {attr: {
                        class: 'pref-switch__input',
                        role: 'switch',
                        'data-model': 'on(change)|' ~ _formName ~ '.enabled',
                        'aria-checked': form.enabled.vars.checked ? 'true' : 'false',
                    }}) }}
                    <span class="pref-switch__track" aria-hidden="true"></span>
                </label>
            </div>

            {% if _projectOn %}
                {{ form_row(form.resetOverrides) }}
                <div data-testid="member-alerts-project-overrides">
                    <p class="mb-2 text-sm font-medium text-[var(--color-ink)]">{{ 'preferences.member_alerts.project_overrides'|trans }}</p>
                    <ul class="pref-alert-list">
                        {% for eventRow in form.events %}
                            {% include 'account/_member_alert_event_row.html.twig' with {
                                eventRow: eventRow,
                                form: form,
                            } only %}
                        {% endfor %}
                    </ul>
                </div>
            {% else %}
                <p class="text-sm text-[var(--color-ink)]/55" data-testid="member-alerts-project-off-hint">
                    {{ 'preferences.member_alerts.project_off_hint'|trans }}
                </p>
                <div class="hidden">
                    {{ form_widget(form.resetOverrides) }}
                    {% for eventRow in form.events %}
                        {{ form_widget(eventRow.enabled) }}
                        {{ form_widget(eventRow.involved) }}
                    {% endfor %}
                </div>
            {% endif %}

            {% if this.showModalActions %}
                <div class="confirm-dialog__actions !mt-4 !border-0 !px-0 !pb-0">
                    <button type="button" class="btn-ghost" data-confirm-dialog-close>{{ 'preferences.member_alerts.modal_close'|trans }}</button>
                    <button
                        type="button"
                        class="btn-primary"
                        data-action="live#action"
                        data-live-action-param="save"
                        data-loading="addAttribute(disabled)"
                        data-testid="member-alerts-project-save"
                    >{{ 'preferences.member_alerts.project_save'|trans }}</button>
                </div>
            {% else %}
                <div class="pt-1">
                    <button
                        type="button"
                        class="btn-primary"
                        data-action="live#action"
                        data-live-action-param="save"
                        data-loading="addAttribute(disabled)"
                        data-testid="project-member-alerts-save"
                    >{{ 'preferences.member_alerts.project_save'|trans }}</button>
                </div>
            {% endif %}
        </div>
        {% include 'form/_fields.html.twig' with {form: form} only %}
    {{ form_end(form) }}
</div>
